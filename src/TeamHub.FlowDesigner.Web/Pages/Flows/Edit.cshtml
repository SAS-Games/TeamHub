@page "/flows/{id:guid}/edit"
@model TeamHub.FlowDesigner.Web.Pages.Flows.EditModel
@{
    ViewData["Title"] = Model.FlowName;
    ViewData["FullBleed"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/_content/TeamHub.FlowDesigner.Web/vendor/drawflow/drawflow.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/TeamHub.FlowDesigner.Web/css/flowdesigner.css" asp-append-version="true" />
}

<div class="fd-designer@(Model.CanEdit ? "" : " is-view-only")" id="flowDesigner" data-flow-id="@Model.FlowId" data-load-url="@Model.LoadUrl" data-save-url="@Model.SaveUrl" data-link-targets-url="@Model.LinkTargetsUrl" data-review-request-id="@Model.ReviewRequestId" data-published-view="@Model.IsPublishedView.ToString().ToLowerInvariant()" data-start-presentation="@Model.StartInPresentation.ToString().ToLowerInvariant()" data-diagram-type="@Model.DiagramType" data-can-edit="@Model.CanEdit.ToString().ToLowerInvariant()" data-is-shared="@Model.IsShared.ToString().ToLowerInvariant()" data-current-user="@(User.Identity?.Name ?? "You")" data-trail="@Model.Trail">
    <div class="fd-designer-toolbar">
        <div class="fd-toolbar-identity d-flex align-items-center gap-2 min-w-0">
            <a class="btn btn-sm btn-light fd-icon-button" id="backToFlows" href="@Model.BackPath" aria-label="Back" title="Back">&larr;</a>
            <div class="min-w-0">
                <nav class="fd-breadcrumbs" aria-label="Diagram hierarchy">
                    <a asp-page="/Flows/Index">Diagrams</a>
                    @foreach (var breadcrumb in Model.Breadcrumbs)
                    {
                        <span aria-hidden="true">/</span><a href="@breadcrumb.Url">@breadcrumb.Name</a>
                    }
                    <span aria-hidden="true">/</span><span aria-current="page">@Model.FlowName</span>
                </nav>
                <label class="visually-hidden" for="flowName">Flow name</label>
                <input id="flowName" class="fd-flow-title" maxlength="200" value="@Model.FlowName" />
                <div class="fd-save-state" id="saveState"><span class="fd-status-dot"></span><span>Loading...</span></div>
                @if (Model.IsPublishedView || Model.IsReviewPreview)
                {
                    <div class="small text-secondary">@(Model.IsReviewPreview ? "Frozen submission under review" : "Approved published snapshot")</div>
                }
                @if (Model.IsPublishedView && Model.CanEdit)
                {
                    <div class="small text-success">Admin editing is enabled. Saving creates a new published hierarchy version.</div>
                }
                @if (Model.LatestPublicationStatus == TeamHub.FlowDesigner.Core.Models.FlowPublicationRequestStatus.Rejected)
                {
                    <div class="small text-danger" title="@Model.PublicationReviewNote">Publication rejected: @Model.PublicationReviewNote</div>
                }
                else if (Model.LatestPublicationStatus == TeamHub.FlowDesigner.Core.Models.FlowPublicationRequestStatus.Approved)
                {
                    <div class="small text-success">The submitted version was approved.</div>
                }
            </div>
        </div>
        <div class="fd-toolbar-actions">
            <button class="btn btn-sm btn-light fd-mobile-panel-button fd-edit-only" id="toggleToolbox" type="button">Symbols</button>
            <button class="btn btn-sm btn-light fd-edit-only" id="undoButton" type="button" title="Undo (Ctrl+Z)" disabled>&#8630; <span class="d-none d-lg-inline">Undo</span></button>
            <button class="btn btn-sm btn-light fd-edit-only" id="redoButton" type="button" title="Redo (Ctrl+Y)" disabled>&#8631; <span class="d-none d-lg-inline">Redo</span></button>
            <button class="btn btn-sm btn-light" id="presentationButton" type="button" aria-pressed="false" title="Open a read-only presentation">Present</button>
            <button class="btn btn-sm btn-light fd-comments-button" id="commentsButton" type="button" aria-controls="commentsPanel" aria-expanded="false">
                Comments <span class="fd-toolbar-count d-none" id="commentsOverviewCount">0</span>
            </button>
            @if (Model.CanRequestPublication)
            {
                <button class="btn btn-sm btn-outline-success fd-edit-only" id="requestPublicationButton" type="button" disabled="@(Model.HasPendingPublicationRequest ? "disabled" : null)"><span id="requestPublicationButtonText">@(Model.HasPendingPublicationRequest ? "Pending admin review" : "Request publication")</span></button>
            }
            <div class="dropdown">
                <button class="btn btn-sm btn-light dropdown-toggle" data-bs-toggle="dropdown" type="button">Export</button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li><button class="dropdown-item" id="exportSvg" type="button">Download SVG</button></li>
                    <li><button class="dropdown-item" id="exportPng" type="button">Download PNG</button></li>
                </ul>
            </div>
            <button class="btn btn-sm btn-primary fd-edit-only" id="saveButton" type="button"><span id="saveButtonText">Save</span></button>
            @if (Model.CanSaveAsTemplate)
            {
                <button class="btn btn-sm btn-light" id="saveAsTemplateButton" type="button" data-bs-toggle="modal" data-bs-target="#saveTemplateModal">Save as template</button>
            }
            <button class="btn btn-sm btn-light fd-mobile-panel-button" id="toggleProperties" type="button">@(Model.CanEdit ? "Properties" : "Details")</button>
        </div>
    </div>

    <div class="fd-designer-main">
        <aside class="fd-toolbox fd-edit-only" id="toolbox" aria-label="Symbol toolbox">
            <div class="fd-panel-heading">
                <div><div class="fd-eyebrow">Build</div><h2 id="paletteTitle">Symbols</h2></div>
                <button class="btn-close fd-panel-close" id="closeToolbox" type="button" aria-label="Close toolbox"></button>
            </div>
            <p class="fd-panel-help" id="paletteHelp">Drag a symbol onto the canvas or click to add it.</p>
            <div class="fd-tool-list" id="nodeToolList"></div>
        </aside>

        <section class="fd-canvas-shell" aria-label="Flow canvas">
            <div id="drawflow" class="fd-canvas"></div>
            <div class="fd-canvas-hint" id="canvasHint"><strong>Start building</strong><span>Drag a symbol here from the toolbox</span></div>
            <div class="fd-presentation-controls" aria-live="polite">
                <span><strong>Presentation mode</strong><small>Click a node for details &middot; Double-click to open a child</small></span>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-light fd-comments-button" id="presentationCommentsButton" type="button" aria-controls="commentsPanel" aria-expanded="false">
                        Comments <span class="fd-toolbar-count d-none" id="presentationCommentsOverviewCount">0</span>
                    </button>
                    <a class="btn btn-sm btn-light" id="presentationBack" href="@Model.BackPath">&larr; Back</a>
                    <button class="btn btn-sm btn-light" id="exitPresentation" type="button">Exit <span aria-hidden="true">Esc</span></button>
                </div>
            </div>
            <aside class="fd-presentation-details" id="presentationDetails" aria-labelledby="presentationDetailsTitle" aria-hidden="true">
                <div class="fd-panel-heading">
                    <div><div class="fd-eyebrow" id="presentationDetailsType">Selected symbol</div></div>
                    <button class="btn-close" id="closePresentationDetails" type="button" aria-label="Close node details"></button>
                </div>
                <h2 class="fd-details-title" id="presentationDetailsTitle"></h2>
                <div class="fd-details-section"><h4>Description</h4><p class="fd-details-copy" id="presentationDetailsDescription"></p></div>
                <div class="fd-details-section"><h4>Notes</h4><p class="fd-details-copy" id="presentationDetailsNotes"></p></div>
                <button class="btn btn-sm btn-primary w-100 d-none" id="openPresentationChildFlow" type="button">Open detailed diagram</button>
                <section class="fd-comments" aria-labelledby="presentationCommentsHeading">
                    <div class="d-flex align-items-center justify-content-between mb-2"><h3 id="presentationCommentsHeading">Public comments</h3><span class="fd-comment-count" id="presentationCommentCount">0</span></div>
                    <div class="fd-comment-list" id="presentationComments"></div>
                </section>
            </aside>
            <div class="fd-canvas-controls" aria-label="Canvas controls">
                <button class="btn btn-sm btn-light" id="zoomOut" type="button" title="Zoom out">&minus;</button>
                <button class="btn btn-sm btn-light fd-zoom-value" id="zoomReset" type="button" title="Reset zoom">100%</button>
                <button class="btn btn-sm btn-light" id="zoomIn" type="button" title="Zoom in">+</button>
                <button class="btn btn-sm btn-light" id="fitView" type="button" title="Fit to view">Fit</button>
                <button class="btn btn-sm btn-light active fd-edit-only" id="gridToggle" type="button" title="Toggle grid">Grid</button>
            </div>
        </section>

        <aside class="fd-properties" id="propertiesPanel" aria-label="@(Model.CanEdit ? "Properties" : "Diagram details")">
            <div class="fd-panel-heading">
                <div><div class="fd-eyebrow">Inspector</div><h2>@(Model.CanEdit ? "Properties" : "Details")</h2></div>
                <button class="btn-close fd-panel-close" id="closeProperties" type="button" aria-label="Close properties"></button>
            </div>
            <div id="emptyProperties" class="fd-properties-empty"><span>&#9671;</span><p>Select a symbol or connector to @(Model.CanEdit ? "edit" : "view") its details.</p></div>
            <section id="nodeReadOnlyDetails" class="d-none" aria-labelledby="nodeReadOnlyTitle">
                <div class="fd-selection-label" id="nodeReadOnlyType">Selected symbol</div>
                <h3 class="fd-details-title" id="nodeReadOnlyTitle"></h3>
                <div class="fd-details-section">
                    <h4>Description</h4>
                    <p class="fd-details-copy" id="nodeReadOnlyDescription"></p>
                </div>
                <div class="fd-details-section">
                    <h4>Notes</h4>
                    <p class="fd-details-copy" id="nodeReadOnlyNotes"></p>
                </div>
                <button class="btn btn-sm btn-primary w-100 d-none" id="openReadOnlyChildFlow" type="button">Open detailed diagram</button>
                <section class="fd-comments" aria-labelledby="nodeReadOnlyCommentsHeading">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h3 id="nodeReadOnlyCommentsHeading">Public comments</h3>
                        <span class="fd-comment-count" id="nodeReadOnlyCommentCount">0</span>
                    </div>
                    <div class="fd-comment-list" id="nodeReadOnlyComments"></div>
                </section>
            </section>
            <section id="connectionReadOnlyDetails" class="d-none" aria-labelledby="connectionReadOnlyTitle">
                <div class="fd-selection-label">Selected connector</div>
                <h3 class="fd-details-title" id="connectionReadOnlyTitle"></h3>
                <p class="fd-details-copy" id="connectionReadOnlySummary"></p>
            </section>
            <form id="workflowProperties" class="d-none" autocomplete="off">
                <div class="fd-selection-label">Diagram settings</div>
                <div class="mb-3"><label class="form-label" for="workflowDescription">Description</label><textarea class="form-control" id="workflowDescription" rows="3" maxlength="2000"></textarea></div>
                <div class="@(Model.DiagramType == TeamHub.FlowDesigner.Core.Models.DiagramType.WorkCenterWorkflow ? "" : "d-none")">
                    <div class="mb-3"><label class="form-label" for="workflowKey">Workflow key</label><input class="form-control" id="workflowKey" maxlength="128" /><div class="form-text">Generated from the workflow name. Keep it stable across versions.</div></div>
                    <div class="form-check mb-3"><input class="form-check-input" id="workflowEnabled" type="checkbox" checked /><label class="form-check-label" for="workflowEnabled">Available to start</label></div>
                    <p class="small text-secondary">Select a task to configure its assignment and timing. Connect tasks to define their dependencies.</p>
                </div>
            </form>
            <form id="nodeProperties" class="d-none" autocomplete="off">
                <div class="fd-selection-label">Selected symbol</div>
                <div class="mb-3"><label class="form-label" for="nodeTitle">Label</label><input class="form-control" id="nodeTitle" maxlength="160" /></div>
                <div class="mb-3"><label class="form-label" for="nodeDescription">Description</label><textarea class="form-control" id="nodeDescription" rows="3" maxlength="1000"></textarea></div>
                <div class="mb-3"><label class="form-label" for="nodeType">Symbol</label><select class="form-select" id="nodeType"></select></div>
                <div class="row g-2 mb-3">
                    <div class="col-6"><label class="form-label" for="nodeTone">Color</label><select class="form-select" id="nodeTone"><option value="">Automatic</option><option value="blue">Blue</option><option value="green">Green</option><option value="red">Red</option><option value="orange">Orange</option><option value="purple">Purple</option></select></div>
                    <div class="col-6"><label class="form-label" for="nodeLayer">Layer</label><select class="form-select" id="nodeLayer"><option value="">Automatic</option><option value="background">Background</option><option value="foreground">Foreground</option></select></div>
                </div>
                <fieldset class="fd-pin-options mb-3">
                    <legend>Connector pins</legend>
                    <label class="form-label" for="nodePortLayout">Placement</label>
                    <select class="form-select mb-2" id="nodePortLayout">
                        <optgroup label="Input on left">
                            <option value="left-right">Left input / right output</option>
                            <option value="left-top">Left input / top output</option>
                            <option value="left-bottom">Left input / bottom output</option>
                        </optgroup>
                        <optgroup label="Input on right">
                            <option value="right-left">Right input / left output</option>
                            <option value="right-top">Right input / top output</option>
                            <option value="right-bottom">Right input / bottom output</option>
                        </optgroup>
                        <optgroup label="Input on top">
                            <option value="top-left">Top input / left output</option>
                            <option value="top-right">Top input / right output</option>
                            <option value="top-bottom">Top input / bottom output</option>
                        </optgroup>
                        <optgroup label="Input on bottom">
                            <option value="bottom-left">Bottom input / left output</option>
                            <option value="bottom-right">Bottom input / right output</option>
                            <option value="bottom-top">Bottom input / top output</option>
                        </optgroup>
                    </select>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label" for="nodeInputPins">Input pins</label>
                            <select class="form-select" id="nodeInputPins">
                                <option value="">Automatic</option>
                                <option value="1">1</option><option value="2">2</option><option value="3">3</option>
                                <option value="4">4</option><option value="5">5</option><option value="6">6</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="nodeOutputPins">Output pins</label>
                            <select class="form-select" id="nodeOutputPins">
                                <option value="">Automatic</option>
                                <option value="1">1</option><option value="2">2</option><option value="3">3</option>
                                <option value="4">4</option><option value="5">5</option><option value="6">6</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-text">Use extra pins to separate branches and converging paths.</div>
                </fieldset>
                <div class="mb-3" id="nodeSectionField"><label class="form-label" for="nodeSectionId">Section group</label><div id="nodeSectionHelp" class="form-text mt-0 mb-1">Drag the node into or out of a section, or choose one here.</div><select class="form-select" id="nodeSectionId" aria-describedby="nodeSectionHelp"><option value="">No section</option></select></div>
                <div class="mb-3"><label class="form-label" for="nodePresentationStyle">Visual style</label><select class="form-select" id="nodePresentationStyle"><option value="">Standard symbol</option><option value="step">Compact step</option><option value="card">Information card</option><option value="banner">Solid banner</option><option value="plain">Plain text</option><option value="band">Section with header band</option></select></div>
                <div class="mb-3"><label class="form-label" for="nodeNotes">Notes</label><textarea class="form-control" id="nodeNotes" rows="3" maxlength="1000" placeholder="Optional supporting detail"></textarea></div>
                <section class="fd-child-flow mb-3" id="nodeChildFlowSection" aria-labelledby="nodeChildFlowHeading">
                    <h3 id="nodeChildFlowHeading">Detailed diagram</h3>
                    <label class="form-label" for="nodeChildFlowId">Linked diagram</label>
                    <select class="form-select" id="nodeChildFlowId"><option value="">No detailed diagram</option></select>
                    <div class="form-text">Linked nodes display a drill-down marker. Double-click a linked node to open it.</div>
                    <div class="d-grid gap-2 mt-2">
                        <button class="btn btn-sm btn-primary" id="openChildFlow" type="button">Open detailed diagram</button>
                        <button class="btn btn-sm btn-outline-secondary@(Model.IsPublishedView ? " d-none" : "")" id="createChildFlow" type="button" data-bs-toggle="modal" data-bs-target="#createChildFlowModal">Create new detailed diagram</button>
                        <button class="btn btn-sm btn-link text-danger" id="unlinkChildFlow" type="button">Remove diagram link</button>
                    </div>
                </section>
                <section id="workCenterTaskProperties" class="d-none" aria-labelledby="workCenterTaskHeading">
                    <h3 id="workCenterTaskHeading" class="h6 mb-3">Work Center task</h3>
                    <div class="mb-3"><label class="form-label" for="taskStepKey">Task key</label><input class="form-control" id="taskStepKey" maxlength="128" placeholder="Generated from task name" /></div>
                    <div class="mb-3"><label class="form-label" for="taskOwner">Assigned to</label><input class="form-control" id="taskOwner" maxlength="256" placeholder="Sign-in name or email" /></div>
                    <div class="mb-3"><label class="form-label" for="taskOwnerType">Assignment type</label><select class="form-select" id="taskOwnerType"><option value="User">User</option><option value="Email">Email</option></select></div>
                    <div class="mb-3"><label class="form-label" for="taskExpectedHours">Expected duration (hours)</label><input class="form-control" id="taskExpectedHours" type="number" min="0" step="any" value="24" /></div>
                    <details class="mb-3"><summary class="fw-semibold">Reminders and escalation</summary>
                        <div class="mt-3"><label class="form-label" for="taskReminderAfterHours">First reminder after (hours)</label><input class="form-control" id="taskReminderAfterHours" type="number" min="0" step="any" /></div>
                        <div class="mt-3"><label class="form-label" for="taskReminderRepeatHours">Repeat reminder every (hours)</label><input class="form-control" id="taskReminderRepeatHours" type="number" min="0" step="any" /></div>
                        <div class="mt-3"><label class="form-label" for="taskEscalationAfterHours">Escalate after due date (hours)</label><input class="form-control" id="taskEscalationAfterHours" type="number" min="0" step="any" /></div>
                        <div class="mt-3"><label class="form-label" for="taskEscalationOwner">Escalation owner</label><input class="form-control" id="taskEscalationOwner" maxlength="256" /></div>
                    </details>
                    <div class="form-check"><input class="form-check-input" id="taskRequired" type="checkbox" checked /><label class="form-check-label" for="taskRequired">Required for workflow completion</label></div>
                    <div class="form-check mb-3"><input class="form-check-input" id="taskEnabled" type="checkbox" checked /><label class="form-check-label" for="taskEnabled">Enabled</label></div>
                </section>
                <section class="fd-comments" aria-labelledby="nodeCommentsHeading">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h3 id="nodeCommentsHeading">Comments</h3>
                        <span class="fd-comment-count" id="nodeCommentCount">0</span>
                    </div>
                    <div class="fd-comment-list" id="nodeComments"></div>
                    <div class="fd-comment-reply-context d-none" id="nodeCommentReplyContext">
                        <span id="nodeCommentReplyText"></span>
                        <button class="btn btn-sm btn-link" id="cancelNodeCommentReply" type="button">Cancel</button>
                    </div>
                    <label class="visually-hidden" for="newNodeComment">Add a comment</label>
                    <textarea class="form-control mt-2" id="newNodeComment" rows="2" maxlength="2000" placeholder="Add a comment about this symbol"></textarea>
                    <div class="form-check mt-2">
                        <input class="form-check-input" id="newNodeCommentPublic" type="checkbox" />
                        <label class="form-check-label fd-comment-visibility-label" for="newNodeCommentPublic">Show in published diagram</label>
                    </div>
                    <div class="form-text">Private comments remain only in the editable diagram. Public comments are copied into the approved snapshot.</div>
                    <button class="btn btn-sm btn-outline-secondary w-100 mt-2" id="addNodeComment" type="button">Add comment</button>
                </section>
                <button class="btn btn-sm btn-outline-danger w-100" id="deleteNode" type="button">Delete symbol</button>
            </form>
            <form id="connectionProperties" class="d-none" autocomplete="off">
                <div class="fd-selection-label">Selected connector</div>
                <div class="mb-3"><label class="form-label" for="connectionLabel">Label</label><input class="form-control" id="connectionLabel" maxlength="120" placeholder="e.g. Yes" /></div>
                <div class="mb-3"><label class="form-label" for="connectionTone">Color</label><select class="form-select" id="connectionTone"><option value="">Automatic</option><option value="blue">Blue</option><option value="green">Green</option><option value="red">Red</option><option value="orange">Orange</option><option value="purple">Purple</option></select></div>
                <p class="small text-secondary" id="connectionSummary"></p>
                <button class="btn btn-sm btn-outline-danger w-100" id="deleteConnection" type="button">Delete connector</button>
            </form>
        </aside>
    </div>

    <aside class="fd-comments-panel" id="commentsPanel" aria-labelledby="commentsPanelTitle" aria-hidden="true">
        <div class="fd-panel-heading">
            <div>
                <div class="fd-eyebrow">Diagram discussion</div>
                <h2 id="commentsPanelTitle">Comments</h2>
            </div>
            <button class="btn-close" id="closeCommentsPanel" type="button" aria-label="Close comments"></button>
        </div>
        <p class="fd-panel-help">Select a comment to open its diagram and focus the related node.</p>
        <div class="row g-2 mb-3">
            <div class="col-5">
                <label class="form-label" for="commentsScope">Show</label>
                <select class="form-select form-select-sm" id="commentsScope">
                    <option value="hierarchy">Entire diagram</option>
                    <option value="page">Current page</option>
                    <option value="mine">My comments</option>
                </select>
            </div>
            <div class="col-7">
                <label class="form-label" for="commentsSearch">Search</label>
                <input class="form-control form-control-sm" id="commentsSearch" type="search" placeholder="Node, author, or comment" />
            </div>
        </div>
        <div class="fd-comments-overview-status" id="commentsOverviewStatus" role="status">Loading comments...</div>
        <div class="fd-comments-overview" id="commentsOverview"></div>
    </aside>

    <div class="fd-statusbar">
        <button class="fd-validation-button" id="validationButton" type="button"><span id="validationIcon">&#10003;</span><span id="validationSummary">Ready</span></button>
        <span class="ms-auto d-none d-md-inline"><span id="diagramTypeLabel">@Model.DiagramType.ToDisplayName()</span> &middot; Right-drag, middle-drag, or Space-drag to pan &middot; Double-click adds a symbol &middot; Del removes selection</span>
    </div>
    <div class="fd-validation-popover d-none" id="validationPopover"><div class="d-flex justify-content-between align-items-center"><strong>Diagram check</strong><button class="btn-close" id="closeValidation" type="button"></button></div><div id="validationIssues" class="mt-3"></div></div>
    <div class="fd-toast" id="toast" role="status" aria-live="polite"></div>

    <div class="modal fade" id="createChildFlowModal" tabindex="-1" aria-labelledby="createChildFlowTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="createChildFlowForm">
                    <div class="modal-header"><h2 class="modal-title fs-5" id="createChildFlowTitle">Create detailed diagram</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body">
                        <label class="form-label" for="childFlowName">Diagram name</label>
                        <input class="form-control" id="childFlowName" maxlength="200" required />
                        <div class="form-text">The new diagram uses the same diagram type as its parent.</div>
                    </div>
                    <div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="confirmCreateChildFlow" type="submit">Create and open</button></div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="leaveDiagramModal" tabindex="-1" aria-labelledby="leaveDiagramTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h2 class="modal-title fs-5" id="leaveDiagramTitle">Save your changes?</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Keep editing"></button></div>
                <div class="modal-body">Save the latest changes before returning to your diagrams, or discard them.</div>
                <div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Keep editing</button><button class="btn btn-outline-danger" id="discardAndLeave" type="button">Discard</button><button class="btn btn-primary" id="saveAndLeave" type="button">Save and leave</button></div>
            </div>
        </div>
    </div>
    @if (Model.CanSaveAsTemplate)
    {
        <div class="modal fade" id="saveTemplateModal" tabindex="-1" aria-labelledby="saveTemplateTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form id="saveTemplateForm">
                        <div class="modal-header"><h2 class="modal-title fs-5" id="saveTemplateTitle">Save diagram as template</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div>
                        <div class="modal-body">
                            <p class="text-secondary small">Use the same key later to update this template with a new version.</p>
                            <div class="mb-3"><label class="form-label" for="templateName">Template name</label><input class="form-control" id="templateName" maxlength="200" required /></div>
                            <div class="mb-3"><label class="form-label" for="templateKey">Template key</label><input class="form-control" id="templateKey" maxlength="100" required /><div class="form-text">A stable identifier such as EMPLOYEE_ONBOARDING.</div></div>
                            <div class="mb-3"><label class="form-label" for="templateCategory">Category</label><input class="form-control" id="templateCategory" maxlength="100" value="General" required /></div>
                            <div><label class="form-label" for="templateDescription">Description</label><textarea class="form-control" id="templateDescription" rows="3" maxlength="2000"></textarea></div>
                        </div>
                        <div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="confirmSaveTemplate" type="submit">Save template</button></div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

