@page "/flows/new"
@model TeamHub.FlowDesigner.Web.Pages.Flows.NewModel
@{
    ViewData["Title"] = "New diagram";
}
@section Styles {
    <link rel="stylesheet" href="~/_content/TeamHub.FlowDesigner.Web/css/flowdesigner.css" asp-append-version="true" />
}
<div class="container py-5">
    <div class="fd-form-card mx-auto">
        <a class="fd-back-link" asp-page="/Flows/Index">← All diagrams</a>
        <div class="fd-eyebrow mt-4">New canvas</div>
        <h1 class="h2 mb-2">Create a flow diagram</h1>
        <p class="text-secondary mb-4">Start with an editable template or choose a blank symbol library.</p>
        <form method="post">
            <div class="mb-3">
                <label class="form-label" asp-for="Name"></label>
                <input class="form-control form-control-lg" asp-for="Name" maxlength="200" autofocus />
                <span class="text-danger small" asp-validation-for="Name"></span>
            </div>
            <div class="mb-4">
                <label class="form-label" asp-for="Description"></label>
                <textarea class="form-control" asp-for="Description" rows="3" maxlength="2000" placeholder="Optional context for this diagram"></textarea>
            </div>
            <fieldset class="mb-4">
                <legend class="form-label">Starting point</legend>
                <div class="fd-diagram-type-grid">
                    @foreach (var template in Model.Templates)
                    {
                        <label class="fd-diagram-type-option">
                            <input asp-for="TemplateId" type="radio" value="@template.Id" />
                            <span><strong>@template.Name</strong><small>@template.Category &middot; @template.Description</small></span>
                        </label>
                    }
                    <label class="fd-diagram-type-option">
                        <input asp-for="TemplateId" type="radio" value="" />
                        <span><strong>Blank canvas</strong><small>Build your own diagram from the selected symbol library.</small></span>
                    </label>
                </div>
            </fieldset>
            <fieldset class="mb-4">
                <legend class="form-label">Diagram type</legend>
                <div class="fd-diagram-type-grid">
                    <label class="fd-diagram-type-option">
                        <input asp-for="DiagramType" type="radio" value="StandardFlowchart" />
                        <span><strong>Standard flowchart</strong><small>Processes, decisions, input/output, documents, and data.</small></span>
                    </label>
                    <label class="fd-diagram-type-option">
                        <input asp-for="DiagramType" type="radio" value="BusinessWorkflow" />
                        <span><strong>Business workflow</strong><small>Events, activities, gateways, documents, and data stores.</small></span>
                    </label>
                    <label class="fd-diagram-type-option">
                        <input asp-for="DiagramType" type="radio" value="CodeFlow" />
                        <span><strong>Code flow</strong><small>Algorithm steps, conditions, calls, input/output, and storage.</small></span>
                    </label>
                    @if (Model.CanCreateWorkCenterWorkflow)
                    {
                        <label class="fd-diagram-type-option">
                            <input asp-for="DiagramType" type="radio" value="WorkCenterWorkflow" />
                            <span><strong>Work Center workflow</strong><small>Publish tasks, owners, deadlines, reminders, and dependencies into Work Center.</small></span>
                        </label>
                    }
                </div>
            </fieldset>
            <div class="d-flex justify-content-end gap-2">
                <a class="btn btn-light" asp-page="/Flows/Index">Cancel</a>
                <button class="btn btn-primary" type="submit">Create and open</button>
            </div>
        </form>
    </div>
</div>
