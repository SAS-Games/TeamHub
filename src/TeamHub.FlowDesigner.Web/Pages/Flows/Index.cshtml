@page "/flows"
@model TeamHub.FlowDesigner.Web.Pages.Flows.IndexModel
@{
    ViewData["Title"] = "Diagrams";
}

@section Styles {
    <link rel="stylesheet" href="~/_content/TeamHub.FlowDesigner.Web/css/flowdesigner.css" asp-append-version="true" />
}

<div class="fd-page container-xl py-4 py-lg-5">
    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 mb-4">
        <div>
            <div class="fd-eyebrow">Workspace</div>
            <h1 class="display-6 fw-semibold mb-2">Flow diagrams</h1>
            <p class="text-secondary mb-0">Map a process, capture decisions, and keep every path understandable.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-primary btn-lg" asp-page="/Flows/New"><span aria-hidden="true">＋</span> New diagram</a>
        </div>
    </div>

    @if (Model.Flows.Count == 0)
    {
        <div class="fd-empty-state">
            <div class="fd-empty-icon" aria-hidden="true">◇</div>
            <h2 class="h4">Create your first flow</h2>
            <p class="text-secondary">Start with a blank canvas, then drag in steps and connect them.</p>
            <div class="d-flex justify-content-center gap-2">
                <a class="btn btn-primary" asp-page="/Flows/New">Create diagram</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var flow in Model.Flows)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <article class="fd-flow-card h-100">
                        <div class="d-flex align-items-start justify-content-between gap-3">
                            <div class="fd-flow-icon" aria-hidden="true">⌁</div>
                            <div class="d-flex flex-wrap justify-content-end gap-1">
                                <span class="badge fd-mode-badge">@flow.DiagramType.ToDisplayName()</span>
                                <span class="badge @(flow.IsShared ? "text-bg-success" : "text-bg-light")">@(flow.IsShared ? "Shared" : "Private")</span>
                            </div>
                        </div>
                        <h2 class="h5 mt-4 mb-2 text-truncate" title="@flow.Name">@flow.Name</h2>
                        <p class="text-secondary small fd-card-description">@(string.IsNullOrWhiteSpace(flow.Description) ? "No description" : flow.Description)</p>
                        <div class="fd-card-meta"><span>@flow.NodeCount nodes</span><span>Updated @flow.UpdatedAt.LocalDateTime.ToString("MMM d, yyyy")</span></div>
                        <div class="d-flex gap-2 mt-4">
                            <a class="btn btn-primary flex-grow-1" asp-page="/Flows/Edit" asp-route-id="@flow.Id">@(Model.CanEdit(flow) ? "Open" : "View")</a>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary" data-bs-toggle="dropdown" aria-label="More actions">•••</button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    @if (Model.CanEdit(flow))
                                    {
                                        <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#renameModal" data-flow-id="@flow.Id" data-flow-name="@flow.Name">Rename</button></li>
                                    }
                                    <li><form method="post" asp-page-handler="Duplicate"><input type="hidden" name="id" value="@flow.Id" /><button class="dropdown-item" type="submit">Duplicate</button></form></li>
                                    @if (Model.CanDelete(flow))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><button class="dropdown-item text-danger" type="button" data-bs-toggle="modal" data-bs-target="#deleteModal" data-flow-id="@flow.Id" data-flow-name="@flow.Name">Delete</button></li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="renameModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <form method="post" asp-page-handler="Rename">
            <div class="modal-header"><h2 class="modal-title fs-5">Rename diagram</h2><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><input type="hidden" name="id" /><label class="form-label" for="renameName">Name</label><input class="form-control" id="renameName" name="name" maxlength="200" required /></div>
            <div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Rename</button></div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <form method="post" asp-page-handler="Delete">
            <div class="modal-header"><h2 class="modal-title fs-5">Delete diagram?</h2><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><input type="hidden" name="id" /><p class="mb-0">This permanently deletes <strong data-delete-name></strong>.</p></div>
            <div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger" type="submit">Delete</button></div>
        </form>
    </div></div>
</div>

@section Scripts {
<script>
document.getElementById('renameModal')?.addEventListener('show.bs.modal', event => {
    const button = event.relatedTarget;
    event.target.querySelector('[name=id]').value = button.dataset.flowId;
    event.target.querySelector('[name=name]').value = button.dataset.flowName;
});
document.getElementById('deleteModal')?.addEventListener('show.bs.modal', event => {
    const button = event.relatedTarget;
    event.target.querySelector('[name=id]').value = button.dataset.flowId;
    event.target.querySelector('[data-delete-name]').textContent = button.dataset.flowName;
});
</script>
}
