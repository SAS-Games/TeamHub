@page
@model TeamHub.FlowDesigner.Standalone.Pages.ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="container py-5">
    <div class="fd-empty-state">
        <div class="fd-empty-icon">!</div>
        <h1 class="h3">Something went wrong</h1>
        <p class="text-secondary">The request could not be completed. Return to your diagrams and try again.</p>
        <a class="btn btn-primary" asp-page="/Flows/Index">Back to diagrams</a>
    </div>
</div>
