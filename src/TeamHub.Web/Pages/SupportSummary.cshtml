@page "/SupportSummary"
@model TeamHub.Web.Pages.SupportSummaryModel
@using TeamHub.Authentication
@using TeamHub.Web.Pages.Studio
@{
    ViewData["Title"] = "Support Summary";
    ViewData["PageWidth"] = "Full";
}

<div class="page-hero">
    <div>
        <div class="eyebrow">Consolidated report</div>
        <h1>Support Summary</h1>
        <p>Current milestones, active support tickets, and weekly or monthly Confluence updates across all active studios.</p>
    </div>
</div>

<section class="content-section">
    <div class="section-heading"><div><span>Filters</span><h2>Current Support Activity</h2></div></div>
    <div class="section-body">
        <form method="get" class="row g-3 align-items-end" data-support-summary-filters>
            <div class="col-12 col-xl-3">
                <label asp-for="Search" class="form-label">Search</label>
                <input asp-for="Search" class="form-control" placeholder="Studio, project, ticket, assignee, milestone, or update" />
            </div>
            <div class="col-sm-6 col-xl-2">
                <label asp-for="ReportPeriod" class="form-label">Summary period</label>
                <select asp-for="ReportPeriod" class="form-select" data-report-period>
                    <option value="@SupportSummaryModel.WeeklyPeriod">Weekly</option>
                    <option value="@SupportSummaryModel.MonthlyPeriod">Monthly</option>
                    <option value="@SupportSummaryModel.CustomPeriod">Custom period</option>
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label asp-for="SelectedMonth" class="form-label">Month</label>
                <input asp-for="SelectedMonth" type="month" class="form-control" data-report-month />
            </div>
            <div class="col-sm-6 col-xl-2" data-week-filter>
                <label asp-for="Week" class="form-label">Week</label>
                <select asp-for="Week" class="form-select" data-report-week>
                    @foreach (var option in Model.WeekOptions)
                    {
                        <option value="@option.Number">@option.Label</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label asp-for="StartDate" class="form-label">Start date</label>
                <input asp-for="StartDate" type="date" class="form-control" data-report-start />
            </div>
            <div class="col-sm-6 col-xl-2">
                <label asp-for="EndDate" class="form-label">End date</label>
                <input asp-for="EndDate" type="date" class="form-control" data-report-end />
            </div>
            <div class="col-12 col-xl-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary">Search</button>
                <a class="btn btn-outline-secondary" asp-page="/SupportSummary">Reset</a>
            </div>
        </form>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Studios.Count == 0)
{
    <div class="alert alert-info">No active studios have been configured.</div>
}
else
{
    <section class="content-section">
        <div class="stat-tiles">
            <div class="stat-tile"><div class="stat-label">Active Studios</div><div class="stat-value">@Model.Studios.Count</div></div>
            <div class="stat-tile"><div class="stat-label">Active Milestones</div><div class="stat-value">@Model.ActiveMilestones.Count</div></div>
            <div class="stat-tile"><div class="stat-label">Support Tickets</div><div class="stat-value">@Model.JiraTickets.Count</div></div>
            <div class="stat-tile"><div class="stat-label">Confluence Updates</div><div class="stat-value">@Model.ConfluenceResult.Updates.Count(update => update.PageFound && update.StudioFound)</div></div>
        </div>
    </section>

    <section class="content-section" id="milestones">
        <div class="section-heading">
            <div><span>@Model.ActiveMilestones.Count active item(s)</span><h2>Current Active Milestones</h2></div>
            <a class="btn btn-sm btn-outline-secondary" asp-page="/Milestones">Open Milestone Tracker</a>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.MilestoneErrorMessage))
        {
            <div class="section-body text-warning">@Model.MilestoneErrorMessage</div>
        }
        else if (Model.ActiveMilestones.Count == 0)
        {
            <div class="section-body text-secondary">No active milestones match the selected search.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table styled-table align-middle">
                    <thead><tr><th>Studio</th><th>Project</th><th>Milestone</th><th>Description</th><th>Delivery</th><th>Approval</th><th>Release Date</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.ActiveMilestones)
                    {
                        <tr>
                            <td><a asp-page="/Studio/Index" asp-route-studioId="@item.Studio.Id">@item.Studio.StudioName</a></td>
                            <td>@item.Studio.ProjectName</td>
                            <td>@item.Milestone.Milestone</td>
                            <td>@item.Milestone.Description</td>
                            <td>@(item.Milestone.DeliveryDate?.ToString("dd MMM yyyy") ?? "TBC")</td>
                            <td>@(item.Milestone.MsApprovalDate?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td>@(item.ReleaseDate?.ToString("dd MMM yyyy") ?? "-")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="content-section" id="build-reviews">
        <div class="section-heading">
            <div><span>@Model.BuildReviews.Count item(s)</span><h2>Milestone Builds in Review</h2></div>
            @if (Model.CanManagePlanning)
            {
                <strong>Admin managed</strong>
            }
        </div>
        @if (Model.CanManagePlanning)
        {
            <form id="build-review-new" method="post" asp-page-handler="SaveBuildReview"></form>
            @foreach (var item in Model.BuildReviews)
            {
                <form id="build-review-@item.Id" method="post" asp-page-handler="SaveBuildReview"></form>
                <form id="build-review-delete-@item.Id" method="post" asp-page-handler="DeleteBuildReview">
                    <input type="hidden" name="id" value="@item.Id" />
                </form>
            }
        }
        @if (Model.BuildReviews.Count == 0 && !Model.CanManagePlanning)
        {
            <div class="section-body text-secondary">No milestone builds are currently in review.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table styled-table align-middle">
                    <thead>
                        <tr>
                            <th>Project Name</th>
                            <th>Milestone Description</th>
                            <th>Status</th>
                            <th>Build Receive Date</th>
                            <th>Ageing</th>
                            <th>ETA</th>
                            @if (Model.CanManagePlanning) { <th class="text-end">Actions</th> }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.BuildReviews)
                    {
                        if (Model.CanManagePlanning)
                        {
                            var formId = $"build-review-{item.Id}";
                            <tr>
                                <td>
                                    <input type="hidden" name="id" value="@item.Id" form="@formId" />
                                    <select class="form-select" name="projectName" form="@formId" data-planning-project required>
                                        @foreach (var project in Model.Studios.Select(studio => studio.ProjectName).Distinct(StringComparer.OrdinalIgnoreCase))
                                        {
                                            <option value="@project" selected="@(string.Equals(project, item.ProjectName, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@project</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select" name="milestoneDescription" form="@formId" data-milestone-description required>
                                        <option value="">Select milestone description</option>
                                        @if (!string.IsNullOrWhiteSpace(item.MilestoneDescription)
                                            && !Model.MilestoneDescriptionOptions.Any(option =>
                                                string.Equals(option.ProjectName, item.ProjectName, StringComparison.OrdinalIgnoreCase)
                                                && string.Equals(option.Description, item.MilestoneDescription, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <option value="@item.MilestoneDescription" data-project="@item.ProjectName" selected>@item.MilestoneDescription</option>
                                        }
                                        @foreach (var option in Model.MilestoneDescriptionOptions)
                                        {
                                            <option value="@option.Description"
                                                    data-project="@option.ProjectName"
                                                    selected="@(string.Equals(option.ProjectName, item.ProjectName, StringComparison.OrdinalIgnoreCase)
                                                        && string.Equals(option.Description, item.MilestoneDescription, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                @option.Description
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select" name="status" form="@formId" required>
                                        @foreach (var status in Model.BuildReviewStatuses)
                                        {
                                            <option value="@status" selected="@(string.Equals(status, item.Status, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@status</option>
                                        }
                                    </select>
                                </td>
                                <td><input class="form-control" type="date" name="buildReceiveDate" value="@item.BuildReceiveDate.ToString("yyyy-MM-dd")" form="@formId" required /></td>
                                <td class="text-nowrap">@Model.GetBuildAgeingDays(item.BuildReceiveDate) day(s)</td>
                                <td><input class="form-control" type="date" name="eta" value="@item.Eta.ToString("yyyy-MM-dd")" form="@formId" required /></td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-primary" type="submit" form="@formId">Save</button>
                                    <button class="btn btn-sm btn-outline-danger" type="submit" form="build-review-delete-@item.Id" onclick="return confirm('Remove this build review row?');">Remove</button>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>@item.ProjectName</td>
                                <td>@(string.IsNullOrWhiteSpace(item.MilestoneDescription) ? "-" : item.MilestoneDescription)</td>
                                <td>@item.Status</td>
                                <td>@item.BuildReceiveDate.ToString("dd MMM yyyy")</td>
                                <td class="text-nowrap">@Model.GetBuildAgeingDays(item.BuildReceiveDate) day(s)</td>
                                <td>@item.Eta.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    }
                    @if (Model.CanManagePlanning)
                    {
                        <tr class="table-light">
                            <td>
                                <select class="form-select" name="projectName" form="build-review-new" data-planning-project required>
                                    <option value="">Select project</option>
                                    @foreach (var project in Model.Studios.Select(studio => studio.ProjectName).Distinct(StringComparer.OrdinalIgnoreCase))
                                    {
                                        <option value="@project">@project</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <select class="form-select" name="milestoneDescription" form="build-review-new" data-milestone-description required>
                                    <option value="">Select milestone description</option>
                                    @foreach (var option in Model.MilestoneDescriptionOptions)
                                    {
                                        <option value="@option.Description" data-project="@option.ProjectName">@option.Description</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <select class="form-select" name="status" form="build-review-new" required>
                                    <option value="">Select status</option>
                                    @foreach (var status in Model.BuildReviewStatuses)
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </select>
                            </td>
                            <td><input class="form-control" type="date" name="buildReceiveDate" form="build-review-new" required /></td>
                            <td class="text-secondary text-nowrap">Calculated on save</td>
                            <td><input class="form-control" type="date" name="eta" form="build-review-new" required /></td>
                            <td class="text-end"><button class="btn btn-sm btn-primary" type="submit" form="build-review-new">Add</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="content-section" id="expected-deliveries">
        <div class="section-heading">
            <div><span>@Model.ExpectedDeliveries.Count item(s)</span><h2>Expected Milestone Build Deliveries</h2></div>
            @if (Model.CanManagePlanning)
            {
                <strong>Admin managed</strong>
            }
        </div>
        @if (Model.CanManagePlanning)
        {
            <form id="expected-delivery-new" method="post" asp-page-handler="SaveExpectedDelivery"></form>
            @foreach (var item in Model.ExpectedDeliveries)
            {
                <form id="expected-delivery-@item.Id" method="post" asp-page-handler="SaveExpectedDelivery"></form>
                <form id="expected-delivery-delete-@item.Id" method="post" asp-page-handler="DeleteExpectedDelivery">
                    <input type="hidden" name="id" value="@item.Id" />
                </form>
            }
        }
        @if (Model.ExpectedDeliveries.Count == 0 && !Model.CanManagePlanning)
        {
            <div class="section-body text-secondary">No expected milestone build deliveries have been added.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table styled-table align-middle">
                    <thead>
                        <tr>
                            <th>Project Name</th>
                            <th>Milestone Description</th>
                            <th>Expected Delivery Date</th>
                            @if (Model.CanManagePlanning) { <th class="text-end">Actions</th> }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.ExpectedDeliveries)
                    {
                        if (Model.CanManagePlanning)
                        {
                            var formId = $"expected-delivery-{item.Id}";
                            <tr>
                                <td>
                                    <input type="hidden" name="id" value="@item.Id" form="@formId" />
                                    <select class="form-select" name="projectName" form="@formId" data-planning-project required>
                                        @foreach (var project in Model.Studios.Select(studio => studio.ProjectName).Distinct(StringComparer.OrdinalIgnoreCase))
                                        {
                                            <option value="@project" selected="@(string.Equals(project, item.ProjectName, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@project</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select" name="milestoneDescription" form="@formId" data-milestone-description required>
                                        <option value="">Select milestone description</option>
                                        @if (!Model.MilestoneDescriptionOptions.Any(option =>
                                            string.Equals(option.ProjectName, item.ProjectName, StringComparison.OrdinalIgnoreCase)
                                            && string.Equals(option.Description, item.MilestoneDescription, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <option value="@item.MilestoneDescription" data-project="@item.ProjectName" selected>@item.MilestoneDescription</option>
                                        }
                                        @foreach (var option in Model.MilestoneDescriptionOptions)
                                        {
                                            <option value="@option.Description"
                                                    data-project="@option.ProjectName"
                                                    selected="@(string.Equals(option.ProjectName, item.ProjectName, StringComparison.OrdinalIgnoreCase)
                                                        && string.Equals(option.Description, item.MilestoneDescription, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                @option.Description
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td><input class="form-control" type="date" name="expectedDeliveryDate" value="@item.ExpectedDeliveryDate.ToString("yyyy-MM-dd")" form="@formId" required /></td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-primary" type="submit" form="@formId">Save</button>
                                    <button class="btn btn-sm btn-outline-danger" type="submit" form="expected-delivery-delete-@item.Id" onclick="return confirm('Remove this expected delivery row?');">Remove</button>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>@item.ProjectName</td>
                                <td>@item.MilestoneDescription</td>
                                <td>@item.ExpectedDeliveryDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    }
                    @if (Model.CanManagePlanning)
                    {
                        <tr class="table-light">
                            <td>
                                <select class="form-select" name="projectName" form="expected-delivery-new" data-planning-project required>
                                    <option value="">Select project</option>
                                    @foreach (var project in Model.Studios.Select(studio => studio.ProjectName).Distinct(StringComparer.OrdinalIgnoreCase))
                                    {
                                        <option value="@project">@project</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <select class="form-select" name="milestoneDescription" form="expected-delivery-new" data-milestone-description required>
                                    <option value="">Select milestone description</option>
                                    @foreach (var option in Model.MilestoneDescriptionOptions)
                                    {
                                        <option value="@option.Description" data-project="@option.ProjectName">@option.Description</option>
                                    }
                                </select>
                            </td>
                            <td><input class="form-control" type="date" name="expectedDeliveryDate" form="expected-delivery-new" required /></td>
                            <td class="text-end"><button class="btn btn-sm btn-primary" type="submit" form="expected-delivery-new">Add</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="content-section" id="jira">
        @{
            const string defaultTicketStatus = "In Progress";
            var ticketStatuses = Model.JiraTickets
                .Select(item => string.IsNullOrWhiteSpace(item.Ticket.Status) ? "No status" : item.Ticket.Status.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(status => status, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var defaultTicketCount = Model.JiraTickets.Count(item =>
                string.Equals(item.Ticket.Status?.Trim(), defaultTicketStatus, StringComparison.OrdinalIgnoreCase));
            var hasDefaultTicketStatus = ticketStatuses.Contains(defaultTicketStatus, StringComparer.OrdinalIgnoreCase);
        }
        <div class="section-heading">
            <div><span><span data-ticket-visible-count>@defaultTicketCount</span> of @Model.JiraTickets.Count ticket(s)</span><h2>Support Activity Tickets</h2></div>
            <strong>Sprints overlapping selected period</strong>
        </div>
        @if (Model.JiraMessages.Count > 0)
        {
            <div class="section-body pb-0">
                @foreach (var message in Model.JiraMessages)
                {
                    <div class="alert alert-warning py-2"><strong>@message.Studio.StudioName:</strong> @message.Message</div>
                }
            </div>
        }
        @if (Model.IsUsingSharedJiraCredential)
        {
            <div class="mx-4 mt-3 alert alert-secondary small">Shared support-ticket access is read only. Ticket changes are not permitted from TeamHub.</div>
        }
        @if (Model.JiraTickets.Count == 0)
        {
            <div class="section-body text-secondary">No support tickets were found in sprints overlapping the selected period.</div>
        }
        else
        {
            <div class="section-body pb-3 border-bottom">
                <div class="support-ticket-status-filter" data-ticket-status-filter>
                    <label class="form-label" for="ticket-status-filter-button">Status</label>
                    <div class="dropdown">
                        <button id="ticket-status-filter-button"
                                class="btn btn-outline-secondary dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                                aria-expanded="false">
                            <span data-ticket-status-summary>@(hasDefaultTicketStatus ? defaultTicketStatus : "No status selected")</span>
                        </button>
                        <div class="dropdown-menu support-ticket-status-menu p-3">
                            <div class="d-flex gap-2 mb-2">
                                <button class="btn btn-sm btn-link p-0" type="button" data-ticket-status-all>Select all</button>
                                <span class="text-secondary">&middot;</span>
                                <button class="btn btn-sm btn-link p-0" type="button" data-ticket-status-clear>Clear</button>
                            </div>
                            @foreach (var status in ticketStatuses)
                            {
                                var isDefaultStatus = string.Equals(status, defaultTicketStatus, StringComparison.OrdinalIgnoreCase);
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           value="@status"
                                           id="ticket-status-@ticketStatuses.IndexOf(status)"
                                           data-ticket-status-option
                                           checked="@isDefaultStatus" />
                                    <label class="form-check-label" for="ticket-status-@ticketStatuses.IndexOf(status)">@status</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="form-text">Select one or more statuses. Filtering uses the tickets already loaded on this page.</div>
                </div>
            </div>
            <div class="section-body text-secondary @(defaultTicketCount == 0 ? "" : "d-none")" data-ticket-status-empty>No tickets match the selected statuses.</div>
            <div class="table-responsive @(defaultTicketCount == 0 ? "d-none" : "")" data-ticket-table>
                <table class="table styled-table align-middle">
                    <thead><tr><th>Studio</th><th>Support Type</th><th>Ticket</th><th>Summary</th><th>Assigned User</th><th>Status</th><th>Priority</th><th>Comments</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.JiraTickets)
                    {
                        var ticketStatus = string.IsNullOrWhiteSpace(item.Ticket.Status) ? "No status" : item.Ticket.Status.Trim();
                        var showByDefault = string.Equals(ticketStatus, defaultTicketStatus, StringComparison.OrdinalIgnoreCase);
                        <tr class="@(showByDefault ? "" : "d-none")" data-ticket-row data-ticket-status="@ticketStatus">
                            <td>@item.Studio.StudioName</td>
                            <td><span class="badge @(item.SupportType.StartsWith("Direct", StringComparison.OrdinalIgnoreCase) ? "text-bg-primary" : "text-bg-secondary")">@item.SupportType</span></td>
                            <td><a href="@item.Ticket.Url" target="_blank" rel="noopener">@item.Ticket.TicketId</a></td>
                            <td><a href="@item.Ticket.Url" target="_blank" rel="noopener">@item.Ticket.Summary</a></td>
                            <td>@item.Ticket.AssignedUser</td>
                            <td>@item.Ticket.Status</td>
                            <td>@item.Ticket.Priority</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        data-jira-comments
                                        data-ticket-id="@item.Ticket.TicketId"
                                        data-comments-url="@Url.Page("/SupportSummaryComments", new { studioId = item.Studio.Id, ticketId = item.Ticket.TicketId })">
                                    Jira Comments
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <partial name="_JiraCommentsModal" />

    <section class="content-section"
             id="effort"
             data-effort-report
             data-effort-url="@Url.Page("/SupportSummary", "Effort", new { Model.ReportPeriod, Model.SelectedMonth, Model.Week, Model.StartDate, Model.EndDate })">
        <div class="section-heading">
            <div>
                <span>@Model.StartDate?.ToString("dd MMM yyyy") &ndash; @Model.EndDate?.ToString("dd MMM yyyy")</span>
                <h2>Effort Distribution</h2>
            </div>
            <strong>Actual hours</strong>
        </div>
        <div class="section-body text-secondary" data-effort-loading>
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            Loading logged effort in the background. You can continue using the report.
        </div>
        <div class="section-body text-warning" data-effort-error hidden></div>
        <div class="section-body text-secondary" data-effort-empty hidden>No logged effort was found for the selected period.</div>
        <div class="support-effort-grid section-body" data-effort-content hidden>
            <article class="support-effort-card" data-effort-chart-card="summary">
                <div>
                    <h3>Total Effort Distribution</h3>
                    <p>Logged hours by activity and studio-support group.</p>
                </div>
                <div class="text-secondary" data-effort-chart-empty hidden>No effort summary data is available.</div>
                <div class="support-effort-chart" data-effort-chart>
                    <div class="support-effort-pie" role="img" data-effort-pie></div>
                    <div class="support-effort-legend" data-effort-legend></div>
                </div>
                <div class="support-effort-total" data-effort-total-row>Total <strong data-effort-total></strong></div>
                <div class="support-effort-copy-row">
                    <div class="support-effort-copy-status" data-copy-effort-status role="status" aria-live="polite"></div>
                    <button class="btn btn-sm btn-outline-secondary support-effort-copy"
                            type="button"
                            data-copy-effort-chart
                            title="Copy chart for PowerPoint"
                            aria-label="Copy Total Effort Distribution chart for PowerPoint"
                            disabled>
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <path d="M4.5 1.5h7a2 2 0 0 1 2 2v7h-2v-7h-7v-2Z" />
                            <path d="M2.5 4.5h7a2 2 0 0 1 2 2v7h-9v-9Zm2 2v5h5v-5h-5Z" />
                        </svg>
                    </button>
                </div>
            </article>

            <article class="support-effort-card" data-effort-chart-card="studio">
                <div>
                    <h3>Studio Effort Distribution</h3>
                    <p>Logged studio-support hours by project.</p>
                </div>
                <div class="text-secondary" data-effort-chart-empty hidden>No studio-support effort is available.</div>
                <div class="support-effort-chart" data-effort-chart>
                    <div class="support-effort-pie" role="img" data-effort-pie></div>
                    <div class="support-effort-legend" data-effort-legend></div>
                </div>
                <div class="support-effort-total" data-effort-total-row>Total <strong data-effort-total></strong></div>
                <div class="support-effort-copy-row">
                    <div class="support-effort-copy-status" data-copy-effort-status role="status" aria-live="polite"></div>
                    <button class="btn btn-sm btn-outline-secondary support-effort-copy"
                            type="button"
                            data-copy-effort-chart
                            title="Copy chart for PowerPoint"
                            aria-label="Copy Studio Effort Distribution chart for PowerPoint"
                            disabled>
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <path d="M4.5 1.5h7a2 2 0 0 1 2 2v7h-2v-7h-7v-2Z" />
                            <path d="M2.5 4.5h7a2 2 0 0 1 2 2v7h-9v-9Zm2 2v5h5v-5h-5Z" />
                        </svg>
                    </button>
                </div>
            </article>
        </div>
    </section>

    <section class="content-section" id="confluence">
        <div class="section-heading">
            <div><span>@Model.StartDate?.ToString("dd MMM yyyy") &ndash; @Model.EndDate?.ToString("dd MMM yyyy")</span><h2>Confluence Update</h2></div>
            <strong>All active studios</strong>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.ConfluenceErrorMessage))
        {
            <div class="section-body text-warning">@Model.ConfluenceErrorMessage</div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(Model.ConfluenceResult.Message))
            {
                <div class="mx-4 mt-3 alert @(Model.ConfluenceResult.IsConfigured ? "alert-warning" : "alert-info")">@Model.ConfluenceResult.Message</div>
            }
            @if (Model.ConfluenceResult.IsUsingSharedCredential)
            {
                <div class="mx-4 mt-3 alert alert-secondary small">
                    This report is displayed with shared read-only access.
                    @if (Model.CanEditConfluence)
                    {
                        <text>To save an edit, connect your personal token in <a asp-page="/Profile/Atlassian" class="alert-link">My Atlassian Connection</a>.</text>
                    }
                </div>
            }
            else if (Model.CanEditConfluence)
            {
                <div class="mx-4 mt-3 alert alert-secondary small">
                    Support Summary edit access is enabled. Confluence saves use your personal token from
                    <a asp-page="/Profile/Atlassian" class="alert-link">My Atlassian Connection</a>.
                </div>
            }
            @if (Model.ConfluenceResult.Updates.Count == 0)
            {
                <div class="section-body text-secondary">No Confluence updates match the selected filters.</div>
            }
            else
            {
                var confluenceEditIndex = 0;
                @foreach (var week in Model.ConfluenceResult.Updates.GroupBy(update => new { update.WeekStart, update.WeekEnd }).OrderByDescending(group => group.Key.WeekStart))
                {
                    <div class="section-body border-top">
                        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                            <h3 class="h5 mb-0">@week.Key.WeekStart.ToString("dd MMM yyyy") &ndash; @week.Key.WeekEnd.ToString("dd MMM yyyy")</h3>
                            @{
                                var pageUrl = week.Select(update => update.PageUrl).FirstOrDefault(url => !string.IsNullOrWhiteSpace(url));
                            }
                            @if (!string.IsNullOrWhiteSpace(pageUrl))
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="@pageUrl" target="_blank" rel="noopener">Open in Confluence</a>
                            }
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-top mb-0 support-summary-confluence">
                                <thead class="table-light"><tr><th>Studio</th><th>Studio Work</th><th>HPGDS Support</th><th>WMD Support</th><th>Action Items</th><th>Notes</th></tr></thead>
                                <tbody>
                                @foreach (var update in week)
                                {
                                    var canEditUpdate = Model.CanEditConfluence && update.PageFound && update.StudioFound;
                                    var editFormId = $"confluence-edit-{confluenceEditIndex++}";
                                    <tr data-confluence-update-row>
                                        <th scope="row">
                                            @Model.GetStudioName(update.StudioId)
                                            <div class="small fw-normal text-secondary">@Model.GetStudioGroup(update.StudioId)</div>
                                            @if (canEditUpdate)
                                            {
                                                <form id="@editFormId" method="post" asp-page-handler="SaveConfluenceUpdate"
                                                      class="mt-3" data-confluence-edit-form>
                                                    <input type="hidden" name="studioId" value="@update.StudioId" />
                                                    <input type="hidden" name="pageId" value="@update.PageId" />
                                                    <input type="hidden" name="weekStart" value="@update.WeekStart.ToString("yyyy-MM-dd")" />
                                                    <input type="hidden" name="pageVersion" value="@update.PageVersion" />
                                                    <input type="hidden" name="ReportPeriod" value="@Model.ReportPeriod" />
                                                    <input type="hidden" name="Search" value="@Model.Search" />
                                                    <input type="hidden" name="SelectedMonth" value="@Model.SelectedMonth" />
                                                    <input type="hidden" name="Week" value="@Model.Week" />
                                                    <input type="hidden" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                                                    <input type="hidden" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                                            data-confluence-edit-trigger>Edit this update</button>
                                                    <div class="support-summary-confluence-actions d-none" data-confluence-edit-actions>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                data-confluence-edit-discard>Discard</button>
                                                        <button type="submit" class="btn btn-sm btn-primary"
                                                                data-confluence-edit-save>Save</button>
                                                    </div>
                                                </form>
                                            }
                                        </th>
                                        @if (!update.PageFound || !update.StudioFound)
                                        {
                                            <td colspan="5" class="text-secondary">@update.Message</td>
                                        }
                                        else
                                        {
                                            <td>
                                                <safe-markdown class="markdown-content" text="@(string.IsNullOrWhiteSpace(update.StudioWork) ? "No information provided." : update.StudioWork)" data-confluence-display></safe-markdown>
                                                @if (canEditUpdate)
                                                {
                                                    <textarea name="studioWork" form="@editFormId"
                                                              class="form-control support-summary-confluence-editor d-none" rows="7" maxlength="20000"
                                                              aria-label="Studio Work for @Model.GetStudioName(update.StudioId)"
                                                              data-confluence-editor>@update.StudioWork</textarea>
                                                }
                                            </td>
                                            <td>
                                                <safe-markdown class="markdown-content" text="@(string.IsNullOrWhiteSpace(update.HpgdsSupport) ? "No information provided." : update.HpgdsSupport)" data-confluence-display></safe-markdown>
                                                @if (canEditUpdate)
                                                {
                                                    <textarea name="hpgdsSupport" form="@editFormId"
                                                              class="form-control support-summary-confluence-editor d-none" rows="7" maxlength="20000"
                                                              aria-label="HPGDS Support for @Model.GetStudioName(update.StudioId)"
                                                              data-confluence-editor>@update.HpgdsSupport</textarea>
                                                }
                                            </td>
                                            <td>
                                                <safe-markdown class="markdown-content" text="@(string.IsNullOrWhiteSpace(update.WmdSupport) ? "No information provided." : update.WmdSupport)" data-confluence-display></safe-markdown>
                                                @if (canEditUpdate)
                                                {
                                                    <textarea name="wmdSupport" form="@editFormId"
                                                              class="form-control support-summary-confluence-editor d-none" rows="7" maxlength="20000"
                                                              aria-label="WMD Support for @Model.GetStudioName(update.StudioId)"
                                                              data-confluence-editor>@update.WmdSupport</textarea>
                                                }
                                            </td>
                                            <td>
                                                <safe-markdown class="markdown-content" text="@(string.IsNullOrWhiteSpace(update.ActionItems) ? "No information provided." : update.ActionItems)" data-confluence-display></safe-markdown>
                                                @if (canEditUpdate)
                                                {
                                                    <textarea name="actionItems" form="@editFormId"
                                                              class="form-control support-summary-confluence-editor d-none" rows="7" maxlength="20000"
                                                              aria-label="Action Items for @Model.GetStudioName(update.StudioId)"
                                                              data-confluence-editor>@update.ActionItems</textarea>
                                                }
                                            </td>
                                            <td>
                                                <safe-markdown class="markdown-content" text="@(string.IsNullOrWhiteSpace(update.Notes) ? "No notes provided." : update.Notes)" data-confluence-display></safe-markdown>
                                                @if (canEditUpdate)
                                                {
                                                    <textarea name="notes" form="@editFormId"
                                                              class="form-control support-summary-confluence-editor d-none" rows="7" maxlength="20000"
                                                              aria-label="Notes for @Model.GetStudioName(update.StudioId)"
                                                              data-confluence-editor>@update.Notes</textarea>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
        }
    </section>

    <section class="content-section" id="employee-effort" data-employee-effort>
        <div class="section-heading">
            <div>
                <span>@Model.StartDate?.ToString("dd MMM yyyy") &ndash; @Model.EndDate?.ToString("dd MMM yyyy")</span>
                <h2>Employee Effort Distribution</h2>
            </div>
            <strong>Actual logged hours</strong>
        </div>
        <div class="section-body text-secondary" data-employee-effort-loading>
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            Loading employee effort from the same report.
        </div>
        <div class="section-body text-warning" data-employee-effort-error hidden></div>
        <div class="section-body text-secondary" data-employee-effort-empty hidden>No employee effort was found for the selected period.</div>
        <div class="section-body" data-employee-effort-content hidden>
            <div class="support-effort-user-controls">
                <label for="employee-effort-select" class="form-label">Employee</label>
                <select id="employee-effort-select" class="form-select" data-employee-effort-select></select>
                <div class="form-text">Changing the employee redraws this chart from the already loaded report data.</div>
            </div>

            <article class="support-effort-card support-effort-user-card">
                <div>
                    <h3 data-employee-effort-title>Employee Effort</h3>
                    <p>Logged hours by activity.</p>
                </div>
                <div class="support-effort-chart">
                    <div class="support-effort-pie" role="img" data-employee-effort-pie></div>
                    <div class="support-effort-legend" data-employee-effort-legend></div>
                </div>
                <div class="support-effort-total">Total <strong data-employee-effort-total></strong></div>
                <div class="support-effort-copy-row">
                    <div class="support-effort-copy-status" data-copy-effort-status role="status" aria-live="polite"></div>
                    <button class="btn btn-sm btn-outline-secondary support-effort-copy"
                            type="button"
                            data-copy-effort-chart
                            title="Copy chart for PowerPoint"
                            aria-label="Copy Employee Effort Distribution chart for PowerPoint"
                            disabled>
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <path d="M4.5 1.5h7a2 2 0 0 1 2 2v7h-2v-7h-7v-2Z" />
                            <path d="M2.5 4.5h7a2 2 0 0 1 2 2v7h-9v-9Zm2 2v5h5v-5h-5Z" />
                        </svg>
                    </button>
                </div>
            </article>
        </div>
    </section>

    @if (Model.CanGenerateWeeklyWorkSummary)
    {
        <section class="content-section" id="ai-reports" data-weekly-work-summary>
            <div class="section-heading">
                <div><span>Admin tools</span><h2>AI Reports</h2></div>
            </div>
            <div class="section-body">
                <p class="text-secondary">Generate a report for the selected period and review it in a preview window.</p>
                <form method="post" asp-page-handler="GenerateWeeklyWorkSummary" data-weekly-summary-form>
                    <input type="hidden" name="ReportPeriod" value="@Model.ReportPeriod" />
                    <input type="hidden" name="SelectedMonth" value="@Model.SelectedMonth" />
                    <input type="hidden" name="Week" value="@Model.Week" />
                    <button type="submit" class="btn btn-primary"
                            disabled="@(Model.ReportPeriod != SupportSummaryModel.WeeklyPeriod)">
                        Weekly Work Summary
                    </button>
                </form>
                @if (Model.ReportPeriod != SupportSummaryModel.WeeklyPeriod)
                {
                    <p class="text-secondary mt-2">Select the Weekly summary period to generate this report.</p>
                }
            </div>
            <div class="modal fade" id="weekly-work-summary-modal" tabindex="-1"
                 aria-labelledby="weekly-work-summary-title" aria-hidden="true" data-weekly-summary-modal>
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="weekly-work-summary-title">Weekly Work Summary</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-secondary">
                                Uses only HPGDS Support and Notes for all active studios for
                                @Model.StartDate?.ToString("dd MMM yyyy") &ndash; @Model.EndDate?.ToString("dd MMM yyyy").
                                Search does not limit this report. Review the draft against Confluence before sharing.
                            </p>
                            <div role="status" aria-live="polite" data-weekly-summary-status></div>
                            <div class="alert alert-danger" role="alert" data-weekly-summary-error hidden></div>
                            <div class="alert alert-warning" data-weekly-summary-warnings hidden></div>
                            <div class="table-responsive" data-weekly-summary-preview hidden>
                                <table class="table styled-table align-middle">
                                    <thead><tr><th>Studio</th><th>Support Activity</th></tr></thead>
                                    <tbody data-weekly-summary-rows></tbody>
                                </table>
                            </div>
                            <div role="status" aria-live="polite" data-weekly-summary-copy-status></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-primary" data-weekly-summary-copy hidden>Copy Report</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
}

@section Scripts {
<script src="~/js/weekly-work-summary.js" asp-append-version="true"></script>
<script src="~/js/jira-comments.js" asp-append-version="true"></script>
<script>
(() => {
    document.querySelectorAll('[data-confluence-update-row]').forEach(row => {
        const form = row.querySelector('[data-confluence-edit-form]');
        if (!form) return;

        const edit = form.querySelector('[data-confluence-edit-trigger]');
        const actions = form.querySelector('[data-confluence-edit-actions]');
        const discard = form.querySelector('[data-confluence-edit-discard]');
        const save = form.querySelector('[data-confluence-edit-save]');
        const displays = [...row.querySelectorAll('[data-confluence-display]')];
        const editors = [...row.querySelectorAll('[data-confluence-editor]')];

        const setEditing = editing => {
            displays.forEach(display => display.classList.toggle('d-none', editing));
            editors.forEach(editor => editor.classList.toggle('d-none', !editing));
            edit.classList.toggle('d-none', editing);
            actions.classList.toggle('d-none', !editing);
            if (editing) editors[0]?.focus();
        };

        edit.addEventListener('click', () => setEditing(true));
        discard.addEventListener('click', () => {
            editors.forEach(editor => { editor.value = editor.defaultValue; });
            setEditing(false);
        });
        form.addEventListener('submit', () => {
            discard.disabled = true;
            save.disabled = true;
            save.textContent = 'Saving...';
        });
    });
})();

(() => {
    const form = document.querySelector('[data-support-summary-filters]');
    if (!form) return;
    const period = form.querySelector('[data-report-period]');
    const month = form.querySelector('[data-report-month]');
    const weekField = form.querySelector('[data-week-filter]');
    const week = form.querySelector('[data-report-week]');
    const start = form.querySelector('[data-report-start]');
    const end = form.querySelector('[data-report-end]');
    const isoDate = date => date.toISOString().slice(0, 10);
    const formatDate = date => new Intl.DateTimeFormat(undefined, {
        day: '2-digit',
        month: 'short',
        timeZone: 'UTC'
    }).format(date);
    const selectedMonth = () => {
        const match = /^(\d{4})-(\d{2})$/.exec(month.value);
        return match ? { year: Number(match[1]), monthIndex: Number(match[2]) - 1 } : null;
    };
    const firstWeekStart = value => {
        const date = new Date(Date.UTC(value.year, value.monthIndex, 1));
        date.setUTCDate(date.getUTCDate() - ((date.getUTCDay() + 6) % 7));
        return date;
    };
    const updatePresetDates = () => {
        const value = selectedMonth();
        if (!value || period.value === '@SupportSummaryModel.CustomPeriod') return;
        if (period.value === '@SupportSummaryModel.MonthlyPeriod') {
            start.value = isoDate(new Date(Date.UTC(value.year, value.monthIndex, 1)));
            end.value = isoDate(new Date(Date.UTC(value.year, value.monthIndex + 1, 0)));
            return;
        }
        const weekStart = firstWeekStart(value);
        weekStart.setUTCDate(weekStart.getUTCDate() + (Number(week.value || 1) - 1) * 7);
        const weekEnd = new Date(weekStart);
        weekEnd.setUTCDate(weekEnd.getUTCDate() + 4);
        start.value = isoDate(weekStart);
        end.value = isoDate(weekEnd);
    };

    const populateWeeks = resetSelection => {
        const value = selectedMonth();
        if (!value) return;
        const last = new Date(Date.UTC(value.year, value.monthIndex + 1, 0));
        const cursor = firstWeekStart(value);
        const previous = resetSelection ? '' : week.value;
        week.replaceChildren();
        let number = 1;
        while (cursor <= last) {
            const end = new Date(cursor);
            end.setUTCDate(end.getUTCDate() + 4);
            const option = document.createElement('option');
            option.value = String(number);
            option.textContent = `Week ${number}: ${formatDate(cursor)} - ${formatDate(end)}`;
            week.appendChild(option);
            cursor.setUTCDate(cursor.getUTCDate() + 7);
            number++;
        }
        if (previous && [...week.options].some(option => option.value === previous)) week.value = previous;
        updatePresetDates();
    };

    const updatePeriod = () => {
        const monthly = period.value === '@SupportSummaryModel.MonthlyPeriod';
        const custom = period.value === '@SupportSummaryModel.CustomPeriod';
        month.disabled = custom;
        week.disabled = monthly || custom;
        start.disabled = !custom;
        end.disabled = !custom;
        weekField.classList.toggle('opacity-50', monthly || custom);
        updatePresetDates();
    };

    month.addEventListener('change', () => populateWeeks(true));
    week.addEventListener('change', updatePresetDates);
    period.addEventListener('change', updatePeriod);
updatePeriod();
})();

(() => {
    const updateDescriptions = projectSelect => {
        const formId = projectSelect.getAttribute('form');
        const descriptionSelect = document.querySelector(`[data-milestone-description][form="${formId}"]`);
        if (!descriptionSelect) return;
        const project = projectSelect.value.toLocaleLowerCase();
        let selectedIsAvailable = false;
        for (const option of descriptionSelect.options) {
            if (!option.dataset.project) continue;
            const available = option.dataset.project.toLocaleLowerCase() === project;
            option.hidden = !available;
            option.disabled = !available;
            if (available && option.selected) selectedIsAvailable = true;
        }
        if (!selectedIsAvailable) descriptionSelect.value = '';
    };

    document.querySelectorAll('[data-planning-project]').forEach(projectSelect => {
        projectSelect.addEventListener('change', () => updateDescriptions(projectSelect));
        updateDescriptions(projectSelect);
    });
})();

(() => {
    const root = document.querySelector('[data-ticket-status-filter]');
    if (!root) return;
    const options = [...root.querySelectorAll('[data-ticket-status-option]')];
    const rows = [...document.querySelectorAll('[data-ticket-row]')];
    const visibleCount = document.querySelector('[data-ticket-visible-count]');
    const summary = root.querySelector('[data-ticket-status-summary]');
    const table = document.querySelector('[data-ticket-table]');
    const empty = document.querySelector('[data-ticket-status-empty]');
    const normalize = value => value.trim().toLocaleLowerCase();

    const applyFilter = () => {
        const selectedOptions = options.filter(option => option.checked);
        const selected = new Set(selectedOptions.map(option => normalize(option.value)));
        let count = 0;
        rows.forEach(row => {
            const visible = selected.has(normalize(row.dataset.ticketStatus || ''));
            row.classList.toggle('d-none', !visible);
            if (visible) count++;
        });

        if (visibleCount) visibleCount.textContent = String(count);
        if (table) table.classList.toggle('d-none', count === 0);
        if (empty) empty.classList.toggle('d-none', count !== 0);
        if (summary) {
            summary.textContent = selectedOptions.length === 0
                ? 'No status selected'
                : selectedOptions.length === 1
                    ? selectedOptions[0].value
                    : `${selectedOptions.length} statuses selected`;
        }
    };

    options.forEach(option => option.addEventListener('change', applyFilter));
    root.querySelector('[data-ticket-status-all]')?.addEventListener('click', () => {
        options.forEach(option => option.checked = true);
        applyFilter();
    });
    root.querySelector('[data-ticket-status-clear]')?.addEventListener('click', () => {
        options.forEach(option => option.checked = false);
        applyFilter();
    });
    applyFilter();
})();

(() => {
    const reportRoot = document.querySelector('[data-effort-report]');
    const employeeRoot = document.querySelector('[data-employee-effort]');
    if (!reportRoot || !employeeRoot || !reportRoot.dataset.effortUrl) return;

    const formatNumber = value => value.toLocaleString(undefined, { maximumFractionDigits: 2 });
    const normalizeSlices = values => (values || [])
        .map(slice => ({
            label: slice.label ?? slice.Label ?? '',
            hours: Number(slice.hours ?? slice.Hours ?? 0)
        }))
        .filter(slice => slice.label && slice.hours > 0);

    const chartData = new WeakMap();
    const svgNamespace = 'http://www.w3.org/2000/svg';
    const createSvgElement = (name, attributes = {}, text = null) => {
        const element = document.createElementNS(svgNamespace, name);
        Object.entries(attributes).forEach(([key, value]) => element.setAttribute(key, String(value)));
        if (text !== null) element.textContent = text;
        return element;
    };

    const buildChartSvg = ({ title, slices, colors }) => {
        const total = slices.reduce((sum, slice) => sum + slice.hours, 0);
        const rowHeight = 34;
        const height = Math.max(480, 220 + slices.length * rowHeight);
        const svg = createSvgElement('svg', {
            xmlns: svgNamespace,
            width: 960,
            height,
            viewBox: `0 0 960 ${height}`
        });
        svg.appendChild(createSvgElement('rect', { width: 960, height, fill: '#ffffff' }));
        svg.appendChild(createSvgElement('text', {
            x: 42, y: 56, fill: '#18322d', 'font-family': 'Aptos, Arial, sans-serif',
            'font-size': 28, 'font-weight': 700
        }, title));

        const centerX = 225;
        const centerY = Math.max(250, height / 2 + 18);
        const radius = 150;
        let angle = -Math.PI / 2;
        slices.forEach((slice, index) => {
            const sweep = slice.hours / total * Math.PI * 2;
            const color = colors[index % colors.length] || '#6b7c75';
            if (sweep >= Math.PI * 2 - 0.00001) {
                svg.appendChild(createSvgElement('circle', {
                    cx: centerX, cy: centerY, r: radius, fill: color, stroke: '#ffffff', 'stroke-width': 3
                }));
            } else {
                const end = angle + sweep;
                const x1 = centerX + radius * Math.cos(angle);
                const y1 = centerY + radius * Math.sin(angle);
                const x2 = centerX + radius * Math.cos(end);
                const y2 = centerY + radius * Math.sin(end);
                const largeArc = sweep > Math.PI ? 1 : 0;
                svg.appendChild(createSvgElement('path', {
                    d: `M ${centerX} ${centerY} L ${x1} ${y1} A ${radius} ${radius} 0 ${largeArc} 1 ${x2} ${y2} Z`,
                    fill: color, stroke: '#ffffff', 'stroke-width': 3
                }));
                angle = end;
            }
        });

        const legendX = 455;
        const legendY = 120;
        slices.forEach((slice, index) => {
            const y = legendY + index * rowHeight;
            const color = colors[index % colors.length] || '#6b7c75';
            const percentage = slice.hours / total * 100;
            svg.appendChild(createSvgElement('rect', {
                x: legendX, y: y - 14, width: 18, height: 18, rx: 3, fill: color
            }));
            svg.appendChild(createSvgElement('text', {
                x: legendX + 30, y, fill: '#52665f', 'font-family': 'Aptos, Arial, sans-serif', 'font-size': 17
            }, slice.label.length > 34 ? `${slice.label.slice(0, 33)}…` : slice.label));
            svg.appendChild(createSvgElement('text', {
                x: 805, y, fill: '#18322d', 'font-family': 'Aptos, Arial, sans-serif',
                'font-size': 17, 'font-weight': 700, 'text-anchor': 'end'
            }, `${formatNumber(slice.hours)}h`));
            svg.appendChild(createSvgElement('text', {
                x: 915, y, fill: '#52665f', 'font-family': 'Aptos, Arial, sans-serif',
                'font-size': 17, 'text-anchor': 'end'
            }, `${percentage.toLocaleString(undefined, { maximumFractionDigits: 1 })}%`));
        });
        svg.appendChild(createSvgElement('line', {
            x1: legendX, y1: height - 66, x2: 915, y2: height - 66, stroke: '#d9e1dc'
        }));
        svg.appendChild(createSvgElement('text', {
            x: 915, y: height - 32, fill: '#18322d', 'font-family': 'Aptos, Arial, sans-serif',
            'font-size': 19, 'font-weight': 700, 'text-anchor': 'end'
        }, `Total ${formatNumber(total)} hours`));
        return new XMLSerializer().serializeToString(svg);
    };

    const svgToPng = svgText => new Promise((resolve, reject) => {
        const blobUrl = URL.createObjectURL(new Blob([svgText], { type: 'image/svg+xml;charset=utf-8' }));
        const image = new Image();
        image.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = image.naturalWidth * 2;
            canvas.height = image.naturalHeight * 2;
            const context = canvas.getContext('2d');
            context.scale(2, 2);
            context.drawImage(image, 0, 0);
            URL.revokeObjectURL(blobUrl);
            canvas.toBlob(blob => blob ? resolve(blob) : reject(new Error('Could not create the chart image.')), 'image/png');
        };
        image.onerror = () => {
            URL.revokeObjectURL(blobUrl);
            reject(new Error('Could not render the chart image.'));
        };
        image.src = blobUrl;
    });

    const copyChart = async root => {
        const button = root.querySelector('[data-copy-effort-chart]');
        const status = root.querySelector('[data-copy-effort-status]');
        const data = chartData.get(root);
        if (!button || !status || !data) return;
        if (!navigator.clipboard?.write || !window.ClipboardItem) {
            status.textContent = 'Image copying is not supported by this browser. Use Microsoft Edge or Chrome.';
            status.classList.add('text-danger');
            return;
        }

        button.disabled = true;
        status.classList.remove('text-danger');
        status.textContent = 'Preparing chart…';
        try {
            const svgText = buildChartSvg(data);
            const svgBlob = new Blob([svgText], { type: 'image/svg+xml' });
            const pngBlob = await svgToPng(svgText);
            const supportsSvg = typeof ClipboardItem.supports === 'function'
                && ClipboardItem.supports('image/svg+xml');
            let copiedAsSvg = supportsSvg;
            const clipboardData = supportsSvg
                ? { 'image/svg+xml': svgBlob, 'image/png': pngBlob }
                : { 'image/png': pngBlob };
            try {
                await navigator.clipboard.write([new ClipboardItem(clipboardData)]);
            } catch (error) {
                if (!supportsSvg) throw error;
                copiedAsSvg = false;
                await navigator.clipboard.write([new ClipboardItem({ 'image/png': pngBlob })]);
            }
            status.textContent = copiedAsSvg
                ? 'Copied. Paste it into PowerPoint as a vector graphic.'
                : 'Copied as a high-resolution image. Paste it into PowerPoint.';
        } catch {
            status.textContent = 'The chart could not be copied. Check clipboard permission and try again.';
            status.classList.add('text-danger');
        } finally {
            button.disabled = false;
        }
    };

    document.querySelectorAll('[data-copy-effort-chart]').forEach(button => {
        button.addEventListener('click', () => copyChart(button.closest('.support-effort-card')));
    });

    const renderChart = (root, slices, ariaLabel, colors) => {
        const chart = root.querySelector('[data-effort-chart]') || root.querySelector('.support-effort-chart');
        const empty = root.querySelector('[data-effort-chart-empty]');
        const pie = root.querySelector('[data-effort-pie], [data-employee-effort-pie]');
        const legend = root.querySelector('[data-effort-legend], [data-employee-effort-legend]');
        const totalElement = root.querySelector('[data-effort-total], [data-employee-effort-total]');
        const totalRow = root.querySelector('[data-effort-total-row]');
        const total = slices.reduce((sum, slice) => sum + slice.hours, 0);

        if (empty) empty.hidden = total > 0;
        if (chart) chart.hidden = total <= 0;
        if (totalRow) totalRow.hidden = total <= 0;
        const copyButton = root.querySelector('[data-copy-effort-chart]');
        const copyStatus = root.querySelector('[data-copy-effort-status]');
        if (copyButton) copyButton.disabled = total <= 0;
        if (copyStatus) {
            copyStatus.textContent = '';
            copyStatus.classList.remove('text-danger');
        }
        if (!pie || !legend || !totalElement || total <= 0) {
            chartData.delete(root);
            return;
        }

        chartData.set(root, {
            title: root.querySelector('h3')?.textContent?.trim() || ariaLabel.replace(/ pie chart$/i, ''),
            slices: slices.map(slice => ({ ...slice })),
            colors: [...colors]
        });

        let start = 0;
        const stops = slices.map((slice, index) => {
            const end = start + slice.hours / total * 100;
            const stop = `${colors[index % colors.length]} ${start}% ${end}%`;
            start = end;
            return stop;
        });

        pie.style.background = total > 0 && colors.length > 0
            ? `conic-gradient(${stops.join(', ')})`
            : '#d9e1dc';
        pie.setAttribute('aria-label', `${ariaLabel}. Total ${formatNumber(total)} hours.`);
        legend.replaceChildren();

        slices.forEach((slice, index) => {
            const row = document.createElement('div');
            row.className = 'support-effort-legend-item';

            const swatch = document.createElement('span');
            swatch.className = 'support-effort-swatch';
            swatch.style.backgroundColor = colors[index % colors.length];

            const label = document.createElement('span');
            label.className = 'support-effort-label';
            label.textContent = slice.label;

            const hours = document.createElement('strong');
            hours.textContent = `${formatNumber(slice.hours)}h`;

            const share = document.createElement('span');
            share.textContent = `${(slice.hours / total * 100).toLocaleString(undefined, { maximumFractionDigits: 1 })}%`;

            row.append(swatch, label, hours, share);
            legend.appendChild(row);
        });

        totalElement.textContent = `${formatNumber(total)} hours`;
    };

    const showError = message => {
        const reportError = reportRoot.querySelector('[data-effort-error]');
        const employeeError = employeeRoot.querySelector('[data-employee-effort-error]');
        if (reportError) {
            reportError.textContent = message;
            reportError.hidden = false;
        }
        if (employeeError) {
            employeeError.textContent = message;
            employeeError.hidden = false;
        }
    };

    fetch(reportRoot.dataset.effortUrl, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
        .then(response => {
            if (!response.ok) throw new Error(`Effort request failed with status ${response.status}.`);
            return response.json();
        })
        .then(data => {
            if (data.error) {
                showError(data.error);
                return;
            }

            const colors = data.colors || [];
            const summary = normalizeSlices(data.effortSummary);
            const studio = normalizeSlices(data.studioEffortBreakdown);
            const reportEmpty = reportRoot.querySelector('[data-effort-empty]');
            const reportContent = reportRoot.querySelector('[data-effort-content]');
            if (summary.length === 0 && studio.length === 0) {
                if (reportEmpty) reportEmpty.hidden = false;
            } else {
                if (reportContent) reportContent.hidden = false;
                renderChart(
                    reportRoot.querySelector('[data-effort-chart-card="summary"]'),
                    summary,
                    'Actual effort summary pie chart',
                    colors);
                renderChart(
                    reportRoot.querySelector('[data-effort-chart-card="studio"]'),
                    studio,
                    'Actual studio support pie chart',
                    colors);
            }

            const employees = (data.employeeEffortBreakdowns || []).map(employee => ({
                employee: employee.employee ?? employee.Employee ?? '',
                slices: normalizeSlices(employee.slices ?? employee.Slices)
            })).filter(employee => employee.employee && employee.slices.length > 0);
            const employeeEmpty = employeeRoot.querySelector('[data-employee-effort-empty]');
            const employeeContent = employeeRoot.querySelector('[data-employee-effort-content]');
            const select = employeeRoot.querySelector('[data-employee-effort-select]');
            if (employees.length === 0) {
                if (employeeEmpty) employeeEmpty.hidden = false;
                return;
            }

            employeeContent.hidden = false;
            select.replaceChildren(...employees.map((employee, index) => {
                const option = document.createElement('option');
                option.value = String(index);
                option.textContent = employee.employee;
                return option;
            }));
            const renderEmployee = () => {
                const employee = employees[Number(select.value)] || employees[0];
                const employeeTitle = employeeRoot.querySelector('[data-employee-effort-title]');
                if (employeeTitle) employeeTitle.textContent = `${employee.employee} Effort Distribution`;
                const employeeCopyButton = employeeRoot.querySelector('[data-copy-effort-chart]');
                if (employeeCopyButton) {
                    employeeCopyButton.setAttribute(
                        'aria-label',
                        `Copy ${employee.employee} Effort Distribution chart for PowerPoint`);
                }
                renderChart(
                    employeeRoot.querySelector('.support-effort-user-card'),
                    employee.slices,
                    `Actual effort for ${employee.employee}`,
                    colors);
            };
            select.addEventListener('change', renderEmployee);
            renderEmployee();
        })
        .catch(() => showError('Something went wrong while loading logged effort. Please try again.'))
        .finally(() => {
            const reportLoading = reportRoot.querySelector('[data-effort-loading]');
            const employeeLoading = employeeRoot.querySelector('[data-employee-effort-loading]');
            if (reportLoading) reportLoading.hidden = true;
            if (employeeLoading) employeeLoading.hidden = true;
        });
})();
</script>
}
