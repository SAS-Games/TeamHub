@page "/Team/Achievements"
@model TeamHub.Web.Pages.Team.AchievementsModel
@{
    ViewData["Title"] = "Team Achievements";
    ViewData["TeamTab"] = "Achievements";
}

<div class="page-hero">
    <div>
        <h1>Team Achievements</h1>
        <p>Celebrate and preserve the milestones achieved by the team.</p>
    </div>
</div>
<partial name="_TeamNav" />

@if (Model.Achievements.Count == 0)
{
    <div class="alert alert-info">No team achievements have been added yet.</div>
}
else
{
    <section class="content-section">
        <div class="section-heading">
            <div><span>Team history</span><h2>All Achievements</h2></div>
            <strong>@Model.Achievements.Count recorded</strong>
        </div>
        <div class="achievement-list">
            @foreach (var achievement in Model.Achievements)
            {
                <article class="achievement-item">
                    <time class="@Model.Appearance.CssClass("achieved-on")" datetime="@achievement.AchievedOn.ToString("yyyy-MM-dd")">@achievement.AchievedOn.ToString("dd MMM yyyy")</time>
                    <div>
                        <h3 class="@Model.Appearance.CssClass("title")">@achievement.Title</h3>
                        <safe-markdown class="markdown-content @Model.Appearance.CssClass("description")" text="@achievement.Description"></safe-markdown>
                        @if (!string.IsNullOrWhiteSpace(achievement.Impact))
                        {
                            <div class="achievement-impact @Model.Appearance.CssClass("impact")">
                                <span>Impact</span>
                                <safe-markdown class="markdown-content" text="@achievement.Impact"></safe-markdown>
                            </div>
                        }
                        <strong class="@Model.Appearance.CssClass("achieved-by")">Achieved by @achievement.AchievedBy</strong>
                    </div>
                </article>
            }
        </div>
    </section>
}
