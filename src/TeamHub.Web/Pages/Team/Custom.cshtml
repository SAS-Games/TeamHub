@page "/Team/Custom/{slug}"
@model TeamHub.Web.Pages.Team.CustomModel
@using TeamHub.Team
@{
    ViewData["Title"] = Model.Tab.Name;
    ViewData["TeamTab"] = "Custom:" + Model.Tab.Slug;
    ViewData["PageWidth"] = Model.Tab.PageWidth;
}

<div class="page-hero">
    <div>
        <div class="eyebrow">@(Model.Tab.NavigationPlacement == CustomTeamTabPlacements.MainNavigation ? "Shared knowledge" : "Team")</div>
        <h1>@Model.Tab.Name</h1>
        <p>Shared team information maintained in configurable tables.</p>
    </div>
</div>
@if (Model.Tab.NavigationPlacement == CustomTeamTabPlacements.TeamSection)
{
    <partial name="_TeamNav" />
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success mt-3">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger mt-3">@Model.ErrorMessage</div>
}

@if (Model.Tab.Tables.Count == 0)
{
    <section class="content-section"><div class="p-4 text-secondary">No tables have been configured for this tab.</div></section>
}

@foreach (var table in Model.Tab.Tables)
{
    var localColumns = table.Columns.Where(column => !column.IsSourceColumn).ToList();
    var showActions = Model.CanEdit
        && (localColumns.Count > 0 || !table.IsExcelBacked || table.Rows.Any(row => row.IsMissingFromSource));
    <section class="content-section custom-team-table">
        <div class="section-heading">
            <div>
                <span>@(table.IsExcelBacked ? "Excel-backed data" : "Shared data")</span>
                <h2>@table.Name</h2>
                @if (table.IsExcelBacked)
                {
                    <small class="text-secondary">Primary key: @table.PrimaryKeySourceHeader@if (table.LastSyncedAtUtc.HasValue) { <text> · Synced @table.LastSyncedAtUtc.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</text> }</small>
                }
            </div>
            <strong>@table.Rows.Count rows</strong>
        </div>
        @if (table.Columns.Count == 0)
        {
            <div class="p-4 text-secondary">@(table.IsExcelBacked ? "Synchronize this table to import its Excel columns and rows." : "This table does not have any active columns.")</div>
            continue;
        }
        @if (table.Columns.Any(column => column.FieldType == CustomTeamFieldTypes.LongText))
        {
            <div class="px-4 pt-3"><partial name="_MarkdownHelp" /></div>
        }
        <div class="table-responsive">
            <table class="table styled-table align-middle">
                <thead>
                    <tr>
                        @if (table.IsExcelBacked) { <th>Source status</th> }
                        @foreach (var column in table.Columns)
                        {
                            <th>@column.Label@if (column.IsRequired) { <span class="text-danger"> *</span> }@if (column.IsSourceColumn) { <span class="badge text-bg-light ms-1">Excel</span> }</th>
                        }
                        @if (showActions) { <th>Actions</th> }
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in table.Rows)
                {
                    var rowFormId = $"row-{row.Id}";
                    <tr class="@(row.IsMissingFromSource ? "custom-team-row-missing" : null)">
                        @if (table.IsExcelBacked)
                        {
                            <td>@if (row.IsMissingFromSource) { <span class="badge text-bg-warning">Missing from Excel</span> } else { <span class="badge text-bg-success">Current</span> }</td>
                        }
                        @foreach (var column in table.Columns)
                        {
                            var value = Model.Value(row, column);
                            <td>
                                @if (Model.CanEdit && !column.IsSourceColumn)
                                {
                                    <partial name="_CustomTeamCellEditor" model="@(new CustomTeamCellEditorModel(column, value, rowFormId))" />
                                }
                                else
                                {
                                    @if (column.FieldType == CustomTeamFieldTypes.LongText)
                                    {
                                        <safe-markdown class="markdown-content custom-team-cell-value" text="@value"></safe-markdown>
                                    }
                                    else
                                    {
                                        <span class="custom-team-cell-value">@value</span>
                                    }
                                }
                            </td>
                        }
                        @if (showActions)
                        {
                            <td class="text-nowrap">
                                <form id="@rowFormId" method="post" asp-page-handler="SaveRow" asp-route-slug="@Model.Tab.Slug">
                                    <input type="hidden" name="tableId" value="@table.Id" /><input type="hidden" name="rowId" value="@row.Id" /><input type="hidden" name="version" value="@row.Version" />
                                    @if (localColumns.Count > 0 || !table.IsExcelBacked) { <button class="btn btn-sm btn-outline-primary" type="submit">Save</button> }
                                    @if (!table.IsExcelBacked || row.IsMissingFromSource)
                                    {
                                        <button class="btn btn-sm btn-outline-danger ms-1" type="submit" formaction="?handler=RemoveRow&amp;slug=@Model.Tab.Slug&amp;tableId=@table.Id&amp;rowId=@row.Id&amp;version=@row.Version" formnovalidate onclick="return confirm('Remove this row from Team Hub?')">Remove</button>
                                    }
                                </form>
                            </td>
                        }
                    </tr>
                }
                @if (Model.CanEdit && !table.IsExcelBacked)
                {
                    var addFormId = $"add-{table.Id}";
                    <tr class="table-light">
                        @foreach (var column in table.Columns) { <td><partial name="_CustomTeamCellEditor" model="@(new CustomTeamCellEditorModel(column, string.Empty, addFormId))" /></td> }
                        <td><form id="@addFormId" method="post" asp-page-handler="SaveRow" asp-route-slug="@Model.Tab.Slug"><input type="hidden" name="tableId" value="@table.Id" /><input type="hidden" name="version" value="0" /><button class="btn btn-sm btn-primary" type="submit">Add row</button></form></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
