@using TeamHub.Authentication
@using TeamHub.Team
@using TeamHub.Web.AccessControl
@inject ICustomTeamTabService CustomTabs
@inject ICurrentAccessService CurrentAccess
@{
    var current = (string)ViewData["TeamTab"]!;
    var customTabs = (await CustomTabs.ListTabsAsync(Context.RequestAborted))
        .Where(tab => tab.NavigationPlacement == CustomTeamTabPlacements.TeamSection)
        .ToList();
    var visibleModules = new HashSet<string>(StringComparer.Ordinal);
    foreach (var tab in customTabs)
    {
        var module = CustomTeamTabAccess.ModuleForSlug(tab.Slug);
        if (await CurrentAccess.CanAsync(module, AccessLevel.ReadOnly, Context.RequestAborted))
        {
            visibleModules.Add(module);
        }
    }
}
<nav class="page-switcher" aria-label="Team views">
    <a class="@(current == "Directory" ? "active" : "")" asp-page="/Team/Directory">Team Directory</a>
    <a class="@(current == "ResponsibilityMatrix" ? "active" : "")" asp-page="/Team/ResponsibilityMatrix">Responsibility Matrix</a>
    <a class="@(current == "Achievements" ? "active" : "")" asp-page="/Team/Achievements">Achievements</a>
    @foreach (var tab in customTabs)
    {
        if (visibleModules.Contains(CustomTeamTabAccess.ModuleForSlug(tab.Slug)))
        {
            <a class="@(current == "Custom:" + tab.Slug ? "active" : "")" asp-page="/Team/Custom" asp-route-slug="@tab.Slug">@tab.Name</a>
        }
    }
</nav>
