@page "/Team/Configuration"
@model TeamHub.Web.Pages.Team.ConfigurationModel
@using TeamHub.Team
@{
    ViewData["Title"] = "Team Configuration";
}

<div class="page-hero">
    <div>
        <div class="eyebrow">Admin</div>
        <h1>Team Configuration</h1>
        <p>Maintain the people and support ownership displayed in the Team tab.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Configuration/Index">All Configuration</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info mt-3">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger mt-3">@Model.ErrorMessage</div>
}

<nav class="team-config-tabs" aria-label="Team configuration sections">
    <a class="@(Model.ActiveSection == "members" ? "active" : "")" asp-page="/Team/Configuration" asp-route-section="members">
        Team Members <span>@Model.Directory.Members.Count</span>
    </a>
    <a class="@(Model.ActiveSection == "specializations" ? "active" : "")" asp-page="/Team/Configuration" asp-route-section="specializations">
        Specializations <span>@Model.Directory.Specializations.Count</span>
    </a>
    <a class="@(Model.ActiveSection == "achievements" ? "active" : "")" asp-page="/Team/Configuration" asp-route-section="achievements">
        Achievements <span>@Model.Achievements.Count</span>
    </a>
    <a class="@(Model.ActiveSection == "appearance" ? "active" : "")" asp-page="/Team/Configuration" asp-route-section="appearance">
        Text Appearance <span>@Model.AppearancePages.Count</span>
    </a>
    <a class="@(Model.ActiveSection == "custom-tabs" ? "active" : "")" asp-page="/Team/Configuration" asp-route-section="custom-tabs">
        Custom Tabs <span>@Model.CustomTabs.Count</span>
    </a>
</nav>

@if (Model.ActiveSection == "members")
{
    <div class="team-config-panel row g-4">
        <div class="col-12 col-xl-5">
            <section class="content-section h-100 m-0">
                <div class="section-heading">
                    <div><span>Team info</span><h2>@(string.IsNullOrWhiteSpace(Model.MemberInput.Id) ? "Add Team Member" : "Edit Team Member")</h2></div>
                </div>
                <form method="post" asp-page-handler="SaveMember" class="section-body">
                    <input type="hidden" asp-for="MemberInput.Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="MemberInput.Section" class="form-label">Directory Section</label>
                        <select asp-for="MemberInput.Section" class="form-select">
                            <option value="TeamMember">Team Member</option>
                            <option value="Management">Management</option>
                        </select>
                        <span asp-validation-for="MemberInput.Section" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MemberInput.EmployeeName" class="form-label">Employee Name</label>
                        <input asp-for="MemberInput.EmployeeName" class="form-control" />
                        <span asp-validation-for="MemberInput.EmployeeName" class="text-danger"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="MemberInput.Role" class="form-label"></label>
                            <input asp-for="MemberInput.Role" class="form-control" />
                            <span asp-validation-for="MemberInput.Role" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MemberInput.Gid" class="form-label">GID</label>
                            <input asp-for="MemberInput.Gid" class="form-control" />
                            <span asp-validation-for="MemberInput.Gid" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MemberInput.Email" class="form-label"></label>
                            <input asp-for="MemberInput.Email" class="form-control" type="email" />
                            <span asp-validation-for="MemberInput.Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MemberInput.ContactNumber" class="form-label">Contact Number</label>
                            <input asp-for="MemberInput.ContactNumber" class="form-control" />
                            <span asp-validation-for="MemberInput.ContactNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Save Team Member</button>
                        @if (!string.IsNullOrWhiteSpace(Model.MemberInput.Id))
                        {
                            <a class="btn btn-outline-secondary" asp-page="/Team/Configuration" asp-route-section="members">Cancel</a>
                        }
                    </div>
                </form>
            </section>
        </div>
        <div class="col-12 col-xl-7">
            <section class="content-section h-100 m-0">
                <div class="section-heading"><div><span>Directory</span><h2>Team Members</h2></div><strong>@Model.Directory.Members.Count configured</strong></div>
                @if (Model.Directory.Members.Count == 0)
                {
                    <div class="p-4 text-secondary">No team members have been configured.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table styled-table">
                            <thead><tr><th>Employee</th><th>Section</th><th>Role</th><th>GID</th><th>Actions</th></tr></thead>
                            <tbody>
                            @foreach (var member in Model.Directory.Members)
                            {
                                <tr>
                                    <td><strong>@member.EmployeeName</strong><br /><small class="text-secondary">@member.Email</small></td>
                                    <td><span class="team-section-badge">@(@member.Section == "Management" ? "Management" : "Team Member")</span></td>
                                    <td>@member.Role</td><td>@member.Gid</td>
                                    <td class="studio-actions">
                                        <a class="btn btn-sm btn-outline-primary" asp-page="/Team/Configuration" asp-route-section="members" asp-route-memberId="@member.Id">Edit</a>
                                        <form method="post" asp-page-handler="DeleteMember" asp-route-memberId="@member.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </div>
}
else if (Model.ActiveSection == "specializations")
{
    <div class="team-config-panel row g-4">
        <div class="col-12 col-xl-5">
            <section class="content-section h-100 m-0">
                <div class="section-heading">
                    <div><span>Support ownership</span><h2>@(string.IsNullOrWhiteSpace(Model.SupportInput.Id) ? "Add Specialization" : "Edit Specialization")</h2></div>
                </div>
                <form method="post" asp-page-handler="SaveSpecialization" class="section-body">
                    <input type="hidden" asp-for="SupportInput.Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="SupportInput.Pod" class="form-label">Pod</label>
                        <input asp-for="SupportInput.Pod" class="form-control" />
                        <span asp-validation-for="SupportInput.Pod" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SupportInput.FocusAreas" class="form-label">Sub-Categories / Focus Areas</label>
                        <textarea asp-for="SupportInput.FocusAreas" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="SupportInput.FocusAreas" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SupportInput.Members" class="form-label">Engineers / Members</label>
                        <textarea asp-for="SupportInput.Members" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="SupportInput.Members" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Save Specialization</button>
                        @if (!string.IsNullOrWhiteSpace(Model.SupportInput.Id))
                        {
                            <a class="btn btn-outline-secondary" asp-page="/Team/Configuration" asp-route-section="specializations">Cancel</a>
                        }
                    </div>
                </form>
            </section>
        </div>
        <div class="col-12 col-xl-7">
            <section class="content-section h-100 m-0">
                <div class="section-heading"><div><span>Ownership</span><h2>Specializations</h2></div><strong>@Model.Directory.Specializations.Count configured</strong></div>
                @if (Model.Directory.Specializations.Count == 0)
                {
                    <div class="p-4 text-secondary">No support specializations have been configured.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table styled-table">
                            <thead><tr><th>Pod</th><th>Focus Areas</th><th>Members</th><th>Actions</th></tr></thead>
                            <tbody>
                            @foreach (var specialization in Model.Directory.Specializations)
                            {
                                <tr>
                                    <td><strong>@specialization.Pod</strong></td><td>@specialization.FocusAreas</td><td>@specialization.Members</td>
                                    <td class="studio-actions">
                                        <a class="btn btn-sm btn-outline-primary" asp-page="/Team/Configuration" asp-route-section="specializations" asp-route-specializationId="@specialization.Id">Edit</a>
                                        <form method="post" asp-page-handler="DeleteSpecialization" asp-route-specializationId="@specialization.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </div>
}
else if (Model.ActiveSection == "achievements")
{
    <div class="team-config-panel row g-4">
        <div class="col-12 col-xl-5">
            <section class="content-section h-100 m-0">
                <div class="section-heading"><div><span>Team history</span><h2>Add Achievement</h2></div></div>
                <form method="post" asp-page-handler="SaveAchievement" class="section-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="AchievementForm.Title" class="form-label"></label>
                        <input asp-for="AchievementForm.Title" class="form-control" placeholder="What did the team achieve?" />
                        <span asp-validation-for="AchievementForm.Title" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AchievementForm.AchievedOn" class="form-label">Achievement Date</label>
                        <input asp-for="AchievementForm.AchievedOn" class="form-control" type="date" />
                        <span asp-validation-for="AchievementForm.AchievedOn" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AchievementForm.AchievedBy" class="form-label">Achieved By</label>
                        <input asp-for="AchievementForm.AchievedBy" class="form-control" placeholder="Team, pod, or team member names" />
                        <span asp-validation-for="AchievementForm.AchievedBy" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AchievementForm.Description" class="form-label"></label>
                        <textarea asp-for="AchievementForm.Description" class="form-control" rows="5" placeholder="Describe the achievement and its impact"></textarea>
                        <span asp-validation-for="AchievementForm.Description" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Add Achievement</button>
                </form>
            </section>
        </div>
        <div class="col-12 col-xl-7">
            <section class="content-section h-100 m-0">
                <div class="section-heading">
                    <div><span>Published history</span><h2>Achievements</h2></div>
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Team/Achievements">View Public Page</a>
                </div>
                @if (Model.Achievements.Count == 0)
                {
                    <div class="p-4 text-secondary">No team achievements have been added yet.</div>
                }
                else
                {
                    <div class="achievement-list achievement-list-compact">
                        @foreach (var achievement in Model.Achievements)
                        {
                            <article class="achievement-item">
                                <time datetime="@achievement.AchievedOn.ToString("yyyy-MM-dd")">@achievement.AchievedOn.ToString("dd MMM yyyy")</time>
                                <div>
                                    <h3>@achievement.Title</h3>
                                    <p>@achievement.Description</p>
                                    <strong>Achieved by @achievement.AchievedBy</strong>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
}
else if (Model.ActiveSection == "appearance")
{
    <div class="team-config-panel">
        <section class="content-section m-0">
            <div class="section-heading">
                <div>
                    <span>Page styling</span>
                    <h2>Column Text Appearance</h2>
                </div>
                <strong>Applies to headings and values</strong>
            </div>
            <form method="post" asp-page-handler="SaveAppearance" class="section-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-4">
                    <label asp-for="AppearanceForm.PageKey" class="form-label">Page</label>
                    <select asp-for="AppearanceForm.PageKey"
                            class="form-select"
                            onchange="window.location.href='?section=appearance&amp;appearancePage=' + encodeURIComponent(this.value)">
                        @foreach (var appearancePageOption in Model.AppearancePages)
                        {
                            <option value="@appearancePageOption.Key">@appearancePageOption.Label</option>
                        }
                    </select>
                    <span asp-validation-for="AppearanceForm.PageKey" class="text-danger"></span>
                    <div class="form-text">Choose a page, then select one text style for each column.</div>
                </div>

                <div class="table-responsive appearance-settings">
                    <table class="table styled-table align-middle">
                        <thead>
                            <tr><th>Column</th><th>Style</th><th>Preview</th></tr>
                        </thead>
                        <tbody>
                        @for (var index = 0; index < Model.AppearanceForm.Columns.Count; index++)
                        {
                            <tr data-appearance-row>
                                <td>
                                    <input type="hidden" asp-for="AppearanceForm.Columns[index].ColumnKey" />
                                    @Model.AppearanceForm.Columns[index].Label
                                </td>
                                <td>
                                    <select asp-for="AppearanceForm.Columns[index].Style"
                                            class="form-select form-select-sm"
                                            data-appearance-style>
                                        <option value="Normal">Normal</option>
                                        <option value="Bold">Bold</option>
                                        <option value="Italic">Italic</option>
                                        <option value="BoldItalic">Bold + Italic</option>
                                    </select>
                                </td>
                                <td><span class="configured-text" data-appearance-preview>Sample text</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Save Text Appearance</button>
            </form>
        </section>
    </div>
}

else
{
    <div class="team-config-panel row g-4">
        <div class="col-12 col-xl-4">
            <section class="content-section h-100 m-0">
                <div class="section-heading"><div><span>Navigation</span><h2>Create Team Tab</h2></div></div>
                <form method="post" asp-page-handler="SaveCustomTab" class="section-body">
                    <div class="mb-3"><label class="form-label" for="new-tab-name">Tab name</label><input id="new-tab-name" name="name" class="form-control" maxlength="80" required /></div>
                    <div class="mb-3"><label class="form-label" for="new-tab-order">Display order</label><input id="new-tab-order" name="displayOrder" class="form-control" type="number" min="0" value="0" /></div>
                    <button class="btn btn-primary" type="submit">Create Tab</button>
                </form>
                <div class="list-group list-group-flush border-top">
                    @foreach (var tab in Model.CustomTabs)
                    {
                        <a class="list-group-item list-group-item-action @(Model.SelectedCustomTab?.Id == tab.Id ? "active" : "")" asp-page="/Team/Configuration" asp-route-section="custom-tabs" asp-route-customTabId="@tab.Id">
                            <strong>@tab.Name</strong><small class="d-block opacity-75">/@tab.Slug</small>
                        </a>
                    }
                </div>
            </section>
        </div>
        <div class="col-12 col-xl-8">
            @if (Model.SelectedCustomTab is null)
            {
                <section class="content-section m-0"><div class="p-4 text-secondary">Create a tab to start defining tables and columns.</div></section>
            }
            else
            {
                var selectedTab = Model.SelectedCustomTab;
                <section class="content-section m-0 mb-4">
                    <div class="section-heading">
                        <div><span>Tab settings</span><h2>@selectedTab.Name</h2></div>
                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Team/Custom" asp-route-slug="@selectedTab.Slug">Open Tab</a>
                    </div>
                    <div class="section-body">
                        <form method="post" asp-page-handler="SaveCustomTab" class="row g-2 align-items-end">
                            <input type="hidden" name="id" value="@selectedTab.Id" />
                            <div class="col-md-7"><label class="form-label">Tab name</label><input name="name" class="form-control" maxlength="80" value="@selectedTab.Name" required /></div>
                            <div class="col-md-3"><label class="form-label">Display order</label><input name="displayOrder" class="form-control" type="number" min="0" value="@selectedTab.DisplayOrder" /></div>
                            <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Save</button></div>
                        </form>
                        <form method="post" asp-page-handler="ArchiveCustomTab" class="mt-3" onsubmit="return confirm('Archive this tab and hide it from users?')">
                            <input type="hidden" name="id" value="@selectedTab.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Archive Tab</button>
                        </form>
                        <form method="post" asp-page-handler="DeleteCustomTab" class="mt-2" onsubmit="return confirm('Permanently delete this tab, all its tables, rows, audit history, and access settings? This cannot be undone.')">
                            <input type="hidden" name="id" value="@selectedTab.Id" />
                            <button class="btn btn-sm btn-danger" type="submit">Permanently Delete Tab</button>
                        </form>
                    </div>
                </section>

                <section class="content-section m-0 mb-4">
                    <div class="section-heading"><div><span>Schema</span><h2>Add Table</h2></div></div>
                    <form method="post" asp-page-handler="SaveCustomTable" class="section-body" enctype="multipart/form-data" data-excel-source-form>
                        <input type="hidden" name="tabId" value="@selectedTab.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-md-6"><label class="form-label">Table name</label><input name="name" class="form-control" maxlength="100" required /></div>
                            <div class="col-md-2"><label class="form-label">Order</label><input name="displayOrder" class="form-control" type="number" min="0" value="@selectedTab.Tables.Count" /></div>
                            <div class="col-md-4"><label class="form-label">Data source</label><select name="sourceType" class="form-select" data-excel-source-select><option value="Manual">Manual entry</option><option value="ExcelUrl">Excel download link</option><option value="MicrosoftGraphExcel">SharePoint / OneDrive</option><option value="UploadedExcel">Upload from this computer</option></select></div>
                            <div class="col-12" data-excel-backed><div class="alert alert-warning py-2 mb-1">Imported workbook data is stored in Team Hub. Use Access Management to assign the users who may view or edit this tab.</div></div>
                            <div class="col-12" data-source-types="ExcelUrl MicrosoftGraphExcel"><label class="form-label">Workbook link</label><input name="sourceUrl" class="form-control" type="url" maxlength="2048" placeholder="https://..." required /><div class="form-text">For SharePoint or OneDrive, paste the complete browser or Copy link. For an Excel download source, enter a direct workbook URL.</div></div>
                            <div class="col-12" data-source-types="MicrosoftGraphExcel"><div class="alert alert-secondary mb-0">TeamHub resolves this link through Microsoft Graph using the configured application identity. No Drive ID or Item ID is required.</div></div>
                            <div class="col-12" data-source-types="UploadedExcel"><label class="form-label">Excel file from this computer</label><input name="sourceFile" class="form-control" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required /></div>
                            <div class="col-md-3" data-excel-backed><label class="form-label">Worksheet <span class="text-secondary">(optional)</span></label><input name="sourceWorksheet" class="form-control" maxlength="200" /></div>
                            <div class="col-md-3" data-excel-backed><label class="form-label">Header row</label><input name="sourceHeaderRow" class="form-control" type="number" min="1" max="1000" value="1" /></div>
                            <div class="col-md-6" data-excel-backed><label class="form-label">Primary key column <span class="text-secondary">(select after schema import)</span></label><input name="primaryKeySourceHeader" class="form-control" maxlength="200" placeholder="Optional until the Excel schema is imported" /><div class="form-text">Save the table, import its Excel schema, and then select the primary-key header before synchronizing rows.</div></div>
                            <div class="col-md-4" data-source-types="ExcelUrl MicrosoftGraphExcel"><button class="btn btn-outline-primary w-100" type="submit" asp-page-handler="TestCustomTableSource" data-test-excel-source>Test workbook</button></div>
                            <div class="col-md-4 ms-auto"><button class="btn btn-primary w-100" type="submit">Add table</button></div>
                            <div class="col-12 alert mb-0" data-excel-source-test-result hidden></div>
                        </div>
                    </form>
                </section>

                @foreach (var table in selectedTab.Tables)
                {
                    var sourceColumns = table.Columns.Where(column => column.IsSourceColumn && !string.IsNullOrWhiteSpace(column.SourceHeader)).ToList();
                    <section class="content-section m-0 mb-4">
                        <div class="section-heading"><div><span>Configurable table</span><h2>@table.Name</h2></div><strong>@table.Columns.Count columns</strong></div>
                        <div class="section-body border-bottom">
                            <form method="post" asp-page-handler="SaveCustomTable" class="row g-2 align-items-end" enctype="multipart/form-data" data-excel-source-form>
                                <input type="hidden" name="tabId" value="@selectedTab.Id" /><input type="hidden" name="tableId" value="@table.Id" />
                                <div class="col-md-5"><label class="form-label">Table name</label><input name="name" class="form-control form-control-sm" value="@table.Name" required /></div>
                                <div class="col-md-2"><label class="form-label">Order</label><input name="displayOrder" class="form-control form-control-sm" type="number" min="0" value="@table.DisplayOrder" /></div>
                                <div class="col-md-3"><label class="form-label">Data source</label><select name="sourceType" class="form-select form-select-sm" data-excel-source-select><option value="Manual" selected="@(table.SourceType == CustomTeamTableSourceTypes.Manual)">Manual entry</option><option value="ExcelUrl" selected="@table.IsDirectExcelUrl">Excel download link</option><option value="MicrosoftGraphExcel" selected="@table.IsMicrosoftGraphExcel">SharePoint / OneDrive</option><option value="UploadedExcel" selected="@table.IsUploadedExcel">Upload from this computer</option></select></div>
                                <div class="col-md-2"><button class="btn btn-sm btn-outline-primary w-100" type="submit">Save table</button></div>
                                <div class="col-12" data-excel-backed><div class="alert alert-warning py-2 mb-1">Imported workbook data is stored in Team Hub. Use Access Management to assign the users who may view or edit this tab.</div></div>
                                <div class="col-12" data-source-types="ExcelUrl MicrosoftGraphExcel"><label class="form-label">Workbook link</label><input name="sourceUrl" class="form-control form-control-sm" type="url" maxlength="2048" value="@((table.IsDirectExcelUrl || table.IsMicrosoftGraphExcel) ? table.SourceUrl : null)" placeholder="https://..." required /><div class="form-text">For SharePoint or OneDrive, paste the complete browser or Copy link. For an Excel download source, enter a direct workbook URL.</div></div>
                                <div class="col-12" data-source-types="MicrosoftGraphExcel"><div class="alert alert-secondary mb-0">TeamHub resolves this link through Microsoft Graph using the configured application identity. No Drive ID or Item ID is required.</div></div>
                                <div class="col-md-6" data-source-types="UploadedExcel">
                                    <input type="hidden" name="sourceUrl" value="@(table.IsUploadedExcel ? table.SourceUrl : null)" />
                                    <input type="hidden" name="sourceDisplayName" value="@(table.IsUploadedExcel ? table.SourceDisplayName : null)" />
                                    <label class="form-label">Replace uploaded workbook</label><input name="sourceFile" class="form-control form-control-sm" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" /><div class="form-text">Current file: @(table.IsUploadedExcel ? table.SourceDisplayName ?? "Uploaded workbook" : "No workbook uploaded")</div>
                                </div>
                                <div class="col-md-3" data-excel-backed><label class="form-label">Worksheet <span class="text-secondary">(optional)</span></label><input name="sourceWorksheet" class="form-control form-control-sm" maxlength="200" value="@table.SourceWorksheet" /></div>
                                <div class="col-md-3" data-excel-backed><label class="form-label">Header row</label><input name="sourceHeaderRow" class="form-control form-control-sm" type="number" min="1" max="1000" value="@table.SourceHeaderRow" /></div>
                                <div class="col-md-6" data-excel-backed>
                                    <label class="form-label">Primary key column</label>
                                    <select name="primaryKeySourceHeader" class="form-select form-select-sm" disabled="@(sourceColumns.Count == 0 || table.LastSyncedAtUtc.HasValue)">
                                        <option value="">@(sourceColumns.Count == 0 ? "Import the Excel schema first" : "Select a primary-key header")</option>
                                        @foreach (var sourceColumn in sourceColumns)
                                        {
                                            <option value="@sourceColumn.SourceHeader" selected="@(string.Equals(sourceColumn.SourceHeader, table.PrimaryKeySourceHeader, StringComparison.OrdinalIgnoreCase))">@sourceColumn.SourceHeader</option>
                                        }
                                    </select>
                                    @if (table.LastSyncedAtUtc.HasValue)
                                    {
                                        <input type="hidden" name="primaryKeySourceHeader" value="@table.PrimaryKeySourceHeader" />
                                    }
                                </div>
                                <div class="col-md-6" data-excel-backed><div class="form-text">The primary key is locked after the first successful sync. SharePoint/OneDrive synchronization uses Team Hub's configured Microsoft Graph application identity.</div></div>
                                <div class="col-12" data-source-types="ExcelUrl MicrosoftGraphExcel"><button class="btn btn-sm btn-outline-primary" type="submit" asp-page-handler="TestCustomTableSource" data-test-excel-source>Test workbook</button></div>
                                <div class="col-12 alert mb-0" data-excel-source-test-result hidden></div>
                            </form>
                            @if (table.IsExcelBacked)
                            {
                                <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                                    <form method="post" asp-page-handler="ImportCustomTableSchema">
                                        <input type="hidden" name="tabId" value="@selectedTab.Id" /><input type="hidden" name="tableId" value="@table.Id" />
                                        <button class="btn btn-sm btn-outline-primary" type="submit">Import schema from Excel</button>
                                    </form>
                                    <form method="post" asp-page-handler="SyncCustomTable">
                                        <input type="hidden" name="tabId" value="@selectedTab.Id" /><input type="hidden" name="tableId" value="@table.Id" />
                                        <button class="btn btn-sm btn-success" type="submit" disabled="@(sourceColumns.Count == 0 || string.IsNullOrWhiteSpace(table.PrimaryKeySourceHeader))">Synchronize Excel rows</button>
                                    </form>
                                    @if (table.LastSyncedAtUtc.HasValue)
                                    {
                                        <span class="small text-secondary">Last sync @table.LastSyncedAtUtc.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt") - @table.LastSyncMessage</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(table.LastSyncMessage))
                                    {
                                        <span class="small text-danger">@table.LastSyncMessage</span>
                                    }
                                </div>
                            }
                            <form method="post" asp-page-handler="ArchiveCustomTable" class="mt-2" onsubmit="return confirm('Archive this table?')">
                                <input type="hidden" name="tabId" value="@selectedTab.Id" /><input type="hidden" name="tableId" value="@table.Id" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Archive table</button>
                            </form>
                        </div>
                        @if (table.Columns.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table styled-table align-middle mb-0">
                                    <thead><tr><th>Column</th><th>Type</th><th>Required</th><th>Origin</th><th>Options</th><th></th></tr></thead>
                                    <tbody>
                                    @foreach (var column in table.Columns)
                                    {
                                        var columnFormId = $"column-{column.Id}";
                                        <tr class="@(column.IsSourceColumn ? "table-light" : "")">
                                            <td>
                                                <form id="@columnFormId" method="post" asp-page-handler="SaveCustomColumn">
                                                    <input type="hidden" name="tabId" value="@selectedTab.Id" /><input type="hidden" name="tableId" value="@table.Id" /><input type="hidden" name="columnId" value="@column.Id" />
                                                    <input name="label" class="form-control form-control-sm" maxlength="80" value="@column.Label" required />
                                                    <input name="displayOrder" class="form-control form-control-sm mt-1" type="number" min="0" value="@column.DisplayOrder" aria-label="Display order" />
                                                </form>
                                                @if (column.IsSourceColumn)
                                                {
                                                    <small class="d-block text-secondary mt-1">Excel header: @column.SourceHeader</small>
                                                }
                                                else
                                                {
                                                    <small class="d-block text-secondary mt-1">@column.Key</small>
                                                }
                                            </td>
                                            <td><select name="fieldType" form="@columnFormId" class="form-select form-select-sm">@foreach (var fieldType in Model.CustomFieldTypes) { <option value="@fieldType" selected="@(fieldType == column.FieldType)">@fieldType</option> }</select></td>
                                            <td><div class="form-check"><input class="form-check-input" type="checkbox" name="isRequired" value="true" form="@columnFormId" id="required-@column.Id" checked="@column.IsRequired" /><label class="form-check-label" for="required-@column.Id">Required</label></div></td>
                                            <td>
                                                <span class="badge @(column.IsSourceColumn ? "text-bg-secondary" : "text-bg-success")">@(column.IsSourceColumn ? "Excel" : "Team Hub")</span>
                                                @if (column.IsPrimaryKey) { <span class="badge text-bg-primary ms-1">Primary key</span> }
                                            </td>
                                            <td><textarea name="options" form="@columnFormId" class="form-control form-control-sm" rows="2" placeholder="Required for Choice type">@string.Join(", ", column.Options)</textarea></td>
                                            <td class="text-nowrap">
                                                <button class="btn btn-sm btn-outline-primary" type="submit" form="@columnFormId">Save</button>
                                                @if (!column.IsSourceColumn)
                                                {
                                                    <form method="post" asp-page-handler="ArchiveCustomColumn" class="d-inline" onsubmit="return confirm('Archive this column?')"><input type="hidden" name="tabId" value="@selectedTab.Id" /><input type="hidden" name="columnId" value="@column.Id" /><button class="btn btn-sm btn-outline-danger" type="submit">Archive</button></form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                        <form method="post" asp-page-handler="SaveCustomColumn" class="section-body bg-light-subtle">
                            <input type="hidden" name="tabId" value="@selectedTab.Id" /><input type="hidden" name="tableId" value="@table.Id" />
                            <h3 class="h6">@(table.IsExcelBacked ? "Add Team Hub column" : "Add column")</h3>
                            @if (table.IsExcelBacked)
                            {
                                <p class="small text-secondary">This column is stored in Team Hub and remains editable after Excel synchronization.</p>
                            }
                            <div class="row g-2">
                                <div class="col-md-4"><label class="form-label">Column label</label><input name="label" class="form-control form-control-sm" maxlength="80" required /></div>
                                <div class="col-md-3"><label class="form-label">Type</label><select name="fieldType" class="form-select form-select-sm">@foreach (var fieldType in Model.CustomFieldTypes) { <option value="@fieldType">@fieldType</option> }</select></div>
                                <div class="col-md-2"><label class="form-label">Order</label><input name="displayOrder" class="form-control form-control-sm" type="number" min="0" value="@table.Columns.Count" /></div>
                                <div class="col-md-3 d-flex align-items-end"><div class="form-check mb-1"><input class="form-check-input" type="checkbox" name="isRequired" value="true" id="required-@table.Id" /><label class="form-check-label" for="required-@table.Id">Required</label></div></div>
                                <div class="col-12"><label class="form-label">Choice options <span class="text-secondary">(comma or line separated)</span></label><textarea name="options" class="form-control form-control-sm" rows="2"></textarea></div>
                            </div>
                            <button class="btn btn-sm btn-primary mt-3" type="submit">Add Team Hub Column</button>
                        </form>
                    </section>
                }
            }
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-appearance-row]').forEach(row => {
            const style = row.querySelector('[data-appearance-style]');
            const preview = row.querySelector('[data-appearance-preview]');
            const refresh = () => {
                preview.classList.toggle('configured-text-bold', style.value === 'Bold' || style.value === 'BoldItalic');
                preview.classList.toggle('configured-text-italic', style.value === 'Italic' || style.value === 'BoldItalic');
            };
            style.addEventListener('change', refresh);
            refresh();
        });

        document.querySelectorAll('[data-excel-source-form]').forEach(form => {
            const button = form.querySelector('[data-test-excel-source]');
            const source = form.querySelector('[data-excel-source-select]');
            const result = form.querySelector('[data-excel-source-test-result]');
            const refresh = () => {
                const sourceType = source?.value || 'Manual';
                const excelBacked = sourceType !== 'Manual';
                form.querySelectorAll('[data-excel-backed]').forEach(block => {
                    block.hidden = !excelBacked;
                    block.querySelectorAll('input, select, textarea, button').forEach(control => control.disabled = !excelBacked);
                });
                form.querySelectorAll('[data-source-types]').forEach(block => {
                    const visible = block.dataset.sourceTypes.split(' ').includes(sourceType);
                    block.hidden = !visible;
                    block.querySelectorAll('input, select, textarea, button').forEach(control => control.disabled = !visible);
                });
                const testable = sourceType === 'ExcelUrl' || sourceType === 'MicrosoftGraphExcel';
                if (!testable && result) result.hidden = true;
            };
            source?.addEventListener('change', refresh);
            refresh();

            if (!button) return;
            button.addEventListener('click', async event => {
                event.preventDefault();
                result.hidden = false;
                result.className = 'col-12 alert alert-info mb-0';
                result.textContent = 'Testing workbook access and content...';
                button.disabled = true;
                try {
                    const response = await fetch(button.formAction, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const payload = await response.json();
                    result.className = `col-12 alert ${payload.success ? 'alert-success' : 'alert-danger'} mb-0`;
                    result.textContent = payload.message;
                } catch {
                    result.className = 'col-12 alert alert-danger mb-0';
                    result.textContent = 'Workbook test failed because TeamHub could not complete the request.';
                } finally {
                    button.disabled = false;
                }
            });
        });
    </script>
}
