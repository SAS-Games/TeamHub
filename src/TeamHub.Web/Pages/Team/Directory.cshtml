@page "/Team/Directory"
@model TeamHub.Web.Pages.Team.DirectoryModel
@{
    ViewData["Title"] = "Team Directory";
    ViewData["TeamTab"] = "Directory";
}

<div class="page-hero">
    <div>
        <h1>Team Directory</h1>
        <p>Roles, responsibilities, and contact info for everyone on the project.</p>
    </div>
</div>
<partial name="_TeamNav" />

@foreach (var memberSection in Model.MemberSections)
{
    <section class="content-section">
        <div class="section-heading">
            <div><span>Directory</span><h2>@memberSection.Title</h2></div>
            <strong>@memberSection.Members.Count configured</strong>
        </div>
        @if (memberSection.Members.Count == 0)
        {
            <div class="p-4 text-secondary">No @memberSection.Title.ToLowerInvariant() have been configured yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table styled-table">
                    <thead>
                        <tr>
                            <th class="@Model.Appearance.CssClass("employee-name")">Employee Name</th>
                            <th class="@Model.Appearance.CssClass("role")">Role</th>
                            <th class="@Model.Appearance.CssClass("gid")">GID</th>
                            <th class="@Model.Appearance.CssClass("email")">Email</th>
                            <th class="@Model.Appearance.CssClass("contact-number")">Contact Number</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var member in memberSection.Members)
                    {
                        <tr>
                            <td class="@Model.Appearance.CssClass("employee-name")">@member.EmployeeName</td>
                            <td class="@Model.Appearance.CssClass("role")">@member.Role</td>
                            <td class="@Model.Appearance.CssClass("gid")">@member.Gid</td>
                            <td class="@Model.Appearance.CssClass("email")"><a href="mailto:@member.Email">@member.Email</a></td>
                            <td class="@Model.Appearance.CssClass("contact-number")">@member.ContactNumber</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
