@page
@model TeamHub.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<h1 class="mb-4">Workflow System Login</h1>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" class="card p-4" style="max-width: 420px;">
    <div class="mb-3">
        <label asp-for="Input.Username" class="form-label">Username</label>
        <input asp-for="Input.Username" class="form-control" autocomplete="username" required />
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Password</label>
        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" required />
    </div>
    <button type="submit" class="btn btn-primary">Sign in</button>
</form>
