@page
@model TeamHub.Web.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="container py-4">
    <div class="card p-4 mx-auto" style="max-width: 480px;">
        <div class="eyebrow">Account recovery</div>
        <h1 class="h2 mb-2">Choose a new password</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert @(Model.Success ? "alert-success" : "alert-danger")">@Model.Message</div>
        }
        @if (Model.Success)
        {
            <a class="btn btn-primary" asp-page="/Login">Continue to sign in</a>
        }
        else if (Model.IsValid)
        {
            <p class="text-secondary">Enter a new password with at least eight characters.</p>
            <form method="post">
                <input asp-for="Token" type="hidden" />
                <div class="mb-3"><label asp-for="Password" class="form-label">New password</label><input asp-for="Password" class="form-control" type="password" minlength="8" autocomplete="new-password" required /></div>
                <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" type="password" minlength="8" autocomplete="new-password" required /></div>
                <button class="btn btn-primary" type="submit">Reset password</button>
            </form>
        }
        else
        {
            <a class="btn btn-primary" asp-page="/ForgotPassword">Request another reset link</a>
        }
    </div>
</div>
