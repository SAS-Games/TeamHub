@page "/Administration/Users"
@model TeamHub.Web.Pages.Administration.UsersModel
@{
    ViewData["Title"] = "Authorized Users";
}

<div class="page-hero">
    <div>
        <div class="eyebrow">Admin Portal</div>
        <h1>Authorized Users</h1>
        <p>Control exactly who can register or sign in, their TeamHub user type, and whether access is active.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Configuration/Index">Admin Portal</a>
        <a class="btn btn-outline-primary" asp-page="/Administration/Access">Access Matrix</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-4">
    <div class="col-12 col-xl-4">
        <section class="content-section h-100 m-0">
            <div class="section-heading"><div><span>@(Model.Input.Id.HasValue ? "Update" : "Authorize")</span><h2>@(Model.Input.Id.HasValue ? "Edit User" : "Add User")</h2></div></div>
            <div class="section-body">
                <form method="post" asp-page-handler="Save">
                    <input type="hidden" asp-for="Input.Id" />
                    <div class="mb-3"><label class="form-label" asp-for="Input.UserId">Organization email / User ID</label><input class="form-control" asp-for="Input.UserId" maxlength="256" required /></div>
                    <div class="mb-3"><label class="form-label" asp-for="Input.DisplayName">Display name</label><input class="form-control" asp-for="Input.DisplayName" maxlength="256" required /></div>
                    <div class="mb-3"><label class="form-label" asp-for="Input.UserType">User type</label><select class="form-select" asp-for="Input.UserType">@foreach (var type in Model.UserTypes) { <option value="@type">@type</option> }</select></div>
                    <div class="mb-3"><label class="form-label" asp-for="Input.TemporaryPassword">Temporary password</label><input class="form-control" asp-for="Input.TemporaryPassword" type="password" minlength="8" autocomplete="new-password" /><div class="form-text">Optional. Registered users can self-register. Set this for an Admin or as a local fallback for a Privileged user.</div></div>
                    <div class="form-check mb-3"><input class="form-check-input" asp-for="Input.IsActive" /><label class="form-check-label" asp-for="Input.IsActive">Active</label></div>
                    <button class="btn btn-primary" type="submit">@(Model.Input.Id.HasValue ? "Save Changes" : "Add Authorized User")</button>
                    @if (Model.Input.Id.HasValue) { <a class="btn btn-link" asp-page="/Administration/Users">Cancel</a> }
                </form>
            </div>
        </section>
    </div>
    <div class="col-12 col-xl-8">
        <section class="content-section h-100 m-0">
            <div class="section-heading"><div><span>Admin managed</span><h2>Authorized User List</h2></div></div>
            <div class="table-responsive">
                <table class="table styled-table align-middle">
                    <thead><tr><th>User</th><th>Type</th><th>Registration</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                    @foreach (var user in Model.AuthorizedUsers)
                    {
                        <tr>
                            <td><strong>@user.DisplayName</strong><div class="small text-secondary">@user.UserId</div></td>
                            <td><span class="badge text-bg-light">@user.UserType</span></td>
                            <td>@(user.IsRegistered ? "Ready to sign in" : user.UserType == TeamHub.Authentication.TeamHubUserTypes.Registered ? "Awaiting registration" : "Organization sign-in")</td>
                            <td><span class="badge @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/Administration/Users" asp-route-editId="@user.Id">Edit</a>
                                    <form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@user.Id" /><input type="hidden" name="active" value="@(!user.IsActive)" /><button class="btn btn-sm btn-outline-secondary" type="submit">@(user.IsActive ? "Deactivate" : "Activate")</button></form>
                                    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Remove this user from TeamHub?');"><input type="hidden" name="id" value="@user.Id" /><button class="btn btn-sm btn-outline-danger" type="submit">Remove</button></form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
