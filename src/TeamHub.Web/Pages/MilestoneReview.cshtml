@page "/MilestoneReview"
@model TeamHub.Web.Pages.MilestoneReviewModel
@{
    ViewData["Title"] = "Milestone Review";
}

<div class="page-hero">
    <div>
        <div class="eyebrow">Build feedback</div>
        <h1>Milestone Review</h1>
        <p>Share milestone feedback with the team. Review entries are visible to all users with page access.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success mt-3">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger mt-3">@Model.ErrorMessage</div>
}
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

@if (Model.IsAdmin)
{
    @if (Model.EditingReview is not null)
    {
        <section class="content-section">
            <div class="section-heading"><div><span>Edit review</span><h2>Milestone Details</h2></div></div>
            <form method="post" asp-page-handler="Edit" asp-route-editReviewId="@Model.EditingReview.Id" class="section-body">
                <input type="hidden" asp-for="ReviewId" />
                <partial name="_MilestoneReviewDetails" model="Model" />
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-page="/MilestoneReview" asp-route-selectedReviewId="@Model.EditingReview.Id"
                       asp-route-editReviewId="" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </section>
    }
    @if (Model.Draft is null && Model.EditingReview is null)
    {
        <button class="btn btn-outline-primary mb-3" type="button" data-bs-toggle="collapse"
                data-bs-target="#create-milestone-review" aria-expanded="false" aria-controls="create-milestone-review">
            Create New Milestone Review
        </button>
        <div class="collapse @(!ViewData.ModelState.IsValid ? "show" : "")" id="create-milestone-review">
            <section class="content-section">
            <div class="section-heading"><div><span>New review</span><h2>Milestone Details</h2></div></div>
            <form method="post" asp-page-handler="CreateDraft" class="section-body">
                <partial name="_MilestoneReviewDetails" model="Model" />
                <button type="submit" class="btn btn-primary mt-3">Create Draft</button>
            </form>
            </section>
        </div>
    }
    else if (Model.Draft is not null && Model.EditingReview is null)
    {
        <section class="content-section">
            <div class="section-heading"><div><span>Not visible to reviewers yet</span><h2>Draft: @Model.Draft.ProjectName — @Model.Draft.MilestoneName</h2></div></div>
            <div class="section-body">
                <safe-markdown class="markdown-content mb-2" text="@Model.Draft.Description"></safe-markdown>
                <p><strong>Feedback contributors:</strong> @string.Join(", ", Model.Draft.AssignedReviewers.Select(item => $"{item.DisplayName} ({item.UserId})"))</p>
                @if (!string.IsNullOrWhiteSpace(Model.Draft.JiraTicketId))
                {
                    <p><strong>Jira ticket:</strong> @Model.Draft.JiraTicketId</p>
                }
                <p><strong>Workflow template:</strong> @(Model.WorkflowOptions.FirstOrDefault(option => string.Equals(option.Key, Model.Draft.WorkflowKey, StringComparison.OrdinalIgnoreCase))?.Name ?? Model.Draft.WorkflowKey ?? "Not selected")</p>
                <form method="post" class="d-inline">
                    <button asp-page-handler="Publish" type="submit" class="btn btn-primary">Publish Review</button>
                </form>
                <a asp-page="/MilestoneReview" asp-route-editReviewId="@Model.Draft.Id" class="btn btn-outline-primary">Edit Review</a>
                <form method="post" class="d-inline" onsubmit="return confirm('Discard this unpublished draft?')">
                    <button asp-page-handler="DiscardDraft" type="submit" class="btn btn-outline-danger">Discard Draft</button>
                </form>
            </div>
        </section>
    }
}

@if (Model.ActiveReviews.Count > 1)
{
    <section class="content-section mb-4">
        <div class="section-heading">
            <div><span>In progress</span><h2>Active Reviews</h2></div>
            <small class="text-secondary">@Model.ActiveReviews.Count reviews</small>
        </div>
        <div class="section-body d-flex flex-wrap gap-2">
            @foreach (var review in Model.ActiveReviews)
            {
                <a asp-page="/MilestoneReview" asp-route-selectedReviewId="@review.Id"
                   class="btn @(review.Id == Model.CurrentReview?.Id ? "btn-primary" : "btn-outline-primary")">
                    @review.ProjectName — @review.MilestoneName
                </a>
            }
        </div>
    </section>
}

@if (Model.CurrentReview is null)
{
    <section class="content-section"><div class="section-body text-secondary">There are no active milestone reviews yet.</div></section>
}
else
{
    <section class="content-section">
        <div class="section-heading">
            <div>
                <span>@Model.CurrentReview.ProjectName</span>
                <h2>@Model.CurrentReview.MilestoneName</h2>
                @if (!string.IsNullOrWhiteSpace(Model.CurrentReview.JiraTicketId))
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-secondary">Jira ticket: @Model.CurrentReview.JiraTicketId</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-jira-comments
                                data-ticket-id="@Model.CurrentReview.JiraTicketId"
                                data-modal-title="@Model.CurrentReview.ProjectName — @Model.CurrentReview.MilestoneName"
                                data-comments-url="@Url.Page("/MilestoneReview", "Comments", new { ticketId = Model.CurrentReview.JiraTicketId })">
                            Show Jira Comments
                        </button>
                    </div>
                }
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <small class="text-secondary">Published @Model.CurrentReview.PublishedAt?.ToLocalTime().ToString("g")</small>
                @if (Model.IsAdmin)
                {
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentReview.JiraTicketId))
                    {
                        <form method="post" asp-page-handler="PreviewRestore">
                            <input type="hidden" name="ReviewId" value="@Model.CurrentReview.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Restore feedback from Jira</button>
                        </form>
                    }
                    <a asp-page="/MilestoneReview" asp-route-selectedReviewId="@Model.CurrentReview.Id"
                       asp-route-editReviewId="@Model.CurrentReview.Id"
                       class="btn btn-sm btn-outline-primary">Edit Review</a>
                    <form method="post" asp-page-handler="Archive"
                          onsubmit="return confirm('Archive this review? Feedback will be preserved in Review History and can no longer be edited.')">
                        <input type="hidden" name="ReviewId" value="@Model.CurrentReview.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Archive Review</button>
                    </form>
                    <form method="post" asp-page-handler="Delete"
                          onsubmit="return confirm('Permanently delete this review and all its saved feedback from TeamHub? This cannot be undone. Jira comments will not be deleted.')">
                        <input type="hidden" name="ReviewId" value="@Model.CurrentReview.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete Review</button>
                    </form>
                }
            </div>
        </div>
            @if (Model.IsAdmin && Model.ShowRestorePreview)
            {
                <div class="section-body border-bottom">
                    <h3 class="h5">Restore feedback preview</h3>
                    <p>Select one comment per reviewer. Only empty rows can be restored. Comments must contain a TeamHub feedback identifier and matching reviewer email; other Jira comments are not imported. This does not change Jira comments. The preview expires after 15 minutes.</p>
                    @foreach (var warning in Model.RestoreWarnings)
                    {
                        <div class="alert alert-warning">@warning</div>
                    }
                    @if (Model.RestorePreview.Count > 0)
                    {
                        <form method="post" asp-page-handler="Restore">
                            <input type="hidden" name="ReviewId" value="@Model.CurrentReview.Id" />
                            @{
                                var groups = Model.RestorePreview.GroupBy(item => item.Email).ToList();
                            }
                            @for (var index = 0; index < groups.Count; index++)
                            {
                                var group = groups[index];
                                <fieldset class="border rounded p-3 mb-3">
                                    <legend class="float-none w-auto h6">@group.First().Reviewer (@group.Key)</legend>
                                    <label class="d-block mb-2"><input type="radio" name="RestoreSelections[@index]" value="" checked /> Do not restore this reviewer</label>
                                    @foreach (var candidate in group)
                                    {
                                        <div class="border-top pt-2 mt-2">
                                            <label><input type="radio" name="RestoreSelections[@index]" value="@candidate.Token" /> Comment @candidate.CommentId — @candidate.Created.ToLocalTime().ToString("g")</label>
                                            <div class="row g-3 mt-1">
                                                <div class="col-md-6"><h4 class="h6">Session Details</h4><safe-markdown text="@candidate.SessionDetails"></safe-markdown></div>
                                                <div class="col-md-6"><h4 class="h6">What's Good</h4><safe-markdown text="@candidate.WhatGood"></safe-markdown></div>
                                                <div class="col-md-6"><h4 class="h6">Needs Improvement</h4><safe-markdown text="@candidate.NeedImprovements"></safe-markdown></div>
                                                <div class="col-md-6"><h4 class="h6">Additional Feedback</h4><safe-markdown text="@candidate.AdditionalFeedback"></safe-markdown></div>
                                            </div>
                                        </div>
                                    }
                                </fieldset>
                            }
                            <button class="btn btn-primary" type="submit">Confirm Restore</button>
                            <a asp-page="/MilestoneReview" asp-route-selectedReviewId="@Model.CurrentReview.Id" class="btn btn-outline-secondary">Cancel</a>
                        </form>
                    }
                    else
                    {
                        <p>No feedback is available to restore.</p>
                    }
                </div>
            }
        @if (!string.IsNullOrWhiteSpace(Model.CurrentReview.Description))
        {
            <div class="section-body border-bottom">
                <safe-markdown class="markdown-content" text="@Model.CurrentReview.Description"></safe-markdown>
            </div>
        }
        <div class="section-body border-bottom">
            <p class="small text-secondary mb-0">Feedback sections support Markdown. Select Edit to update your feedback; saved formatting appears in these boxes.</p>
            <partial name="_MarkdownHelp" />
        </div>
        <div class="milestone-feedback-list">
            @foreach (var feedback in Model.CurrentReview.Feedback)
            {
                var canEdit = Model.CanEdit(feedback);
                var isEditing = Model.IsEditingFeedback(feedback);
                var isOwnFeedback = Model.CurrentUserId == feedback.ReviewerId;
                var hasFeedback = !string.IsNullOrWhiteSpace(feedback.SessionDetails)
                    || !string.IsNullOrWhiteSpace(feedback.WhatGood)
                    || !string.IsNullOrWhiteSpace(feedback.NeedImprovements)
                    || !string.IsNullOrWhiteSpace(feedback.AdditionalFeedback);
                var feedbackId = $"feedback-{feedback.Id}";
                var sessionFieldId = $"{feedbackId}-session";
                var goodFieldId = $"{feedbackId}-good";
                var improvementsFieldId = $"{feedbackId}-improvements";
                var additionalFieldId = $"{feedbackId}-additional";
                <details class="milestone-feedback-item" open="@(isEditing || isOwnFeedback ? "open" : null)">
                    <summary class="milestone-feedback-summary">
                        <span class="milestone-feedback-reviewer">
                            <strong>@feedback.Reviewer</strong>
                            @if (isOwnFeedback)
                            {
                                <span class="badge text-bg-primary">Your feedback</span>
                            }
                        </span>
                        <span class="milestone-feedback-summary-meta">
                            @if (!string.IsNullOrWhiteSpace(feedback.JiraSyncError))
                            {
                                <span class="text-danger" title="@feedback.JiraSyncError">Jira sync pending</span>
                            }
                            <span>@(hasFeedback ? "Feedback added" : "Awaiting feedback")</span>
                        </span>
                    </summary>
                    @if (isEditing)
                    {
                        <form method="post" asp-page-handler="SaveFeedback" class="milestone-feedback-body">
                            <input type="hidden" name="ReviewId" value="@Model.CurrentReview.Id" />
                            <input type="hidden" name="FeedbackId" value="@feedback.Id" />
                            <input type="hidden" name="Version" value="@feedback.Version" />
                            <div class="milestone-feedback-actions">
                                <button type="submit" class="btn btn-sm btn-primary" aria-label="Save feedback for @feedback.Reviewer">Save</button>
                                <a asp-page="/MilestoneReview" asp-route-selectedReviewId="@Model.CurrentReview.Id" class="btn btn-sm btn-outline-secondary" aria-label="Cancel editing feedback for @feedback.Reviewer">Cancel</a>
                            </div>
                            <div class="milestone-feedback-grid">
                                <div>
                                    <label class="form-label" for="@sessionFieldId">Session Details</label>
                                    <div class="form-text mb-2">Platform, duration, and levels or areas explored.</div>
                                    <textarea id="@sessionFieldId" name="SessionDetails" class="form-control" rows="5" maxlength="20000" placeholder="e.g. PC, 1 hour, levels 1-3">@feedback.SessionDetails</textarea>
                                </div>
                                <div>
                                    <label class="form-label" for="@goodFieldId">What's Good</label>
                                    <div class="form-text mb-2">Aspects enjoyed or found effective during play.</div>
                                    <textarea id="@goodFieldId" name="WhatGood" class="form-control" rows="5" maxlength="20000" placeholder="What did you enjoy or find effective?">@feedback.WhatGood</textarea>
                                </div>
                                <div>
                                    <label class="form-label" for="@improvementsFieldId">Needs Improvement</label>
                                    <div class="form-text mb-2">Elements that need refinement, fixing, or felt frustrating.</div>
                                    <textarea id="@improvementsFieldId" name="NeedImprovements" class="form-control" rows="5" maxlength="20000" placeholder="What needs refinement or fixing, or felt frustrating?">@feedback.NeedImprovements</textarea>
                                </div>
                                <div>
                                    <label class="form-label" for="@additionalFieldId">Additional Feedback</label>
                                    <div class="form-text mb-2">Feature or discipline-specific notes, if any.</div>
                                    <textarea id="@additionalFieldId" name="AdditionalFeedback" class="form-control" rows="5" maxlength="20000" placeholder="Optional feature or discipline-specific notes">@feedback.AdditionalFeedback</textarea>
                                </div>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="milestone-feedback-body">
                            @if (canEdit)
                            {
                                <div class="milestone-feedback-actions">
                                    <a asp-page="/MilestoneReview" asp-route-selectedReviewId="@Model.CurrentReview.Id" asp-route-editFeedbackId="@feedback.Id" class="btn btn-sm btn-outline-secondary" aria-label="Edit feedback for @feedback.Reviewer">Edit</a>
                                </div>
                            }
                            <div class="milestone-feedback-grid">
                                <section>
                                    <h3>Session Details</h3>
                                    <safe-markdown class="milestone-review-text markdown-content" text="@(string.IsNullOrWhiteSpace(feedback.SessionDetails) ? "No feedback provided." : feedback.SessionDetails)"></safe-markdown>
                                </section>
                                <section>
                                    <h3>What's Good</h3>
                                    <safe-markdown class="milestone-review-text markdown-content" text="@(string.IsNullOrWhiteSpace(feedback.WhatGood) ? "No feedback provided." : feedback.WhatGood)"></safe-markdown>
                                </section>
                                <section>
                                    <h3>Needs Improvement</h3>
                                    <safe-markdown class="milestone-review-text markdown-content" text="@(string.IsNullOrWhiteSpace(feedback.NeedImprovements) ? "No feedback provided." : feedback.NeedImprovements)"></safe-markdown>
                                </section>
                                <section>
                                    <h3>Additional Feedback</h3>
                                    <safe-markdown class="milestone-review-text markdown-content" text="@(string.IsNullOrWhiteSpace(feedback.AdditionalFeedback) ? "No feedback provided." : feedback.AdditionalFeedback)"></safe-markdown>
                                </section>
                            </div>
                        </div>
                    }
                </details>
            }
        </div>
    </section>
}

<section class="content-section mt-4">
    <div class="section-heading">
        <div>
            <span>Archive</span>
            <h2>Review History</h2>
        </div>
        <small class="text-secondary">@Model.HistoryReviews.Count past review@(Model.HistoryReviews.Count == 1 ? "" : "s")</small>
    </div>
    @if (Model.HistoryReviews.Count == 0)
    {
        <div class="section-body text-secondary">No previous milestone reviews archived yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table styled-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Project</th>
                        <th>Milestone</th>
                        <th>Published</th>
                        <th>Jira Ticket</th>
                        <th>Contributors</th>
                        <th class="text-end">Feedback</th>
                        @if (Model.IsAdmin)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var pastReview in Model.HistoryReviews)
                {
                    <tr>
                        <td><strong>@pastReview.ProjectName</strong></td>
                        <td>
                            <div>@pastReview.MilestoneName</div>
                            @if (!string.IsNullOrWhiteSpace(pastReview.Description))
                            {
                                <safe-markdown class="markdown-content small text-secondary" style="max-width: 360px;" text="@pastReview.Description"></safe-markdown>
                            }
                        </td>
                        <td class="text-nowrap">@(pastReview.PublishedAt.HasValue ? pastReview.PublishedAt.Value.ToLocalTime().ToString("g") : "-")</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(pastReview.JiraTicketId))
                            {
                                <span class="badge bg-light text-dark border">@pastReview.JiraTicketId</span>
                            }
                            else
                            {
                                <span class="text-secondary">-</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-secondary border">@pastReview.Feedback.Count contributor@(pastReview.Feedback.Count == 1 ? "" : "s")</span>
                        </td>
                        <td class="text-end">
                            @if (!string.IsNullOrWhiteSpace(pastReview.JiraTicketId))
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-jira-comments
                                        data-ticket-id="@pastReview.JiraTicketId"
                                        data-modal-title="@pastReview.ProjectName — @pastReview.MilestoneName"
                                        data-comments-url="@Url.Page("/MilestoneReview", "Comments", new { ticketId = pastReview.JiraTicketId })">
                                    Show Provided Feedback
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-jira-comments
                                        data-modal-title="@pastReview.ProjectName — @pastReview.MilestoneName"
                                        data-comments-url="@Url.Page("/MilestoneReview", "Feedback", new { reviewId = pastReview.Id })">
                                    Show Provided Feedback
                                </button>
                            }
                        </td>
                        @if (Model.IsAdmin)
                        {
                            <td class="text-end">
                                <form method="post" asp-page-handler="Delete"
                                      onsubmit="return confirm('Permanently delete this archived review and all its saved feedback from TeamHub? This cannot be undone. Jira comments will not be deleted.')">
                                    <input type="hidden" name="ReviewId" value="@pastReview.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete Review</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<partial name="_JiraCommentsModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const project = document.querySelector('[data-milestone-review-project]');
            const description = document.querySelector('[data-milestone-review-description]');
            const milestone = document.querySelector('[data-milestone-review-milestone]');
            if (!project || !milestone || !description) return;

            const matches = (value, selected) =>
                (value || '').localeCompare(selected || '', undefined, { sensitivity: 'accent' }) === 0;
            const updateDescriptions = () => {
                let selectedOption = null;
                for (const option of description.options) {
                    if (!option.dataset.project) continue;
                    const available = matches(option.dataset.project, project.value);
                    option.hidden = !available;
                    option.disabled = !available;
                    if (available && option.selected) selectedOption = option;
                }
                if (!selectedOption) description.value = '';
                updateMilestone();
            };
            const updateMilestone = () => {
                const selected = description.options[description.selectedIndex];
                milestone.value = selected?.dataset.milestone || '';
            };

            project.addEventListener('change', updateDescriptions);
            description.addEventListener('change', updateMilestone);
            updateDescriptions();
        })();
    </script>
    <script src="~/js/jira-comments.js" asp-append-version="true"></script>
}
