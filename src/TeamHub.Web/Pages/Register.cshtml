@page
@model TeamHub.Web.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container py-4">
    <div class="card p-4 mx-auto" style="max-width: 480px;">
        <div class="eyebrow">Authorized users only</div>
        <h1 class="h2 mb-2">Register for TeamHub</h1>
        <p class="text-secondary">Your organization email or user ID must already be on the Admin-managed Authorized User List.</p>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert @(Model.Success ? "alert-success" : "alert-danger")">@Model.Message</div>
        }

        @if (!Model.Success)
        {
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.UserId" class="form-label">Organization email / User ID</label>
                    <input asp-for="Input.UserId" class="form-control" autocomplete="username" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" minlength="8" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" minlength="8" required />
                </div>
                <button class="btn btn-primary" type="submit">Register</button>
                <a class="btn btn-link" asp-page="/Login">Back to sign in</a>
            </form>
        }
        else
        {
            <a class="btn btn-primary" asp-page="/Login">Continue to sign in</a>
        }
    </div>
</div>
