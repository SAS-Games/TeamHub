@page "/Studio/WeeklyUpdates"
@model TeamHub.Web.Pages.Studio.WeeklyUpdatesModel
@{
    var title = Model.Studio is null ? "Weekly Studio Updates" : $"{Model.Studio.StudioName} Weekly Updates";
    ViewData["Title"] = title;
}

<div class="page-hero">
    <div><div class="eyebrow">Studio Support</div><h1>@title</h1></div>
    @if (Model.Studio is not null)
    {
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" asp-page="/Studio/JiraTickets" asp-route-studioId="@Model.Studio.Id">Jira Tickets</a>
            <a class="btn btn-primary" asp-page="/Studio/WeeklyUpdates" asp-route-studioId="@Model.Studio.Id">Weekly Updates</a>
            <a class="btn btn-outline-secondary" asp-page="/Studio/Index" asp-route-studioId="@Model.Studio.Id">Back to Dashboard</a>
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-info mt-3">@Model.ErrorMessage</div>
}
else if (Model.Studio is not null)
{
    <section class="content-section">
        <div class="section-heading"><div><span>Filters</span><h2>Confluence Week Range</h2></div></div>
        <div class="section-body">
            <form method="get" class="row g-3 align-items-end">
                <input type="hidden" asp-for="StudioId" value="@Model.Studio.Id" />
                <div class="col-md-4"><label asp-for="StartDate" class="form-label">Start Date</label><input asp-for="StartDate" type="date" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="EndDate" class="form-label">End Date</label><input asp-for="EndDate" type="date" class="form-control" /></div>
                <div class="col-md-4"><button type="submit" class="btn btn-primary">Load Weekly Updates</button></div>
            </form>
        </div>
    </section>

    <div class="alert alert-secondary small">Weekly Updates is read only in this release. Page IDs and Confluence versions are retained so controlled editing can be added later.</div>

    @if (!string.IsNullOrWhiteSpace(Model.UpdateResult.Message))
    {
        <div class="alert @(Model.UpdateResult.IsConfigured ? "alert-warning" : "alert-info")">@Model.UpdateResult.Message</div>
        @if (Model.UpdateResult.Message.Contains("token", StringComparison.OrdinalIgnoreCase))
        {
            <p><a class="btn btn-outline-primary" asp-page="/Profile/Atlassian">Open My Atlassian Connection</a></p>
        }
    }

    @if (Model.UpdateResult.IsUsingSharedCredential)
    {
        <div class="alert alert-secondary small">Shared Confluence access is read only. Weekly page changes are not permitted from TeamHub.</div>
    }

    @foreach (var update in Model.UpdateResult.Updates)
    {
        <section class="content-section">
            <div class="section-heading">
                <div><span>@update.WeekStart.ToString("dd MMM yyyy") – @update.WeekEnd.ToString("dd MMM yyyy")</span><h2>@update.PageTitle</h2></div>
                @if (!string.IsNullOrWhiteSpace(update.PageUrl))
                {
                    <a class="btn btn-sm btn-outline-secondary" href="@update.PageUrl" target="_blank" rel="noopener">Open in Confluence</a>
                }
            </div>
            @if (!update.PageFound || !update.StudioFound)
            {
                <div class="section-body text-secondary">@update.Message</div>
            }
            else
            {
                <div class="section-body">
                    <div class="row g-3">
                        <div class="col-12 col-lg-6"><div class="border rounded-3 p-3 h-100"><h3 class="h6">Studio Work</h3><div class="text-break" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(update.StudioWork) ? "No information provided." : update.StudioWork)</div></div></div>
                        <div class="col-12 col-lg-6"><div class="border rounded-3 p-3 h-100"><h3 class="h6">HPGDS Support</h3><div class="text-break" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(update.HpgdsSupport) ? "No information provided." : update.HpgdsSupport)</div></div></div>
                        <div class="col-12 col-lg-6"><div class="border rounded-3 p-3 h-100"><h3 class="h6">WMD Support</h3><div class="text-break" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(update.WmdSupport) ? "No information provided." : update.WmdSupport)</div></div></div>
                        <div class="col-12 col-lg-6"><div class="border rounded-3 p-3 h-100"><h3 class="h6">Action Items</h3><div class="text-break" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(update.ActionItems) ? "No information provided." : update.ActionItems)</div></div></div>
                        <div class="col-12"><div class="border rounded-3 p-3"><h3 class="h6">Notes</h3><div class="text-break" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(update.Notes) ? "No notes provided." : update.Notes)</div></div></div>
                    </div>
                </div>
            }
        </section>
    }
}
