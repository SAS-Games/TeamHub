@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    var content = Model.HomeContent;
}

<div class="home-hero mb-4" style="background-image: url('@content.BackgroundImage');">
    <div class="home-hero-overlay p-4 p-md-5">
        <div class="eyebrow">@content.Eyebrow</div>
        <h1 class="display-5">@content.ProjectName</h1>
        <p class="lead mb-0">@content.Tagline</p>
    </div>
</div>

<section class="content-section">
    <div class="section-heading">
        <div><span>@content.VisionMissionKicker</span><h2>@content.VisionMissionTitle</h2></div>
    </div>
    <div class="section-body row g-4">
        <div class="col-md-6">
            <h3 class="h6">@content.VisionLabel</h3>
            <safe-markdown class="markdown-content mb-0" text="@content.Vision"></safe-markdown>
        </div>
        <div class="col-md-6">
            <h3 class="h6">@content.MissionLabel</h3>
            <safe-markdown class="markdown-content mb-0" text="@content.Mission"></safe-markdown>
        </div>
    </div>
</section>

<section class="content-section">
    <div class="section-heading">
        <div><span>@content.AboutKicker</span><h2>@content.AboutTitle</h2></div>
    </div>
    <div class="section-body">
        <safe-markdown class="markdown-content mb-0" text="@content.Description"></safe-markdown>
    </div>
</section>

@if (content.Highlights.Count > 0)
{
    <section class="content-section">
        <div class="section-heading">
            <div><span>@content.HighlightsKicker</span><h2>@content.HighlightsTitle</h2></div>
        </div>
        <div class="section-body row g-3">
            @foreach (var highlight in content.Highlights)
            {
                <div class="col-md-4">
                    <h3 class="h6">@highlight.Title</h3>
                    <safe-markdown class="markdown-content mb-0 small text-muted" text="@highlight.Detail"></safe-markdown>
                </div>
            }
        </div>
    </section>
}

@if (Model.CanViewUsefulLinks && content.UsefulLinks.Count > 0)
{
    <section class="content-section">
        <div class="section-heading">
            <div><span>@content.UsefulLinksKicker</span><h2>@content.UsefulLinksTitle</h2></div>
        </div>
        <div class="section-body row g-3">
            @foreach (var link in content.UsefulLinks)
            {
                <div class="col-md-4">
                    <h3 class="h6"><a href="@link.Url" target="_blank" rel="noopener">@link.Label</a></h3>
                    <safe-markdown class="markdown-content mb-0 small text-muted" text="@link.Description"></safe-markdown>
                </div>
            }
        </div>
    </section>
}

