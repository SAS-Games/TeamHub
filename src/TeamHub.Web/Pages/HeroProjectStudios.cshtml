@page "/HeroProjectStudios"
@model TeamHub.Web.Pages.HeroProjectStudiosModel
@using TeamHub.Authentication
@using TeamHub.Web.AccessControl
@inject ICurrentAccessService CurrentAccess
@{
    ViewData["Title"] = "Hero Project Studios";
    var canOpenStudio = User.Identity?.IsAuthenticated == true
        && await CurrentAccess.CanAsync(TeamHubModules.StudioConfiguration);
}

<div class="page-hero">
    <div>
        <div class="eyebrow">Studio portfolio</div>
        <h1>Hero Project Studios</h1>
        <p>Games and release information across active and released studios.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning mt-3">@Model.ErrorMessage</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Model.MilestoneWarning))
    {
        <div class="alert alert-warning mt-3">@Model.MilestoneWarning</div>
    }

    @if (Model.Studios.Count == 0)
    {
        <div class="alert alert-info mt-3">No studios have been configured yet.</div>
    }
    else
    {
        <section class="content-section">
            <div class="table-responsive">
                <table class="table styled-table align-middle hero-project-studios-table mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Game &amp; Studio</th>
                            <th scope="col">About the Game</th>
                            <th scope="col">Release Date</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Studios)
                    {
                        var studio = item.Studio;
                        var logoUrl = string.IsNullOrWhiteSpace(studio.LogoFileName)
                            ? Url.Content("~/images/teamhub-logo.svg")
                            : Url.Content($"~/studio-logos/{studio.LogoFileName}");
                        <tr>
                            <td class="hero-project-studio-identity-cell">
                                <div class="hero-project-studio-identity">
                                    <img class="hero-project-studio-logo" src="@logoUrl" alt="@studio.StudioName logo" />
                                    <strong class="hero-project-game-name">@(string.IsNullOrWhiteSpace(studio.ProjectName) ? "-" : studio.ProjectName)</strong>
                                    <span class="hero-project-studio-name">@studio.StudioName</span>
                                    @if (canOpenStudio)
                                    {
                                        <a class="btn btn-sm hero-project-studio-status @(studio.IsActive ? "btn-success" : "btn-secondary")"
                                           asp-page="/Studio/Index"
                                           asp-route-studioId="@studio.Id"
                                           aria-label="Open @studio.StudioName studio page">@(studio.IsActive ? "Active" : "Released")</a>
                                    }
                                    else
                                    {
                                        <span class="badge @(studio.IsActive ? "text-bg-success" : "text-bg-secondary")">@(studio.IsActive ? "Active" : "Released")</span>
                                    }
                                </div>
                            </td>
                            <td class="hero-project-studio-details">
                                <safe-markdown class="markdown-content hero-project-about-markdown" text="@(string.IsNullOrWhiteSpace(studio.AboutGame) ? "-" : studio.AboutGame)"></safe-markdown>
                            </td>
                            <td class="text-nowrap">@(item.ReleaseDate?.ToString("dd MMM yyyy") ?? "-")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
}
