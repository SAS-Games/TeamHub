@page "/WorkCenter/Configuration"
@model TeamHub.Web.Pages.WorkCenter.ConfigurationModel
@{
    ViewData["Title"] = "Configuration";
    ViewData["WorkCenterTab"] = "Configuration";
}

<div class="page-hero">
    <div>
        <div class="eyebrow">Work Center</div>
        <h1>Configuration</h1>
        <p>Design task dependencies visually, configure ownership and timing, then publish the workflow.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Configuration/Index">All Configuration</a>
        <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#createVisualWorkflow" aria-expanded="false">Create Workflow</button>
    </div>
</div>
<partial name="_WorkCenterNav" />

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info mt-3">@Model.StatusMessage</div>
}

@if (!Model.ShowForm)
{
    <section class="content-section">
        <div class="collapse" id="createVisualWorkflow">
            <form method="post" asp-page-handler="CreateVisual" class="section-body row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label" for="visualWorkflowName">Workflow name</label>
                    <input class="form-control" id="visualWorkflowName" name="name" maxlength="200" required placeholder="For example, Employee onboarding" />
                </div>
                <div class="col-md-4"><button class="btn btn-primary w-100" type="submit">Create in Flow Designer</button></div>
            </form>
            @if (Model.WorkCenterTemplates.Count > 0)
            {
                <div class="section-body pt-0">
                    <div class="small fw-semibold mb-2">Start from a stored template</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var template in Model.WorkCenterTemplates)
                        {
                            <form method="post" asp-page-handler="CreateFromTemplate" asp-route-templateId="@template.Id">
                                <button class="btn btn-outline-primary" type="submit">Use @template.Name</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="section-heading"><div><span>Visual authoring</span><h2>Work Center Workflows</h2></div></div>
        @if (Model.VisualWorkflows.Count == 0)
        {
            <div class="section-body text-secondary">No visual workflows yet. Create one, add Start, Task, and End nodes, then publish it.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table styled-table align-middle">
                    <thead><tr><th>Name</th><th>Symbols</th><th>Saved version</th><th>Updated</th><th>Actions</th></tr></thead>
                    <tbody>
                    @foreach (var workflow in Model.VisualWorkflows)
                    {
                        <tr>
                            <td><strong>@workflow.Name</strong><div class="small text-secondary">@workflow.Description</div></td>
                            <td>@workflow.NodeCount</td>
                            <td>@workflow.Version</td>
                            <td>@workflow.UpdatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="studio-actions">
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Flows/Edit" asp-route-id="@workflow.Id">Design</a>
                                <form method="post" asp-page-handler="DuplicateVisual" asp-route-id="@workflow.Id" class="d-inline"><button class="btn btn-sm btn-outline-secondary" type="submit">Duplicate</button></form>
                                <form method="post" asp-page-handler="DeleteVisual" asp-route-id="@workflow.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (Model.Drafts.Count > 0)
    {
    <section class="content-section">
        <div class="section-heading"><div><span>Legacy editor</span><h2>Table-based Drafts</h2></div></div>
        <div class="table-responsive">
            <table class="table styled-table">
                <thead><tr><th>Workflow Key</th><th>Name</th><th>Steps</th><th>Updated</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var draft in Model.Drafts)
                {
                    <tr>
                        <td>@draft.WorkflowKey</td>
                        <td>@draft.WorkflowName</td>
                        <td>@draft.StepCount</td>
                        <td>@draft.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="studio-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/WorkCenter/Configuration" asp-route-draftId="@draft.Id">Edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-draftId="@draft.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
    }

    <section class="content-section">
        <div class="section-heading"><div><span>Published</span><h2>Active Workflows</h2></div></div>
        <div class="table-responsive">
            <table class="table styled-table">
                <thead><tr><th>Workflow Key</th><th>Name</th><th>Version</th><th>Enabled</th><th>Published</th></tr></thead>
                <tbody>
                @foreach (var definition in Model.PublishedDefinitions)
                {
                    <tr>
                        <td>@definition.WorkflowKey</td>
                        <td>@definition.Name</td>
                        <td>@definition.Version</td>
                        <td>@definition.Enabled</td>
                        <td>@definition.ImportedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.ShowForm)
{
    <section class="content-section">
        <div class="section-heading"><div><span>@(Model.Input.Id.HasValue ? "Edit draft" : "New draft")</span><h2>Workflow Details</h2></div></div>
        <div class="section-body">
            <form method="post">
                <input type="hidden" asp-for="Input.Id" />
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label asp-for="Input.WorkflowKey" class="form-label">Workflow Key</label>
                        <input asp-for="Input.WorkflowKey" class="form-control" />
                        <span asp-validation-for="Input.WorkflowKey" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.WorkflowName" class="form-label">Workflow Name</label>
                        <input asp-for="Input.WorkflowName" class="form-control" />
                        <span asp-validation-for="Input.WorkflowName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.Description" class="form-label">Description</label>
                        <input asp-for="Input.Description" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Enabled</label>
                        <div class="form-check mt-2"><input asp-for="Input.Enabled" class="form-check-input" /><label asp-for="Input.Enabled" class="form-check-label">Enabled</label></div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                    <h3 class="h6 mb-0">Workflow Steps</h3>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-add-row>Add Step</button>
                </div>
                <div class="table-responsive mb-4">
                    <table class="table styled-table align-middle">
                        <thead><tr><th>Step Key</th><th>Name</th><th>Owner</th><th>Hours</th><th>Depends On</th><th>Flags</th><th>Actions</th></tr></thead>
                        <tbody data-steps data-prefix="Input.Steps">
                        @for (var index = 0; index < Model.Input.Steps.Count; index++)
                        {
                            <tr data-row>
                                <td><input asp-for="Input.Steps[index].StepKey" class="form-control" data-field="StepKey" /></td>
                                <td>
                                    <input asp-for="Input.Steps[index].StepName" class="form-control mb-2" data-field="StepName" />
                                    <textarea asp-for="Input.Steps[index].Description" class="form-control" rows="2" data-field="Description" placeholder="Description"></textarea>
                                </td>
                                <td>
                                    <input asp-for="Input.Steps[index].Owner" class="form-control mb-2" data-field="Owner" />
                                    <input asp-for="Input.Steps[index].OwnerType" class="form-control" data-field="OwnerType" />
                                </td>
                                <td>
                                    <input asp-for="Input.Steps[index].ExpectedDurationHours" type="number" min="0" step="0.5" class="form-control" data-field="ExpectedDurationHours" />
                                    <input asp-for="Input.Steps[index].ReminderAfterHours" type="number" min="0" step="0.5" class="form-control mt-2" data-field="ReminderAfterHours" placeholder="Reminder" />
                                </td>
                                <td><input asp-for="Input.Steps[index].DependsOnCsv" class="form-control" data-field="DependsOnCsv" placeholder="STEP_A, STEP_B" /></td>
                                <td>
                                    <input asp-for="Input.Steps[index].SortOrder" type="hidden" data-field="SortOrder" />
                                    <input asp-for="Input.Steps[index].EscalationAfterHours" type="hidden" data-field="EscalationAfterHours" />
                                    <input asp-for="Input.Steps[index].EscalationOwner" type="hidden" data-field="EscalationOwner" />
                                    <div class="form-check"><input asp-for="Input.Steps[index].Required" class="form-check-input" data-field="Required" /><label asp-for="Input.Steps[index].Required" class="form-check-label">Required</label></div>
                                    <div class="form-check"><input asp-for="Input.Steps[index].Enabled" class="form-check-input" data-field="Enabled" /><label asp-for="Input.Steps[index].Enabled" class="form-check-label">Enabled</label></div>
                                </td>
                                <td class="studio-actions">
                                    <input asp-for="Input.Steps[index].Remove" type="hidden" value="false" data-field="Remove" />
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <button type="submit" asp-page-handler="Save" class="btn btn-outline-primary">Save Draft</button>
                <button type="submit" asp-page-handler="Publish" class="btn btn-primary">Publish</button>
                <a class="btn btn-outline-secondary" asp-page="/WorkCenter/Configuration">Cancel</a>
            </form>
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const setName = (field, prefix, index) => {
                field.name = `${prefix}[${index}].${field.dataset.field}`;
                field.id = `${prefix}_${index}__${field.dataset.field}`.replaceAll(".", "_");
            };

            const reindex = (body) => {
                const prefix = body.dataset.prefix;
                body.querySelectorAll("tr[data-row]").forEach((row, index) => {
                    row.querySelectorAll("[data-field]").forEach((field) => setName(field, prefix, index));
                    const sortOrder = row.querySelector("[data-field='SortOrder']");
                    if (sortOrder && !sortOrder.value) {
                        sortOrder.value = index + 1;
                    }
                });
            };

            const makeInput = (prefix, index, field, options = {}) => {
                const element = document.createElement(options.multiline ? "textarea" : "input");
                element.className = options.checkbox ? "form-check-input" : "form-control";
                element.dataset.field = field;
                if (options.type) {
                    element.type = options.type;
                }
                if (options.placeholder) {
                    element.placeholder = options.placeholder;
                }
                if (options.value !== undefined) {
                    element.value = options.value;
                }
                if (options.checked) {
                    element.checked = true;
                }
                if (options.multiline) {
                    element.rows = 2;
                }
                setName(element, prefix, index);
                return element;
            };

            const addStep = () => {
                const body = document.querySelector("tbody[data-steps]");
                const prefix = body.dataset.prefix;
                const index = body.querySelectorAll("tr[data-row]").length;
                const row = document.createElement("tr");
                row.dataset.row = "";
                row.innerHTML = `<td></td><td></td><td></td><td></td><td></td><td></td><td class="studio-actions"></td>`;
                row.children[0].append(makeInput(prefix, index, "StepKey"));
                row.children[1].append(makeInput(prefix, index, "StepName"), makeInput(prefix, index, "Description", { multiline: true, placeholder: "Description" }));
                row.children[2].append(makeInput(prefix, index, "Owner"), makeInput(prefix, index, "OwnerType", { value: "Email" }));
                row.children[3].append(makeInput(prefix, index, "ExpectedDurationHours", { type: "number", value: "0" }), makeInput(prefix, index, "ReminderAfterHours", { type: "number", placeholder: "Reminder" }));
                row.children[4].append(makeInput(prefix, index, "DependsOnCsv", { placeholder: "STEP_A, STEP_B" }));
                row.children[5].append(makeInput(prefix, index, "SortOrder", { type: "hidden", value: `${index + 1}` }), makeInput(prefix, index, "EscalationAfterHours", { type: "hidden" }), makeInput(prefix, index, "EscalationOwner", { type: "hidden" }), makeInput(prefix, index, "Required", { type: "checkbox", checkbox: true, checked: true }), makeInput(prefix, index, "Enabled", { type: "checkbox", checkbox: true, checked: true }));
                row.children[6].append(makeInput(prefix, index, "Remove", { type: "hidden", value: "false" }));
                row.children[6].insertAdjacentHTML("beforeend", `<button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button>`);
                body.append(row);
            };

            document.addEventListener("click", (event) => {
                if (event.target.closest("[data-add-row]")) {
                    addStep();
                    return;
                }

                const removeButton = event.target.closest("[data-remove-row]");
                if (removeButton) {
                    const body = removeButton.closest("tbody[data-steps]");
                    removeButton.closest("tr[data-row]")?.remove();
                    reindex(body);
                }
            });
        })();
    </script>
}
