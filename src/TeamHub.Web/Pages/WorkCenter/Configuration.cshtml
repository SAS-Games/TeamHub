@page "/WorkCenter/Configuration"
@model TeamHub.Web.Pages.WorkCenter.ConfigurationModel
@{
    ViewData["Title"] = "Workflow Library";
    ViewData["WorkCenterTab"] = "Configuration";
}

<div class="page-hero">
    <div>
        <div class="eyebrow">Work Center</div>
        <h1>Workflow Library</h1>
        <p>Create reusable workflow designs, publish runtime versions, and control which workflows can be started.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Configuration/Index">All Configuration</a>
        <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#createVisualWorkflow" aria-expanded="false">Create Workflow</button>
    </div>
</div>
<partial name="_WorkCenterNav" />

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info mt-3">@Model.StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger mt-3"><strong>Publication failed.</strong> @Model.ErrorMessage</div>
}

@if (!Model.ShowForm)
{
    <section class="content-section">
        <div class="collapse" id="createVisualWorkflow">
            <form method="post" asp-page-handler="CreateVisual" class="section-body row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label" for="visualWorkflowName">Workflow name</label>
                    <input class="form-control" id="visualWorkflowName" name="name" maxlength="200" required placeholder="For example, Employee onboarding" />
                </div>
                <div class="col-md-4"><button class="btn btn-primary w-100" type="submit">Create in Flow Designer</button></div>
            </form>
            @if (Model.WorkCenterTemplates.Count > 0)
            {
                <div class="section-body pt-0">
                    <div class="small fw-semibold mb-2">Start from a stored template</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var template in Model.WorkCenterTemplates)
                        {
                            <form method="post" asp-page-handler="CreateFromTemplate" asp-route-templateId="@template.Id">
                                <button class="btn btn-outline-primary" type="submit">Use @template.Name</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="section-heading"><div><span>Visual authoring</span><h2>Work Center Workflows</h2></div></div>

        <div class="section-body border-bottom">
            <strong>How this works:</strong> design and save a workflow here, then select
            <strong>Publish &amp; make available</strong>. Templates are reusable starting points only and never appear in Start New by themselves.
        </div>
        @if (Model.VisualWorkflows.Count == 0)
        {
            <div class="section-body text-secondary">No visual workflows yet. Create one, add Start, Task, and End nodes, then publish it.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table styled-table align-middle">
                    <thead><tr><th>Name</th><th>Symbols</th><th>Saved version</th><th>Updated</th><th>Actions</th></tr></thead>
                    <tbody>
                    @foreach (var workflow in Model.VisualWorkflows)
                    {
                        <tr>
                            <td><strong>@workflow.Name</strong><div class="small text-secondary">@workflow.Description</div></td>
                            <td>@workflow.NodeCount</td>
                            <td>@workflow.Version</td>
                            <td>@workflow.UpdatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="studio-actions">
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Flows/Edit" asp-route-id="@workflow.Id">Design</a>
                                <form method="post" asp-page-handler="PublishVisual" asp-route-id="@workflow.Id" class="d-inline"><button class="btn btn-sm btn-success" type="submit">Publish &amp; make available</button></form>
                                <form method="post" asp-page-handler="DuplicateVisual" asp-route-id="@workflow.Id" class="d-inline"><button class="btn btn-sm btn-outline-secondary" type="submit">Duplicate</button></form>
                                <form method="post" asp-page-handler="DeleteVisual" asp-route-id="@workflow.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (Model.Drafts.Count > 0)
    {
    <section class="content-section">
        <div class="section-heading"><div><span>Legacy editor</span><h2>Table-based Drafts</h2></div></div>
        <div class="table-responsive">
            <table class="table styled-table">
                <thead><tr><th>Workflow Key</th><th>Name</th><th>Steps</th><th>Updated</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var draft in Model.Drafts)
                {
                    <tr>
                        <td>@draft.WorkflowKey</td>
                        <td>@draft.WorkflowName</td>
                        <td>@draft.StepCount</td>
                        <td>@draft.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="studio-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/WorkCenter/Configuration" asp-route-draftId="@draft.Id">Edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-draftId="@draft.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
    }

    <section class="content-section">
        <div class="section-heading"><div><span>Runtime definitions</span><h2>Published Workflows</h2></div></div>
        @if (Model.PublishedDefinitions.Count == 0)
        {
            <div class="section-body text-secondary">No workflows have been published yet. Publish a saved visual workflow to make it available in Start New.</div>
        }
        else
        {
            <div class="table-responsive">
            <table class="table styled-table">
                <thead><tr><th>Workflow Key</th><th>Name</th><th>Version</th><th>Availability</th><th>Published (UTC)</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var definition in Model.PublishedDefinitions)
                {
                    <tr>
                        <td>@definition.WorkflowKey</td>
                        <td>@definition.Name</td>
                        <td>@definition.Version</td>

                        <td>
                            @if (definition.Enabled)
                            {
                                <span class="badge text-bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Starts paused</span>
                            }
                        </td>
                        <td>@definition.ImportedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="studio-actions">
                            @if (definition.Enabled)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-page="/WorkCenter/StartNew" asp-route-workflowKey="@definition.WorkflowKey">Start</a>
                                <form method="post" asp-page-handler="SetAvailability" asp-route-definitionId="@definition.Id" asp-route-enabled="false" class="d-inline">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Pause starts</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="SetAvailability" asp-route-definitionId="@definition.Id" asp-route-enabled="true" class="d-inline">
                                    <button class="btn btn-sm btn-outline-success" type="submit">Resume starts</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        }
    </section>
}

@if (Model.ShowForm)
{
    <section class="content-section">
        <div class="section-heading"><div><span>@(Model.Input.Id.HasValue ? "Edit draft" : "New draft")</span><h2>Workflow Details</h2></div></div>
        <div class="section-body">
            <form method="post">
                <input type="hidden" asp-for="Input.Id" />
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label asp-for="Input.WorkflowKey" class="form-label">Workflow Key</label>
                        <input asp-for="Input.WorkflowKey" class="form-control" />
                        <span asp-validation-for="Input.WorkflowKey" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.WorkflowName" class="form-label">Workflow Name</label>
                        <input asp-for="Input.WorkflowName" class="form-control" />
                        <span asp-validation-for="Input.WorkflowName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.Description" class="form-label">Description</label>
                        <input asp-for="Input.Description" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Enabled</label>
                        <div class="form-check mt-2"><input asp-for="Input.Enabled" class="form-check-input" /><label asp-for="Input.Enabled" class="form-check-label">Enabled</label></div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                    <h3 class="h6 mb-0">Workflow Steps</h3>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-add-row>Add Step</button>
                </div>
                <div class="form-text mb-2">Optional step email templates support <code>{InstanceName}</code>, <code>{InstanceDescription}</code>, <code>{WorkflowName}</code>, <code>{WorkflowKey}</code>, <code>{StepName}</code>, <code>{StepDescription}</code>, <code>{Recipient}</code>, <code>{Assignee}</code>, <code>{DueDate}</code>, <code>{DueHours}</code>, <code>{EscalationLevel}</code>, <code>{OutstandingAssignees}</code>, and top-level workflow metadata keys.</div>
                <div class="table-responsive mb-4">
                    <table class="table styled-table align-middle">
                        <thead><tr><th>Task ID (generated)</th><th>Name</th><th>Owner</th><th>Due date</th><th>Depends On</th><th>Escalations</th><th>Flags</th><th>Actions</th></tr></thead>
                        <tbody data-steps data-prefix="Input.Steps">
                        @for (var index = 0; index < Model.Input.Steps.Count; index++)
                        {
                            <tr data-row>
                                <td><input asp-for="Input.Steps[index].StepKey" class="form-control" data-field="StepKey" readonly tabindex="-1" /></td>
                                <td>
                                    <input asp-for="Input.Steps[index].StepName" class="form-control mb-2" data-field="StepName" />
                                    <textarea asp-for="Input.Steps[index].Description" class="form-control" rows="2" data-field="Description" placeholder="Description"></textarea>
                                </td>
                                <td>
                                    <input asp-for="Input.Steps[index].Owner" class="form-control" data-field="Owner" list="registeredWorkflowEmails" placeholder="email1@example.com; email2@example.com" />
                                    <input asp-for="Input.Steps[index].OwnerType" type="hidden" value="Email" data-field="OwnerType" />
                                    <div class="form-text">Select a registered email or enter valid emails separated by semicolons.</div>
                                </td>
                                <td>
                                    <input type="date" class="form-control" data-due-date aria-label="Due date" />
                                    <label class="form-label small mt-2">Due hours</label>
                                    <input asp-for="Input.Steps[index].ExpectedDurationHours" type="number" min="0.5" step="0.5" class="form-control" data-field="ExpectedDurationHours" />
                                    <div class="form-text">The date calculates due hours. You can adjust the hours directly; each run uses that duration from task start.</div>
                                    <input asp-for="Input.Steps[index].ReminderAfterHours" type="number" min="0" step="0.5" class="form-control mt-2" data-field="ReminderAfterHours" placeholder="Reminder" />
                                </td>
                                <td><input asp-for="Input.Steps[index].DependsOnCsv" class="form-control" data-field="DependsOnCsv" placeholder="STEP_A, STEP_B" /></td>
                                <td>
                                    <input asp-for="Input.Steps[index].EscalationAfterHours" type="number" min="0" step="0.5" class="form-control" data-field="EscalationAfterHours" placeholder="Level 1 hours" />
                                    <input asp-for="Input.Steps[index].EscalationOwner" class="form-control mt-1" data-field="EscalationOwner" list="registeredWorkflowEmails" placeholder="Level 1 emails" />
                                    <input asp-for="Input.Steps[index].EscalationLevel2AfterHours" type="number" min="0" step="0.5" class="form-control mt-2" data-field="EscalationLevel2AfterHours" placeholder="Level 2 hours" />
                                    <input asp-for="Input.Steps[index].EscalationLevel2Owners" class="form-control mt-1" data-field="EscalationLevel2Owners" list="registeredWorkflowEmails" placeholder="Level 2 emails" />
                                    <input asp-for="Input.Steps[index].EscalationLevel3AfterHours" type="number" min="0" step="0.5" class="form-control mt-2" data-field="EscalationLevel3AfterHours" placeholder="Level 3 hours" />
                                    <input asp-for="Input.Steps[index].EscalationLevel3Owners" class="form-control mt-1" data-field="EscalationLevel3Owners" list="registeredWorkflowEmails" placeholder="Level 3 emails" />
                                    <div class="form-text">Hours after due date; separate emails with semicolons.</div>
                                    <details class="mt-2">
                                        <summary>Email content</summary>
                                        <input asp-for="Input.Steps[index].ReminderSubjectTemplate" class="form-control mt-2" data-field="ReminderSubjectTemplate" maxlength="1000" placeholder="Reminder subject" />
                                        <textarea asp-for="Input.Steps[index].ReminderBodyTemplate" class="form-control mt-1" data-field="ReminderBodyTemplate" rows="2" placeholder="Reminder body"></textarea>
                                        <input asp-for="Input.Steps[index].OverdueSubjectTemplate" class="form-control mt-2" data-field="OverdueSubjectTemplate" maxlength="1000" placeholder="Overdue subject" />
                                        <textarea asp-for="Input.Steps[index].OverdueBodyTemplate" class="form-control mt-1" data-field="OverdueBodyTemplate" rows="2" placeholder="Overdue body"></textarea>
                                        <input asp-for="Input.Steps[index].EscalationSubjectTemplate" class="form-control mt-2" data-field="EscalationSubjectTemplate" maxlength="1000" placeholder="Escalation subject" />
                                        <textarea asp-for="Input.Steps[index].EscalationBodyTemplate" class="form-control mt-1" data-field="EscalationBodyTemplate" rows="2" placeholder="Escalation body"></textarea>
                                    </details>
                                </td>
                                <td>
                                    <input asp-for="Input.Steps[index].SortOrder" type="hidden" data-field="SortOrder" />
                                    <div class="form-check"><input asp-for="Input.Steps[index].Required" class="form-check-input" data-field="Required" /><label asp-for="Input.Steps[index].Required" class="form-check-label">Required</label></div>
                                    <div class="form-check"><input asp-for="Input.Steps[index].Enabled" class="form-check-input" data-field="Enabled" /><label asp-for="Input.Steps[index].Enabled" class="form-check-label">Enabled</label></div>
                                </td>
                                <td class="studio-actions">
                                    <input asp-for="Input.Steps[index].Remove" type="hidden" value="false" data-field="Remove" />
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <datalist id="registeredWorkflowEmails"></datalist>

                <button type="submit" asp-page-handler="Save" class="btn btn-outline-primary">Save Draft</button>
                <button type="submit" asp-page-handler="Publish" class="btn btn-primary">Publish</button>
                <a class="btn btn-outline-secondary" asp-page="/WorkCenter/Configuration">Cancel</a>
            </form>
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const setName = (field, prefix, index) => {
                field.name = `${prefix}[${index}].${field.dataset.field}`;
                field.id = `${prefix}_${index}__${field.dataset.field}`.replaceAll(".", "_");
            };

            const reindex = (body) => {
                const prefix = body.dataset.prefix;
                body.querySelectorAll("tr[data-row]").forEach((row, index) => {
                    row.querySelectorAll("[data-field]").forEach((field) => setName(field, prefix, index));
                    const sortOrder = row.querySelector("[data-field='SortOrder']");
                    if (sortOrder && !sortOrder.value) {
                        sortOrder.value = index + 1;
                    }
                });
            };

            const makeInput = (prefix, index, field, options = {}) => {
                const element = document.createElement(options.multiline ? "textarea" : "input");
                element.className = options.checkbox ? "form-check-input" : "form-control";
                element.dataset.field = field;
                if (options.type) {
                    element.type = options.type;
                }
                if (options.placeholder) {
                    element.placeholder = options.placeholder;
                }
                if (options.value !== undefined) {
                    element.value = options.value;
                }
                if (options.checked) {
                    element.checked = true;
                }
                if (options.multiline) {
                    element.rows = 2;
                }
                setName(element, prefix, index);
                return element;
            };

            const addStep = () => {
                const body = document.querySelector("tbody[data-steps]");
                const prefix = body.dataset.prefix;
                const index = body.querySelectorAll("tr[data-row]").length;
                const row = document.createElement("tr");
                row.dataset.row = "";
                row.innerHTML = `<td></td><td></td><td></td><td></td><td></td><td></td><td></td><td class="studio-actions"></td>`;
                const stepKey = makeInput(prefix, index, "StepKey");
                stepKey.readOnly = true;
                stepKey.tabIndex = -1;
                row.children[0].append(stepKey);
                row.children[1].append(makeInput(prefix, index, "StepName"), makeInput(prefix, index, "Description", { multiline: true, placeholder: "Description" }));
                const owner = makeInput(prefix, index, "Owner", { placeholder: "email1@example.com; email2@example.com" });
                owner.setAttribute("list", "registeredWorkflowEmails");
                row.children[2].append(owner, makeInput(prefix, index, "OwnerType", { type: "hidden", value: "Email" }));
                row.children[2].insertAdjacentHTML("beforeend", "<div class=\"form-text\">Select or enter valid emails separated by semicolons.</div>");
                const dueDate = document.createElement("input");
                dueDate.type = "date";
                dueDate.className = "form-control";
                dueDate.dataset.dueDate = "";
                dueDate.setAttribute("aria-label", "Due date");
                dueDate.min = dateFromHours(0);
                const dueHours = makeInput(prefix, index, "ExpectedDurationHours", { type: "number", value: "24" });
                dueHours.min = "0.5";
                dueHours.step = "0.5";
                dueHours.classList.add("mt-2");
                dueHours.setAttribute("aria-label", "Due hours");
                const reminder = makeInput(prefix, index, "ReminderAfterHours", { type: "number", placeholder: "Reminder" });
                reminder.classList.add("mt-2");
                row.children[3].append(dueDate, dueHours, reminder);
                row.children[4].append(makeInput(prefix, index, "DependsOnCsv", { placeholder: "STEP_A, STEP_B" }));
                row.children[5].append(makeInput(prefix, index, "EscalationAfterHours", { type: "number", placeholder: "Level 1 hours" }), makeInput(prefix, index, "EscalationOwner", { placeholder: "Level 1 emails" }), makeInput(prefix, index, "EscalationLevel2AfterHours", { type: "number", placeholder: "Level 2 hours" }), makeInput(prefix, index, "EscalationLevel2Owners", { placeholder: "Level 2 emails" }), makeInput(prefix, index, "EscalationLevel3AfterHours", { type: "number", placeholder: "Level 3 hours" }), makeInput(prefix, index, "EscalationLevel3Owners", { placeholder: "Level 3 emails" }));
                row.children[5].querySelectorAll("input:not([type='number'])").forEach(input => input.setAttribute("list", "registeredWorkflowEmails"));
                const emailTemplates = document.createElement("details");
                emailTemplates.className = "mt-2";
                emailTemplates.innerHTML = "<summary>Email content</summary>";
                emailTemplates.append(
                    makeInput(prefix, index, "ReminderSubjectTemplate", { placeholder: "Reminder subject" }),
                    makeInput(prefix, index, "ReminderBodyTemplate", { multiline: true, placeholder: "Reminder body" }),
                    makeInput(prefix, index, "OverdueSubjectTemplate", { placeholder: "Overdue subject" }),
                    makeInput(prefix, index, "OverdueBodyTemplate", { multiline: true, placeholder: "Overdue body" }),
                    makeInput(prefix, index, "EscalationSubjectTemplate", { placeholder: "Escalation subject" }),
                    makeInput(prefix, index, "EscalationBodyTemplate", { multiline: true, placeholder: "Escalation body" }));
                emailTemplates.querySelectorAll("input, textarea").forEach((field, fieldIndex) => field.classList.add(fieldIndex === 0 ? "mt-2" : "mt-1"));
                row.children[5].append(emailTemplates);
                row.children[6].append(makeInput(prefix, index, "SortOrder", { type: "hidden", value: `${index + 1}` }), makeInput(prefix, index, "Required", { type: "checkbox", checkbox: true, checked: true }), makeInput(prefix, index, "Enabled", { type: "checkbox", checkbox: true, checked: true }));
                row.children[7].append(makeInput(prefix, index, "Remove", { type: "hidden", value: "false" }));
                row.children[7].insertAdjacentHTML("beforeend", `<button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button>`);
                body.append(row);
                dueDate.value = dateFromHours(24);
            };

            document.addEventListener("click", (event) => {
                if (event.target.closest("[data-add-row]")) {
                    addStep();
                    return;
                }

                const removeButton = event.target.closest("[data-remove-row]");
                if (removeButton) {
                    const body = removeButton.closest("tbody[data-steps]");
                    removeButton.closest("tr[data-row]")?.remove();
                    reindex(body);
                }
            });

            const toTaskId = (name) => name.trim().toUpperCase().replace(/[^A-Z0-9]+/g, "_").replace(/^_+|_+$/g, "");
            const dateFromHours = (hours) => {
                const date = new Date(Date.now() + Number(hours || 0) * 3600000);
                return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
            };
            const hoursUntilEndOfDate = (value) => {
                if (!value) return null;
                const [year, month, day] = value.split("-").map(Number);
                const due = new Date(year, month - 1, day, 23, 59, 59, 999);
                return Number.isFinite(due.getTime()) && due.getTime() > Date.now()
                    ? Math.ceil(((due.getTime() - Date.now()) / 3600000) * 2) / 2
                    : null;
            };
            document.querySelectorAll("tr[data-row]").forEach(row => {
                const date = row.querySelector("[data-due-date]");
                const duration = row.querySelector("[data-field='ExpectedDurationHours']");
                if (date && duration) {
                    date.min = dateFromHours(0);
                    date.value = dateFromHours(duration.value);
                }
            });
            document.addEventListener("input", (event) => {
                const row = event.target.closest("tr[data-row]");
                if (!row) return;
                if (event.target.matches("[data-due-date]")) {
                    const duration = hoursUntilEndOfDate(event.target.value);
                    if (duration !== null) row.querySelector("[data-field='ExpectedDurationHours']").value = String(duration);
                    return;
                }
                if (event.target.dataset.field === "ExpectedDurationHours") {
                    const date = row.querySelector("[data-due-date]");
                    if (date) date.value = dateFromHours(event.target.value);
                    return;
                }
                if (["EscalationAfterHours", "EscalationLevel2AfterHours", "EscalationLevel3AfterHours"].includes(event.target.dataset.field)) {
                    const first = row.querySelector("[data-field='EscalationAfterHours']");
                    const second = row.querySelector("[data-field='EscalationLevel2AfterHours']");
                    const third = row.querySelector("[data-field='EscalationLevel3AfterHours']");
                    if (first.value !== "" && second.value !== "" && Number(second.value) <= Number(first.value)) second.value = String(Number(first.value) + 0.5);
                    if (second.value !== "" && third.value !== "" && Number(third.value) <= Number(second.value)) third.value = String(Number(second.value) + 0.5);
                    return;
                }
                if (event.target.dataset.field !== "StepName") return;
                const key = row?.querySelector("[data-field='StepKey']");
                if (key && (!key.value || key.dataset.generated === "true")) {
                    key.value = toTaskId(event.target.value);
                    key.dataset.generated = "true";
                }
            });

            fetch("/api/work-center/assignees")
                .then(response => response.ok ? response.json() : [])
                .then(assignees => {
                    const datalist = document.getElementById("registeredWorkflowEmails");
                    assignees.forEach(assignee => {
                        const option = document.createElement("option");
                        option.value = assignee.email;
                        option.label = assignee.displayName
                            ? `${assignee.displayName} (${assignee.email})`
                            : assignee.email;
                        datalist.append(option);
                    });
                })
                .catch(() => {});
        })();
    </script>
}
