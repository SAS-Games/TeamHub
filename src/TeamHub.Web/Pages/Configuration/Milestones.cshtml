@page "/Configuration/Milestones"
@model TeamHub.Web.Pages.Configuration.MilestonesModel
@using TeamHub.Excel
@{
    ViewData["Title"] = "Milestone Tracker Configuration";
}

<div class="page-hero">
    <div>
        <div class="eyebrow">Configuration</div>
        <h1>Milestone Tracker</h1>
        <p>Select the Excel workbook source used by Milestone Tracker and Studio roadmap views.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Configuration/Index">All Configuration</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info mt-3">@Model.StatusMessage</div>
}

<form method="post" asp-page-handler="Save" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <section class="content-section">
        <div class="section-heading"><div><span>Data source</span><h2>Milestone workbook</h2></div></div>
        <div class="section-body row g-3">
            <div class="col-12 col-lg-6">
                <label asp-for="Settings.SourceType" class="form-label">Workbook source</label>
                <select asp-for="Settings.SourceType" class="form-select" id="milestone-source-type">
                    <option value="@ExcelWorkbookSourceTypes.LocalFile">Local file on the TeamHub server</option>
                    <option value="@ExcelWorkbookSourceTypes.ExcelUrl">Excel download link</option>
                    <option value="@ExcelWorkbookSourceTypes.MicrosoftGraphExcel">SharePoint / OneDrive</option>
                    <option value="@ExcelWorkbookSourceTypes.UploadedExcel">Upload from this computer</option>
                </select>
            </div>

            <div class="col-12 milestone-source-fields" data-source="@ExcelWorkbookSourceTypes.LocalFile">
                <label asp-for="Settings.ExcelPath" class="form-label">Excel file path</label>
                <input asp-for="Settings.ExcelPath" class="form-control" maxlength="2048" />
                <div class="form-text">Enter the path as seen by the TeamHub server, for example <code>config/MilestoneTracker.xlsx</code> or an absolute server path. Both .xls and .xlsx are supported.</div>
            </div>

            <div class="col-12 milestone-source-fields" data-sources="@ExcelWorkbookSourceTypes.ExcelUrl @ExcelWorkbookSourceTypes.MicrosoftGraphExcel">
                <label asp-for="Settings.SourceUrl" class="form-label">Workbook link</label>
                <input asp-for="Settings.SourceUrl" class="form-control" type="url" maxlength="2048" placeholder="https://.../MilestoneTracker.xlsx" />
                <div class="form-text">For SharePoint or OneDrive, paste the complete workbook link from the browser or Copy link. For an Excel download link, the URL must return the workbook directly.</div>
            </div>

            <div class="col-12 milestone-source-fields" data-source="@ExcelWorkbookSourceTypes.MicrosoftGraphExcel">
                <div class="alert alert-secondary mb-3">
                    <strong>How TeamHub accesses SharePoint / OneDrive:</strong>
                    <ul class="mb-0 mt-1 ps-3">
                        <li>TeamHub automatically detects SharePoint Online, OneDrive, and <code>Doc.aspx</code> links, attempting direct workbook access first.</li>
                        <li>If your organization requires sign-in, you can enter Microsoft Graph App Registration credentials below (or configure them in <code>appsettings.json</code> under <code>TeamExcel:MicrosoftGraph</code>).</li>
                    </ul>
                </div>
                <div class="card border bg-light p-3">
                    <h6 class="mb-1">Microsoft Graph Credentials <span class="badge bg-secondary text-light fw-normal">Optional</span></h6>
                    <p class="text-muted small mb-3">Only needed if your SharePoint/OneDrive link requires enterprise authentication. Credentials saved here will also be used for Excel-backed Custom Team Tabs.</p>
                    <div class="row g-2">
                        <div class="col-12 col-md-4">
                            <label asp-for="Settings.TenantId" class="form-label small">Directory (Tenant) ID</label>
                            <input asp-for="Settings.TenantId" class="form-control form-control-sm" placeholder="e.g. 72f988bf-86f1-41af-91ab-2d7cd011db47" autocomplete="off" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Settings.ClientId" class="form-label small">Application (Client) ID</label>
                            <input asp-for="Settings.ClientId" class="form-control form-control-sm" placeholder="e.g. 11111111-2222-3333-4444-555555555555" autocomplete="off" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Settings.ClientSecret" class="form-label small">Client Secret Value</label>
                            <input asp-for="Settings.ClientSecret" type="password" class="form-control form-control-sm" placeholder="Secret value" autocomplete="new-password" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 milestone-source-fields" data-source="@ExcelWorkbookSourceTypes.UploadedExcel">
                <input type="hidden" name="Settings.SourceUrl" value="@Model.Settings.SourceUrl" />
                <input type="hidden" name="Settings.SourceDisplayName" value="@Model.Settings.SourceDisplayName" />
                <label asp-for="WorkbookFile" class="form-label">Milestone workbook</label>
                <input asp-for="WorkbookFile" class="form-control" type="file" accept=".xls,.xlsx,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <div class="form-text">Browse for an .xls or .xlsx file up to 25 MB. Current file: @(string.IsNullOrWhiteSpace(Model.Settings.SourceDisplayName) ? "No workbook uploaded" : Model.Settings.SourceDisplayName)</div>
            </div>
        </div>
    </section>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary" type="submit" asp-page-handler="Test">Test workbook</button>
        <button class="btn btn-primary" type="submit" asp-page-handler="Save">Save Milestone Configuration</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const source = document.getElementById('milestone-source-type');
            const fields = document.querySelectorAll('.milestone-source-fields');
            const refresh = () => fields.forEach(field => {
                const sources = (field.dataset.sources || field.dataset.source || '').split(' ');
                const visible = sources.includes(source.value);
                field.hidden = !visible;
                field.querySelectorAll('input, select, textarea, button').forEach(control => control.disabled = !visible);
            });
            source.addEventListener('change', refresh);
            refresh();
        })();
    </script>
}
