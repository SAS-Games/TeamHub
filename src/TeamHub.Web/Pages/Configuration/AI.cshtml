@page "/Configuration/AI"
@model TeamHub.Web.Pages.Configuration.AIModel
@using TeamHub.AI.Contracts
@{
    ViewData["Title"] = "AI Services";
}

<div class="page-hero">
    <div>
        <div class="eyebrow">Admin · Integrations</div>
        <h1>AI Services</h1>
        <p>Choose the model runtime used by Team Hub and control which AI-assisted features are available.</p>
    </div>
    <div><a asp-page="/Configuration/AIUsage" class="btn btn-outline-primary">Open AI Usage Ledger</a></div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info" role="status">@Model.StatusMessage</div>
}

<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <section class="content-section mb-4">
        <div class="section-heading"><div><span>Runtime</span><h2>Provider selection</h2></div></div>
        <div class="p-4 row g-3">
            <div class="col-12 col-lg-6">
                <label asp-for="Settings.Provider" class="form-label">Active provider</label>
                <select asp-for="Settings.Provider" class="form-select">
                    <option value="@AiModelProviderKeys.Ollama">Ollama</option>
                    <option value="@AiModelProviderKeys.LlamaCpp">llama.cpp</option>
                    <option value="@AiModelProviderKeys.OpenAiCompatible">OpenAI-compatible</option>
                    <option value="@AiModelProviderKeys.PfbAiGateway">Sony PFB AI Gateway</option>
                </select>
            </div>
            <div class="col-6 col-lg-3">
                <label asp-for="Settings.Temperature" class="form-label">Temperature</label>
                <input asp-for="Settings.Temperature" class="form-control" step="0.1" />
                <span asp-validation-for="Settings.Temperature" class="text-danger"></span>
            </div>
            <div class="col-6 col-lg-3">
                <label asp-for="Settings.TimeoutSeconds" class="form-label">Timeout (seconds)</label>
                <input asp-for="Settings.TimeoutSeconds" class="form-control" />
                <span asp-validation-for="Settings.TimeoutSeconds" class="text-danger"></span>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="Settings.OfflineOnly" class="form-check-input" />
                    <label asp-for="Settings.OfflineOnly" class="form-check-label">Offline-only: require the active endpoint to use localhost or another loopback address</label>
                </div>
            </div>
            <div class="col-12 d-flex flex-wrap justify-content-end gap-2 pt-2">
                <button type="submit" asp-page-handler="TestConnection" formnovalidate class="btn btn-outline-primary">Test saved connection</button>
                <button type="submit" asp-page-handler="SaveRuntime" formnovalidate class="btn btn-primary">Save runtime</button>
            </div>
        </div>
    </section>

    <section class="content-section mb-4">
        <div class="section-heading"><div><span>Models</span><h2>Provider profiles</h2></div></div>
        <div class="p-4">
            <div class="row g-3 mb-4">
                <div class="col-12"><h3 class="h5">Ollama</h3></div>
                <div class="col-12 col-lg-8"><label asp-for="Settings.OllamaEndpoint" class="form-label">Endpoint</label><input asp-for="Settings.OllamaEndpoint" class="form-control" /><span asp-validation-for="Settings.OllamaEndpoint" class="text-danger"></span></div>
                <div class="col-12 col-lg-4"><label asp-for="Settings.OllamaModel" class="form-label">Model</label><input asp-for="Settings.OllamaModel" class="form-control" /><span asp-validation-for="Settings.OllamaModel" class="text-danger"></span></div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-12"><h3 class="h5">llama.cpp</h3></div>
                <div class="col-12 col-lg-8"><label asp-for="Settings.LlamaCppEndpoint" class="form-label">Endpoint</label><input asp-for="Settings.LlamaCppEndpoint" class="form-control" /><span asp-validation-for="Settings.LlamaCppEndpoint" class="text-danger"></span></div>
                <div class="col-12 col-lg-4"><label asp-for="Settings.LlamaCppModel" class="form-label">Model alias</label><input asp-for="Settings.LlamaCppModel" class="form-control" /><span asp-validation-for="Settings.LlamaCppModel" class="text-danger"></span></div>
            </div>
            <div class="row g-3">
                <div class="col-12"><h3 class="h5">OpenAI-compatible</h3></div>
                <div class="col-12 col-lg-8"><label asp-for="Settings.OpenAiCompatibleEndpoint" class="form-label">Endpoint</label><input asp-for="Settings.OpenAiCompatibleEndpoint" class="form-control" /><span asp-validation-for="Settings.OpenAiCompatibleEndpoint" class="text-danger"></span></div>
                <div class="col-12 col-lg-4"><label asp-for="Settings.OpenAiCompatibleModel" class="form-label">Model</label><input asp-for="Settings.OpenAiCompatibleModel" class="form-control" /><span asp-validation-for="Settings.OpenAiCompatibleModel" class="text-danger"></span></div>
            </div>
            <hr class="my-4" />
            <div class="row g-3">
                <div class="col-12"><h3 class="h5">Sony PFB AI Gateway</h3><p class="text-secondary mb-0">Uses a personal bearer token when the signed-in user has one; otherwise it uses the shared static M2M bearer/application key. Users manage personal tokens in <a asp-page="/Profile/Atlassian">My Connections</a>.</p></div>
                <div class="col-12 col-lg-6"><label asp-for="Settings.PfbAiGatewayEndpoint" class="form-label">Gateway host</label><input asp-for="Settings.PfbAiGatewayEndpoint" class="form-control" /><span asp-validation-for="Settings.PfbAiGatewayEndpoint" class="text-danger"></span></div>
                <div class="col-12 col-lg-3">
                    <label asp-for="Settings.PfbAiGatewayModel" class="form-label">Model</label>
                    <select asp-for="Settings.PfbAiGatewayModel" class="form-select">
                        @if (!Model.PfbModels.Any(model => string.Equals(model.Id, Model.Settings.PfbAiGatewayModel, StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@Model.Settings.PfbAiGatewayModel">@Model.Settings.PfbAiGatewayModel (configured)</option>
                        }
                        @foreach (var catalogModel in Model.PfbModels)
                        {
                            var label = string.IsNullOrWhiteSpace(catalogModel.CostTier)
                                ? catalogModel.Id
                                : $"{catalogModel.Id} [{catalogModel.CostTier}]";
                            <option value="@catalogModel.Id">@label</option>
                        }
                    </select>
                    <span asp-validation-for="Settings.PfbAiGatewayModel" class="text-danger"></span>
                </div>
                <div class="col-12 col-lg-3">
                    <label asp-for="Settings.PfbAiGatewayApiMode" class="form-label">API route</label>
                    <select asp-for="Settings.PfbAiGatewayApiMode" class="form-select">
                        <option value="CommonChat">Common chat</option>
                        <option value="OpenAiChat">OpenAI chat completions</option>
                        <option value="OpenAiResponses">OpenAI responses</option>
                    </select>
                </div>
                <div class="col-12">
                    <div class="form-text">@Model.PfbModelCatalogMessage</div>
                    <div class="form-text">Model discovery uses <code>/portal/pfb/models</code>. Remote gateway use requires Offline-only to be cleared. Reload this page to refresh the catalog.</div>
                </div>
                <div class="col-12"><hr class="my-2" /></div>
                <div class="col-12 col-lg-8">
                    <label asp-for="PfbM2mCredential" class="form-label">M2M bearer/application key</label>
                    <input asp-for="PfbM2mCredential" class="form-control" autocomplete="new-password" placeholder="Leave blank to keep the existing M2M key" />
                    <div class="form-text">Stored encrypted and never displayed again. This fallback also supports background or application requests that have no signed-in user's personal token.</div>
                </div>
                <div class="col-12 col-lg-4 d-flex flex-column justify-content-end">
                    <span class="badge align-self-start @(Model.HasPfbM2mCredential ? "text-bg-success" : "text-bg-secondary")">@(Model.HasPfbM2mCredential ? "M2M key configured" : "No M2M key configured")</span>
                    @if (Model.HasPfbM2mCredential)
                    {
                        <div class="form-check mt-2"><input asp-for="RemovePfbM2mCredential" class="form-check-input" /><label asp-for="RemovePfbM2mCredential" class="form-check-label">Remove the stored M2M key</label></div>
                    }
                </div>
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" asp-page-handler="SavePfbM2mCredential" formnovalidate class="btn btn-outline-primary">Save PFB M2M key</button>
                </div>
            </div>
            <div class="d-flex justify-content-end mt-4">
                <button type="submit" asp-page-handler="SaveModels" formnovalidate class="btn btn-primary">Save provider profiles</button>
            </div>
        </div>
    </section>

    @if (Model.Settings.Provider != AiModelProviderKeys.PfbAiGateway)
    {
    <section class="content-section mb-4">
        <div class="section-heading"><div><span>Security</span><h2>Provider credential</h2></div></div>
        <div class="p-4 row g-3">
            <div class="col-12 col-lg-6">
                <label asp-for="Credential" class="form-label">Replace application key or bearer token</label>
                <input asp-for="Credential" class="form-control" autocomplete="new-password" placeholder="Leave blank to keep the existing credential" />
                <div class="form-text">Stored encrypted with ASP.NET Core Data Protection and never displayed again.</div>
            </div>
            <div class="col-12 col-lg-6">
                <label asp-for="Settings.CredentialEnvironmentVariable" class="form-label">Environment-variable fallback</label>
                <input asp-for="Settings.CredentialEnvironmentVariable" class="form-control" />
                <div class="form-text">Used only when no encrypted credential is stored.</div>
            </div>
            <div class="col-12">
                <span class="badge @(Model.HasCredential ? "text-bg-success" : "text-bg-secondary")">@(Model.HasCredential ? "Credential configured" : "No credential configured")</span>
                @if (Model.HasCredential)
                {
                    <div class="form-check mt-2"><input asp-for="RemoveCredential" class="form-check-input" /><label asp-for="RemoveCredential" class="form-check-label">Remove the stored credential</label></div>
                }
            </div>
            <div class="col-12 d-flex justify-content-end pt-2">
                <button type="submit" asp-page-handler="SaveSecurity" formnovalidate class="btn btn-primary">Save security</button>
            </div>
        </div>
    </section>
    }

    <section class="content-section mb-4">
        <div class="section-heading"><div><span>Feature</span><h2>TeamHub Assistant</h2></div></div>
        <div class="p-4 row g-3">
            <div class="col-12">
              <div class="form-check">
                <input asp-for="Settings.ChatEnabled" class="form-check-input" />
                <label asp-for="Settings.ChatEnabled" class="form-check-label">Enable TeamHub Assistant</label>
              </div>
              <div class="form-text">
                  Uses the active provider and lets users select from its available models. TeamHub mode applies access checks; General mode cannot access TeamHub data.
              </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <label asp-for="Settings.ChatMaximumMessages" class="form-label"></label>
                <input asp-for="Settings.ChatMaximumMessages" class="form-control" />
                <span asp-validation-for="Settings.ChatMaximumMessages" class="text-danger"></span>
            </div>
            <div class="col-md-6 col-xl-3">
                <label asp-for="Settings.ChatMaximumMessageCharacters" class="form-label"></label>
                <input asp-for="Settings.ChatMaximumMessageCharacters" class="form-control" />
                <span asp-validation-for="Settings.ChatMaximumMessageCharacters" class="text-danger"></span>
            </div>
            <div class="col-md-6 col-xl-3">
                <label asp-for="Settings.ChatMaximumDocuments" class="form-label"></label>
                <input asp-for="Settings.ChatMaximumDocuments" class="form-control" />
                <span asp-validation-for="Settings.ChatMaximumDocuments" class="text-danger"></span>
            </div>
            <div class="col-md-6 col-xl-3">
                <label asp-for="Settings.ChatMaximumDocumentCharacters" class="form-label"></label>
                <input asp-for="Settings.ChatMaximumDocumentCharacters" class="form-control" />
                <span asp-validation-for="Settings.ChatMaximumDocumentCharacters" class="text-danger"></span>
            </div>
            <div class="col-md-6 col-xl-3">
                <label asp-for="Settings.ChatMaximumKnowledgeCharacters" class="form-label"></label>
                <input asp-for="Settings.ChatMaximumKnowledgeCharacters" class="form-control" />
                <span asp-validation-for="Settings.ChatMaximumKnowledgeCharacters" class="text-danger"></span>
                <div class="form-text">Caps authorized TeamHub source content supplied to one request.</div>
            </div>
            <div class="col-md-6 col-xl-3">
                <label asp-for="Settings.ChatMaximumLocalPromptCharacters" class="form-label"></label>
                <input asp-for="Settings.ChatMaximumLocalPromptCharacters" class="form-control" />
                <span asp-validation-for="Settings.ChatMaximumLocalPromptCharacters" class="text-danger"></span>
                <div class="form-text">Applies when the selected provider runs locally.</div>
            </div>
            <div class="col-md-6 col-xl-3">
                <label asp-for="Settings.ChatMaximumInstructionCharacters" class="form-label"></label>
                <input asp-for="Settings.ChatMaximumInstructionCharacters" class="form-control" />
                <span asp-validation-for="Settings.ChatMaximumInstructionCharacters" class="text-danger"></span>
            </div>
            <div class="col-md-6 col-xl-3">
                <label asp-for="Settings.ChatMaximumOutputTokens" class="form-label"></label>
                <input asp-for="Settings.ChatMaximumOutputTokens" class="form-control" />
                <span asp-validation-for="Settings.ChatMaximumOutputTokens" class="text-danger"></span>
                <div class="form-text">Initial response allowance. PFB can retry truncated responses up to 32,000 tokens.</div>
            </div>
            <div class="col-12 d-flex justify-content-end pt-2">
                <button type="submit" asp-page-handler="SaveChat" formnovalidate class="btn btn-primary">Save TeamHub Assistant</button>
            </div>
        </div>
    </section>

    <section class="content-section mb-4">
        <div class="section-heading"><div><span>Feature</span><h2>Meeting Notes</h2></div></div>
        <div class="p-4 row g-3">
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="Settings.MeetingNotesEnabled" class="form-check-input" />
                    <label asp-for="Settings.MeetingNotesEnabled" class="form-check-label"></label>
                </div>
                <div class="form-text">Generates Markdown meeting notes only from a pasted or attached transcript.</div>
            </div>
            <div class="col-12 col-lg-6">
                <label asp-for="Settings.MeetingNotesInstructionPath" class="form-label"></label>
                <input asp-for="Settings.MeetingNotesInstructionPath" class="form-control" />
                <span asp-validation-for="Settings.MeetingNotesInstructionPath" class="text-danger"></span>
                <div class="form-text">Relative to the TeamHub application directory. Changes are loaded for every request.</div>
            </div>
            <div class="col-12">
                <h3 class="h6 mb-2">Studio additional instructions and Teams publishing</h3>
                <p class="form-text mb-3">
                    These rows come from active studios in Studio Configuration. The default instruction file is always used. Uploading a studio additional-instructions file is optional; TeamHub stores it in the database-backed AI configuration and appends it after the default whenever that studio is selected.
                    Uploading a new file replaces only the studio's previously saved additional file. Keep common formatting rules in the default file and put only studio-specific differences in the additional file. In Teams, open the required destination,
                    select <strong>… → Workflows → Send webhook alerts to a channel</strong>, create the workflow, and paste its URL below.
                    The URL is encrypted and is never displayed again. The Power Automate workflow determines the exact Team and channel.
                </p>
                @if (Model.MeetingNotesTeamsChannels.Count == 0)
                {
                    <div class="alert alert-secondary mb-0">No active studios are configured.</div>
                }
                else
                {
                    <div class="table-responsive teams-destination-table-wrap">
                        <table class="table align-middle mb-0 teams-destination-table">
                            <thead><tr><th>Studio</th><th>Additional instructions (.md)</th><th>Workflow webhook URL</th><th>Status</th></tr></thead>
                            <tbody>
                            @for (var index = 0; index < Model.MeetingNotesTeamsChannels.Count; index++)
                            {
                                <tr>
                                    <td>
                                        <strong>@Model.MeetingNotesTeamsChannels[index].StudioName</strong>
                                        <input asp-for="MeetingNotesTeamsChannels[index].StudioId" type="hidden" />
                                    </td>
                                    <td>
                                        <input asp-for="MeetingNotesTeamsChannels[index].InstructionFile" class="form-control form-control-sm"
                                               type="file" accept=".md,.markdown,text/markdown,text/plain" />
                                        @if (Model.MeetingNotesTeamsChannels[index].HasInstruction)
                                        {
                                            <div class="small mt-1 d-flex flex-wrap align-items-center gap-2">
                                                <span>Saved: <strong>@Model.MeetingNotesTeamsChannels[index].InstructionFileName</strong></span>
                                                @if (Model.MeetingNotesTeamsChannels[index].InstructionStoredInDatabase)
                                                {
                                                    <a asp-page-handler="DownloadMeetingNotesInstruction"
                                                       asp-route-studioId="@Model.MeetingNotesTeamsChannels[index].StudioId">Download</a>
                                                }
                                                else
                                                {
                                                    <span class="text-secondary">Legacy server file; upload it here to migrate.</span>
                                                }
                                            </div>
                                            <div class="form-check mt-1">
                                                <input asp-for="MeetingNotesTeamsChannels[index].RemoveInstruction" class="form-check-input" />
                                                <label asp-for="MeetingNotesTeamsChannels[index].RemoveInstruction" class="form-check-label">Remove saved additional file</label>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <input asp-for="MeetingNotesTeamsChannels[index].WebhookUrl" class="form-control form-control-sm" type="password"
                                               autocomplete="new-password" placeholder="@(Model.MeetingNotesTeamsChannels[index].IsConfigured ? "Leave blank to keep existing URL" : "Paste Teams Workflow URL")" />
                                    </td>
                                    <td class="teams-destination-status-cell">
                                        <span class="teams-destination-status @(Model.MeetingNotesTeamsChannels[index].IsConfigured ? "is-configured" : "is-unconfigured")">
                                            @(Model.MeetingNotesTeamsChannels[index].IsConfigured ? "Configured" : "Not configured")
                                        </span>
                                        @if (Model.MeetingNotesTeamsChannels[index].IsConfigured)
                                        {
                                            <div class="form-check teams-destination-remove">
                                                <input asp-for="MeetingNotesTeamsChannels[index].Remove" class="form-check-input" />
                                                <label asp-for="MeetingNotesTeamsChannels[index].Remove" class="form-check-label">Remove saved webhook</label>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="col-12 d-flex justify-content-end pt-2">
                <button type="submit" asp-page-handler="SaveMeetingNotes" formnovalidate class="btn btn-primary">Save Meeting Notes</button>
            </div>
        </div>
    </section>

    <section class="content-section mb-4">
        <div class="section-heading"><div><span>Feature</span><h2>Flow Designer</h2></div></div>
        <div class="p-4 row g-3">
            <div class="col-12"><div class="form-check"><input asp-for="Settings.FlowDesignerEnabled" class="form-check-input" /><label asp-for="Settings.FlowDesignerEnabled" class="form-check-label">Enable Create with AI</label></div></div>
            <div class="col-6 col-lg-4">
                <label asp-for="Settings.MaximumSourceDocuments" class="form-label">Maximum source documents per request</label>
                <input asp-for="Settings.MaximumSourceDocuments" class="form-control" />
                <div class="form-text">Limits how many documents can be included in one generation.</div>
            </div>
            <div class="col-6 col-lg-4">
                <label asp-for="Settings.MaximumSourceCharacters" class="form-label">Maximum combined source characters</label>
                <input asp-for="Settings.MaximumSourceCharacters" class="form-control" />
                <div class="form-text">Limits the combined text from all selected documents. Content is rejected, not truncated, when it exceeds this value.</div>
            </div>
            <div class="col-6 col-lg-4">
                <label asp-for="Settings.MaximumPromptCharacters" class="form-label">Maximum instruction characters</label>
                <input asp-for="Settings.MaximumPromptCharacters" class="form-control" />
                <div class="form-text">Limits the user's diagram instruction; source documents are counted separately.</div>
            </div>
            <div class="col-6 col-lg-4">
                <label asp-for="Settings.MaximumOutputTokens" class="form-label">Maximum output tokens per AI request</label>
                <input asp-for="Settings.MaximumOutputTokens" class="form-control" />
                <div class="form-text">Caps the generated diagram response. Lower values reduce latency and usage but may truncate complex results.</div>
            </div>
            <div class="col-6 col-lg-4"><label asp-for="Settings.MaximumDiagrams" class="form-label">Maximum diagrams</label><input asp-for="Settings.MaximumDiagrams" class="form-control" /></div>
            <div class="col-6 col-lg-4"><label asp-for="Settings.MaximumHierarchyDepth" class="form-label">Maximum hierarchy depth</label><input asp-for="Settings.MaximumHierarchyDepth" class="form-control" /></div>
            <div class="col-12 d-flex justify-content-end pt-2">
                <button type="submit" asp-page-handler="SaveFlowDesigner" formnovalidate class="btn btn-primary">Save Flow Designer</button>
            </div>
        </div>
    </section>

    <section class="content-section mb-4">
        <div class="section-heading"><div><span>Support Summary</span><h2>Report Generator</h2></div></div>
        <div class="p-4 row g-3">
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="Settings.ReportGeneratorEnabled" class="form-check-input" />
                    <label asp-for="Settings.ReportGeneratorEnabled" class="form-check-label">Enable Weekly Work Summary</label>
                </div>
                <div class="form-text">Uses the configured provider and model. Sony PFB AI Gateway uses the signed-in user's personal token when available and otherwise falls back to the configured M2M key. Users also need AI Reports Create and Support Summary Read Only access.</div>
            </div>
            <div class="col-md-4">
                <label asp-for="Settings.ReportMaximumConcurrentRequests" class="form-label">Maximum concurrent reports</label>
                <input asp-for="Settings.ReportMaximumConcurrentRequests" class="form-control" />
                <span asp-validation-for="Settings.ReportMaximumConcurrentRequests" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Settings.ReportMaximumSourceCharactersPerStudio" class="form-label">Maximum source characters per studio</label>
                <input asp-for="Settings.ReportMaximumSourceCharactersPerStudio" class="form-control" />
                <span asp-validation-for="Settings.ReportMaximumSourceCharactersPerStudio" class="text-danger"></span>
                <div class="form-text">Limits the support activity sent for one studio. Content is rejected, not truncated, when it exceeds this value.</div>
            </div>
            <div class="col-md-4">
                <label asp-for="Settings.ReportMaximumOutputTokens" class="form-label">Maximum output tokens per studio</label>
                <input asp-for="Settings.ReportMaximumOutputTokens" class="form-control" />
                <span asp-validation-for="Settings.ReportMaximumOutputTokens" class="text-danger"></span>
                <div class="form-text">Caps each studio's generated summary. Lower values reduce latency and usage but may truncate the response.</div>
            </div>
            <div class="col-12">
                <label asp-for="Settings.WeeklyWorkSummaryPromptPath" class="form-label">Weekly Work Summary instruction file</label>
                <input asp-for="Settings.WeeklyWorkSummaryPromptPath" class="form-control" />
                <span asp-validation-for="Settings.WeeklyWorkSummaryPromptPath" class="text-danger"></span>
                <div class="form-text">Relative paths resolve from the application directory. Instruction file changes are read for each report.</div>
            </div>
            <div class="col-12 d-flex justify-content-end pt-2">
                <button type="submit" asp-page-handler="SaveReportGenerator" formnovalidate class="btn btn-primary">Save Report Generator</button>
            </div>
        </div>
    </section>

    @if (Model.UpdatedAtUtc.HasValue)
    {
        <p class="text-secondary small">Last changed by @Model.UpdatedBy at @Model.UpdatedAtUtc.Value.ToLocalTime().ToString("g").</p>
    }

    <div class="d-flex flex-wrap gap-2">
        <a asp-page="/Configuration/Index" class="btn btn-outline-secondary">Back to Configuration</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
