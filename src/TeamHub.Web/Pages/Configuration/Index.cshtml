@page "/Configuration"
@model TeamHub.Web.Pages.Configuration.IndexModel
@{
    ViewData["Title"] = "Configuration";
}

<div class="page-hero">
    <div>
        <div class="eyebrow">Admin</div>
        <h1>Configuration</h1>
        <p>Manage the application data and workflow setup available to your team.</p>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-12 col-md-6 col-xl-4">
        <section class="content-section h-100 m-0">
            <div class="section-heading"><div><span>Notifications</span><h2>Email Service</h2></div></div>
            <div class="p-4">
                <p class="text-secondary">Configure secure SMTP delivery, recipients, templates, retries, and delivery history.</p>
                <a class="btn btn-primary" asp-page="/Configuration/Email">Configure Email</a>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <section class="content-section h-100 m-0">
            <div class="section-heading"><div><span>Integrations</span><h2>Jira &amp; Confluence</h2></div></div>
            <div class="p-4">
                <p class="text-secondary">Configure Atlassian servers, per-studio Jira mappings, and the global weekly Confluence page.</p>
                <a class="btn btn-primary" asp-page="/Configuration/Atlassian">Configure Integrations</a>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <section class="content-section h-100 m-0">
            <div class="section-heading"><div><span>Data source</span><h2>Milestone Tracker</h2></div></div>
            <div class="p-4">
                <p class="text-secondary">Configure the local, direct-download, or SharePoint/OneDrive workbook used for milestone and roadmap views.</p>
                <a class="btn btn-primary" asp-page="/Configuration/Milestones">Configure Milestones</a>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <section class="content-section h-100 m-0">
            <div class="section-heading"><div><span>Security</span><h2>Authorized Users</h2></div></div>
            <div class="p-4">
                <p class="text-secondary">Add, update, activate, deactivate, or remove the users allowed to access TeamHub.</p>
                <a class="btn btn-primary" asp-page="/Administration/Users">Manage Users</a>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <section class="content-section h-100 m-0">
            <div class="section-heading"><div><span>Security</span><h2>Access Management</h2></div></div>
            <div class="p-4">
                <p class="text-secondary">Set Guest, Registered, Privileged, and Admin access for every TeamHub module.</p>
                <a class="btn btn-primary" asp-page="/Administration/Access">Open Access Matrix</a>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <section class="content-section h-100 m-0">
            <div class="section-heading"><div><span>People</span><h2>Team Information</h2></div></div>
            <div class="p-4">
                <p class="text-secondary">Configure SMTP delivery for account invitations, password resets, workflow notifications, retries, and delivery history.</p>
                <a class="btn btn-primary" asp-page="/Team/Configuration">Open Team Configuration</a>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <section class="content-section h-100 m-0">
            <div class="section-heading"><div><span>Studios</span><h2>Studio Information</h2></div></div>
            <div class="p-4">
                <p class="text-secondary">Manage studio details, members, tools, and important links.</p>
                <a class="btn btn-primary" asp-page="/Studio/Configuration">Open Studio Configuration</a>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <section class="content-section h-100 m-0">
            <div class="section-heading"><div><span>Automation</span><h2>Workflows</h2></div></div>
            <div class="p-4">
                <p class="text-secondary">Create, validate, and publish workflow definitions used by Work Center.</p>
                <a class="btn btn-primary" asp-page="/WorkCenter/Configuration">Open Workflow Configuration</a>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <section class="content-section h-100 m-0">
            <div class="section-heading"><div><span>Reuse</span><h2>Template Catalog</h2></div></div>
            <div class="p-4">
                <p class="text-secondary">Review reusable flow and workflow templates stored in the shared Flow Library database.</p>
                <a class="btn btn-primary" asp-page="/Configuration/Templates">Open Template Catalog</a>
            </div>
        </section>
    </div>
</div>
