@page "/Configuration/AI/Usage"
@model TeamHub.Web.Pages.Configuration.AIUsageModel
@using TeamHub.AI.Usage.Contracts
@{
    ViewData["Title"] = "AI Usage Ledger";
}

<div class="page-hero">
    <div>
        <div class="eyebrow">AI Services</div>
        <h1>AI Usage Ledger</h1>
        <p>Review token consumption by user, feature, application, provider, and model.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info" role="status">@Model.StatusMessage</div>
}

<section class="content-section mb-4">
    <div class="section-heading"><div><span>Current consumption</span><h2>Token utilization by user</h2></div></div>
    <div class="p-4">
        <p class="text-secondary small">
            Today, this week, and this month use <strong>@Model.ConsumptionTimeZoneId</strong>. Weeks begin on Monday.
            Retained total covers all usage still present under the configured retention policy. Only completed calls with measured token usage are included.
        </p>
        @if (Model.UserConsumption.Count == 0)
        {
            <div class="alert alert-secondary mb-0">No authorized users or measured AI token consumption are available.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                    <tr>
                        <th>User</th>
                        <th class="text-end">Today</th>
                        <th class="text-end">This week</th>
                        <th class="text-end">This month</th>
                        <th class="text-end">Retained total</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var user in Model.UserConsumption)
                    {
                        <tr>
                            <td><strong>@user.DisplayName</strong><div class="small text-secondary">@user.UserId</div></td>
                            <td class="text-end">@user.TodayTokens.ToString("N0")</td>
                            <td class="text-end">@user.WeekTokens.ToString("N0")</td>
                            <td class="text-end">@user.MonthTokens.ToString("N0")</td>
                            <td class="text-end fw-semibold">@user.RetainedTotalTokens.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot class="table-group-divider fw-semibold">
                    <tr>
                        <td>All users</td>
                        <td class="text-end">@Model.UserConsumption.Sum(user => user.TodayTokens).ToString("N0")</td>
                        <td class="text-end">@Model.UserConsumption.Sum(user => user.WeekTokens).ToString("N0")</td>
                        <td class="text-end">@Model.UserConsumption.Sum(user => user.MonthTokens).ToString("N0")</td>
                        <td class="text-end">@Model.UserConsumption.Sum(user => user.RetainedTotalTokens).ToString("N0")</td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</section>

<section class="content-section mb-4">
    <div class="section-heading"><div><span>Controls</span><h2>Daily consumption limits</h2></div></div>
    <form method="post" asp-page-handler="SaveLimits" class="p-4 row g-3">
        <div class="col-12 col-lg-5">
            <label asp-for="LimitInput.DefaultDailyTokenLimit" class="form-label">Default tokens per user per day</label>
            <input asp-for="LimitInput.DefaultDailyTokenLimit" type="number" min="0" class="form-control" placeholder="Unlimited" />
            <span asp-validation-for="LimitInput.DefaultDailyTokenLimit" class="text-danger"></span>
            <div class="form-text">Applies to every authorized user without an override. Leave blank or enter 0 for unlimited.</div>
        </div>
        <div class="col-12 col-lg-7">
            <label asp-for="LimitInput.ResetTimeZoneId" class="form-label">Daily reset timezone</label>
            <select asp-for="LimitInput.ResetTimeZoneId" class="form-select">
                @foreach (var timeZone in Model.TimeZones)
                {
                    <option value="@timeZone.Id">@timeZone.DisplayName (@timeZone.Id)</option>
                }
            </select>
            <span asp-validation-for="LimitInput.ResetTimeZoneId" class="text-danger"></span>
            <div class="form-text">Each user's daily window resets automatically at 12:00 AM in this timezone.</div>
        </div>
        <div class="col-12 col-lg-5">
            <div class="form-check mt-lg-4 pt-lg-2">
                <input asp-for="LimitInput.NotificationsEnabled" class="form-check-input" />
                <label asp-for="LimitInput.NotificationsEnabled" class="form-check-label">Enable in-app consumption warnings</label>
            </div>
            <div class="form-text">Warnings appear in the Team Hub notification inbox. They are not sent by email.</div>
        </div>
        <div class="col-12 col-lg-7">
            <label asp-for="LimitInput.NotificationThresholds" class="form-label">Warning thresholds (%)</label>
            <input asp-for="LimitInput.NotificationThresholds" class="form-control" placeholder="75, 90, 100" />
            <span asp-validation-for="LimitInput.NotificationThresholds" class="text-danger"></span>
            <div class="form-text">Enter 1-10 comma-separated percentages from 1 to 100. Each threshold is notified once per user per daily reset window; if one call crosses several thresholds, only the highest newly crossed threshold is shown.</div>
        </div>
        <div class="col-12">
            <div class="alert alert-warning mb-3">
                Once recorded usage reaches a user's effective limit, new provider calls are blocked until the next reset. The final allowed request can exceed the limit because its token count is known only after completion. Calls without provider token telemetry cannot count toward enforcement.
            </div>
            <h3 class="h6">Per-user overrides</h3>
            @if (Model.LimitInput.UserLimits.Count == 0)
            {
                <div class="alert alert-secondary mb-0">No active authorized users are available.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>User</th><th>Daily token limit</th></tr></thead>
                        <tbody>
                        @for (var index = 0; index < Model.LimitInput.UserLimits.Count; index++)
                        {
                            <tr>
                                <td>
                                    <strong>@Model.LimitInput.UserLimits[index].DisplayName</strong>
                                    <div class="small text-secondary">@Model.LimitInput.UserLimits[index].UserId</div>
                                    <input asp-for="LimitInput.UserLimits[index].UserId" type="hidden" />
                                </td>
                                <td>
                                    <input asp-for="LimitInput.UserLimits[index].DailyTokenLimit" type="number" min="0" class="form-control" placeholder="Use organization default" />
                                    <span asp-validation-for="LimitInput.UserLimits[index].DailyTokenLimit" class="text-danger"></span>
                                    <div class="form-text">Blank inherits the default; 0 makes this user unlimited.</div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="col-12 d-flex justify-content-end">
            <button type="submit" class="btn btn-primary">Save daily limits</button>
        </div>
    </form>
</section>

<section class="content-section mb-4">
    <div class="section-heading"><div><span>Report</span><h2>Filters</h2></div></div>
    <form method="get" class="p-4 row g-3">
        <div asp-validation-summary="All" class="text-danger col-12"></div>
        <div class="col-6 col-lg-2">
            <label asp-for="FromDate" class="form-label">From date (UTC)</label>
            <input asp-for="FromDate" type="date" class="form-control" />
            <span asp-validation-for="FromDate" class="text-danger"></span>
        </div>
        <div class="col-6 col-lg-2">
            <label asp-for="ToDate" class="form-label">To date (UTC)</label>
            <input asp-for="ToDate" type="date" class="form-control" />
            <span asp-validation-for="ToDate" class="text-danger"></span>
        </div>
        <div class="col-12 col-lg-4">
            <label asp-for="UserId" class="form-label">User</label>
            <input asp-for="UserId" class="form-control" placeholder="user@example.com" />
        </div>
        <div class="col-12 col-lg-4">
            <label asp-for="Feature" class="form-label">Feature</label>
            <select asp-for="Feature" class="form-select">
                <option value="">All features</option>
                <option value="@AiUsageFeatures.Chat">Chat</option>
                <option value="@AiUsageFeatures.ReportGenerator">Report Generator</option>
                <option value="@AiUsageFeatures.FlowDesigner">Flow Designer</option>
            </select>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <label asp-for="Subfeature" class="form-label">Subfeature</label>
            <select asp-for="Subfeature" class="form-select">
                <option value="">All subfeatures</option>
                @foreach (var value in Model.FilterOptions.Subfeatures) { <option value="@value">@value</option> }
            </select>
            <span asp-validation-for="Subfeature" class="text-danger"></span>
            <div class="form-text">The activity within a feature, such as General Chat, TeamHub Chat, or Weekly Work Summary.</div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <label asp-for="Application" class="form-label">Application</label>
            <select asp-for="Application" class="form-select">
                <option value="">All applications</option>
                @foreach (var value in Model.FilterOptions.Applications) { <option value="@value">@value</option> }
            </select>
            <span asp-validation-for="Application" class="text-danger"></span>
            <div class="form-text">The application that initiated the request, such as TeamHub.Web or a future integrated app.</div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <label asp-for="Provider" class="form-label">Provider</label>
            <select asp-for="Provider" class="form-select">
                <option value="">All providers</option>
                @foreach (var value in Model.FilterOptions.Providers) { <option value="@value">@value</option> }
            </select>
            <span asp-validation-for="Provider" class="text-danger"></span>
            <div class="form-text">The AI service or runtime that handled the request, such as Sony PFB AI Gateway or Ollama.</div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <label asp-for="ModelName" class="form-label">Model</label>
            <select asp-for="ModelName" class="form-select">
                <option value="">All models</option>
                @foreach (var value in Model.FilterOptions.Models) { <option value="@value">@value</option> }
            </select>
            <span asp-validation-for="ModelName" class="text-danger"></span>
            <div class="form-text">The exact AI model used for the call. Historical records retain the original model after configuration changes.</div>
        </div>
        <div class="col-12 col-lg-4">
            <label asp-for="Dimension" class="form-label">Group by</label>
            <select asp-for="Dimension" class="form-select">
                @foreach (var dimension in Enum.GetValues<AiUsageDimension>())
                {
                    <option value="@dimension">@AIUsageModel.DimensionLabel(dimension)</option>
                }
            </select>
            <span asp-validation-for="Dimension" class="text-danger"></span>
            <div class="form-text">Controls how matching calls are combined into report rows; it does not change which calls are included.</div>
        </div>
        <div class="col-12"><hr class="my-2" /><h3 class="h6 mb-0">Tool activity filters</h3></div>
        <div class="col-12 col-md-6 col-lg-3">
            <label asp-for="ToolName" class="form-label">Tool</label>
            <select asp-for="ToolName" class="form-select">
                <option value="">All tools</option>
                @foreach (var value in Model.ToolFilterOptions.ToolNames) { <option value="@value">@value</option> }
            </select>
            <span asp-validation-for="ToolName" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <label asp-for="ToolStatus" class="form-label">Tool status</label>
            <select asp-for="ToolStatus" class="form-select">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<AiToolActivityStatus>()) { <option value="@status">@status</option> }
            </select>
            <span asp-validation-for="ToolStatus" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <label asp-for="ToolExternalSource" class="form-label">External source</label>
            <select asp-for="ToolExternalSource" class="form-select">
                <option value="">All sources</option>
                @foreach (var value in Model.ToolFilterOptions.ExternalSources) { <option value="@value">@value</option> }
            </select>
            <span asp-validation-for="ToolExternalSource" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <label asp-for="ToolDimension" class="form-label">Group tool activity by</label>
            <select asp-for="ToolDimension" class="form-select">
                @foreach (var dimension in Enum.GetValues<AiToolActivityDimension>())
                {
                    <option value="@dimension">@AIUsageModel.ToolDimensionLabel(dimension)</option>
                }
            </select>
            <span asp-validation-for="ToolDimension" class="text-danger"></span>
        </div>
        <div class="col-12 d-flex flex-wrap align-items-end justify-content-end gap-2">
            <button type="submit" name="handler" value="ExportUsageCsv" class="btn btn-outline-primary">Usage CSV</button>
            <button type="submit" name="handler" value="ExportToolCsv" class="btn btn-outline-primary">Tool CSV</button>
            <button type="submit" name="handler" value="ExportExcel" class="btn btn-outline-primary">Excel workbook</button>
            <a asp-page="/Configuration/AIUsage" class="btn btn-outline-secondary">Reset</a>
            <button type="submit" class="btn btn-primary">Run report</button>
        </div>
    </form>
</section>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl">
        <section class="content-section h-100 m-0 p-3"><div class="text-secondary small">Provider calls</div><div class="h3 mb-0">@Model.Report.Totals.RequestCount.ToString("N0")</div></section>
    </div>
    <div class="col-6 col-xl">
        <section class="content-section h-100 m-0 p-3"><div class="text-secondary small">Measured calls</div><div class="h3 mb-0">@Model.Report.Totals.MeasuredRequestCount.ToString("N0")</div><div class="small text-secondary">@Model.MeasurementCoverage.ToString("N1")%</div></section>
    </div>
    <div class="col-6 col-xl">
        <section class="content-section h-100 m-0 p-3"><div class="text-secondary small">Input tokens</div><div class="h3 mb-0">@Model.Report.Totals.InputTokens.ToString("N0")</div></section>
    </div>
    <div class="col-6 col-xl">
        <section class="content-section h-100 m-0 p-3"><div class="text-secondary small">Output tokens</div><div class="h3 mb-0">@Model.Report.Totals.OutputTokens.ToString("N0")</div></section>
    </div>
    <div class="col-12 col-xl">
        <section class="content-section h-100 m-0 p-3"><div class="text-secondary small">Total tokens</div><div class="h3 mb-0">@Model.Report.Totals.TotalTokens.ToString("N0")</div></section>
    </div>
</div>

<section class="content-section mb-4">
    <div class="section-heading"><div><span>Breakdown</span><h2>@AIUsageModel.DimensionLabel(Model.Dimension)</h2></div></div>
    <div class="p-4">
        <p class="text-secondary small">Token totals include provider-reported usage. Calls for which the provider returned no usage telemetry remain visible under Provider calls and reduce the measured coverage percentage.</p>
        @if (Model.Report.Rows.Count == 0)
        {
            <div class="alert alert-secondary mb-0">No AI usage matched the selected filters.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                    <tr>
                        <th>@Model.PrimaryHeading</th>
                        @if (Model.SecondaryHeading is not null) { <th>@Model.SecondaryHeading</th> }
                        @if (Model.TertiaryHeading is not null) { <th>@Model.TertiaryHeading</th> }
                        <th class="text-end">Calls</th>
                        <th class="text-end">Measured</th>
                        <th class="text-end">Input tokens</th>
                        <th class="text-end">Output tokens</th>
                        <th class="text-end">Total tokens</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Report.Rows)
                    {
                        <tr>
                            <td>@row.Key</td>
                            @if (Model.SecondaryHeading is not null) { <td>@row.SecondaryKey</td> }
                            @if (Model.TertiaryHeading is not null) { <td>@row.TertiaryKey</td> }
                            <td class="text-end">@row.RequestCount.ToString("N0")</td>
                            <td class="text-end">@row.MeasuredRequestCount.ToString("N0")</td>
                            <td class="text-end">@row.InputTokens.ToString("N0")</td>
                            <td class="text-end">@row.OutputTokens.ToString("N0")</td>
                            <td class="text-end fw-semibold">@row.TotalTokens.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<section class="content-section mb-4">
    <div class="section-heading"><div><span>Tools</span><h2>@AIUsageModel.ToolDimensionLabel(Model.ToolDimension)</h2></div></div>
    <div class="p-4">
        <p class="text-secondary small">Tool activity is recorded separately from provider calls and never adds zero-token rows to token-consumption totals. Arguments, prompts, returned content, and credentials are not stored.</p>
        <div class="row g-3 mb-4">
            <div class="col-6 col-xl"><div class="border rounded p-3 h-100"><div class="text-secondary small">Tool calls</div><div class="h4 mb-0">@Model.ToolReport.Totals.CallCount.ToString("N0")</div></div></div>
            <div class="col-6 col-xl"><div class="border rounded p-3 h-100"><div class="text-secondary small">Completed</div><div class="h4 mb-0">@Model.ToolReport.Totals.CompletedCount.ToString("N0")</div></div></div>
            <div class="col-6 col-xl"><div class="border rounded p-3 h-100"><div class="text-secondary small">Failed</div><div class="h4 mb-0">@Model.ToolReport.Totals.FailedCount.ToString("N0")</div></div></div>
            <div class="col-6 col-xl"><div class="border rounded p-3 h-100"><div class="text-secondary small">Cancelled</div><div class="h4 mb-0">@Model.ToolReport.Totals.CancelledCount.ToString("N0")</div></div></div>
            <div class="col-12 col-xl"><div class="border rounded p-3 h-100"><div class="text-secondary small">External calls</div><div class="h4 mb-0">@Model.ToolReport.Totals.ExternalCallCount.ToString("N0")</div></div></div>
        </div>
        @if (Model.ToolReport.Rows.Count == 0)
        {
            <div class="alert alert-secondary mb-0">No AI tool activity matched the selected filters.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr>
                        <th>@Model.ToolPrimaryHeading</th>
                        @if (Model.ToolSecondaryHeading is not null) { <th>@Model.ToolSecondaryHeading</th> }
                        <th class="text-end">Calls</th>
                        <th class="text-end">Completed</th>
                        <th class="text-end">Failed</th>
                        <th class="text-end">Cancelled</th>
                        <th class="text-end">Avg. duration</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var row in Model.ToolReport.Rows)
                    {
                        <tr>
                            <td>@row.Key</td>
                            @if (Model.ToolSecondaryHeading is not null) { <td>@row.SecondaryKey</td> }
                            <td class="text-end">@row.CallCount.ToString("N0")</td>
                            <td class="text-end">@row.CompletedCount.ToString("N0")</td>
                            <td class="text-end">@row.FailedCount.ToString("N0")</td>
                            <td class="text-end">@row.CancelledCount.ToString("N0")</td>
                            <td class="text-end">@row.AverageDurationMilliseconds.ToString("N0") ms</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<div class="d-flex flex-wrap gap-2">
    <a asp-page="/Configuration/AI" class="btn btn-outline-secondary">Back to AI Services</a>
    <a asp-page="/Configuration/Index" class="btn btn-outline-secondary">Back to Configuration</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
