@page
@model TeamHub.Web.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-page">
    <div class="card auth-card">
        <div class="eyebrow">Account recovery</div>
        <h1 class="h2 mb-2">Reset your password</h1>
        @if (Model.Submitted)
        {
            <div class="alert alert-success">If an active TeamHub account with an email address matches that identifier, a reset link has been queued.</div>
            <a class="btn btn-primary" asp-page="/Login">Back to sign in</a>
        }
        else
        {
            <p class="text-secondary">Enter your authorized email, user ID, or GID. The reset link is sent to the email stored as your TeamHub user ID.</p>
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Identifier" class="form-label">Email / User ID / GID</label>
                    <input asp-for="Identifier" class="form-control" autocomplete="username" required />
                </div>
                <button class="btn btn-primary" type="submit">Send reset link</button>
                <a class="btn btn-link" asp-page="/Login">Back to sign in</a>
            </form>
        }
    </div>
</div>
