@page "{id:guid}"
@model TeamHub.Web.Pages.Workflows.DetailsModel
@{
    ViewData["Title"] = "Workflow Details";
}

@if (Model.Instance is null)
{
    <p>Not found.</p>
    return;
}

<h1>@Model.Instance.InstanceName</h1>
<p class="text-muted">@Model.Instance.WorkflowDefinition.Name</p>
<p>Status: <strong>@Model.Instance.Status</strong></p>

<div class="table-responsive">
<table class="table table-striped mb-0">
    <thead>
        <tr>
            <th>Status</th>
            <th>Step</th>
            <th>Owner</th>
            <th>Started (UTC)</th>
            <th>Due (UTC)</th>
            <th>Completed (UTC)</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var step in Model.Instance.Steps.OrderBy(x => x.SortOrder))
    {
        <tr>
            <td>@step.Status</td>
            <td>@step.StepName</td>
            <td>@step.Owner</td>
            <td>@(step.StartedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
            <td>@(step.DueAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
            <td>@(step.CompletedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
        </tr>
    }
    </tbody>
</table>
</div>
