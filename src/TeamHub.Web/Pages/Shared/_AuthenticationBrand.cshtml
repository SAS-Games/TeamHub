@using Microsoft.Extensions.Options
@using TeamHub.Web.Options
@inject IOptions<ApplicationOptions> ApplicationOptions

<a class="teamhub-auth-brand" asp-page="/Index" aria-label="@ApplicationOptions.Value.Name Team Hub home">
    <img class="teamhub-auth-logo" src="~/images/teamhub-logo.svg" alt="" aria-hidden="true" asp-append-version="true" />
    <span class="teamhub-auth-brand-copy">
        <strong>@ApplicationOptions.Value.Name</strong>
        <span>Team Hub</span>
    </span>
</a>
