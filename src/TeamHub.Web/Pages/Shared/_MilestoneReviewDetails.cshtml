@model TeamHub.Web.Pages.MilestoneReviewModel

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="ProjectName" class="form-label">Project Name</label>
        <select asp-for="ProjectName" class="form-select" data-milestone-review-project required>
            <option value="">Select project</option>
            @if (!string.IsNullOrWhiteSpace(Model.ProjectName)
                && !Model.ProjectOptions.Contains(Model.ProjectName, StringComparer.OrdinalIgnoreCase))
            {
                <option value="@Model.ProjectName">@Model.ProjectName</option>
            }
            @foreach (var project in Model.ProjectOptions)
            {
                <option value="@project">@project</option>
            }
        </select>
        <span asp-validation-for="ProjectName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Description" class="form-label">Description</label>
        <select asp-for="Description" class="form-select" data-milestone-review-description required>
            <option value="">Select description</option>
            @if (!string.IsNullOrWhiteSpace(Model.Description)
                && !Model.MilestoneOptions.Any(option =>
                    string.Equals(option.ProjectName, Model.ProjectName, StringComparison.OrdinalIgnoreCase)
                    && string.Equals(option.MilestoneName, Model.MilestoneName, StringComparison.OrdinalIgnoreCase)
                    && string.Equals(option.Description, Model.Description, StringComparison.OrdinalIgnoreCase)))
            {
                <option value="@Model.Description" data-project="@Model.ProjectName" data-milestone="@Model.MilestoneName">@Model.Description</option>
            }
            @foreach (var option in Model.MilestoneOptions.Where(item => !string.IsNullOrWhiteSpace(item.Description)))
            {
                <option value="@option.Description" data-project="@option.ProjectName" data-milestone="@option.MilestoneName">@option.Description</option>
            }
        </select>
        <span asp-validation-for="Description" class="text-danger"></span>
        @if (!string.IsNullOrWhiteSpace(Model.MilestoneSelectionError))
        {
            <div class="form-text text-warning">Milestone choices could not be loaded: @Model.MilestoneSelectionError</div>
        }
    </div>
    <div class="col-md-6">
        <label asp-for="MilestoneName" class="form-label">Milestone</label>
        <input asp-for="MilestoneName" class="form-control" data-milestone-review-milestone readonly required />
        <div class="form-text">Automatically populated from the selected description.</div>
        <span asp-validation-for="MilestoneName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="WorkflowKey" class="form-label">Workflow Template</label>
        @{ var workflowLocked = Model.EditingReview?.Status == TeamHub.MilestoneReview.MilestoneReviewStatus.Published; }
        <select asp-for="WorkflowKey" class="form-select" required disabled="@(workflowLocked ? "disabled" : null)">
            <option value="">Select workflow template</option>
            @if (!string.IsNullOrWhiteSpace(Model.WorkflowKey)
                && !Model.WorkflowOptions.Any(option => string.Equals(option.Key, Model.WorkflowKey, StringComparison.OrdinalIgnoreCase)))
            {
                <option value="@Model.WorkflowKey">@Model.WorkflowKey (not currently active)</option>
            }
            @foreach (var workflow in Model.WorkflowOptions)
            {
                <option value="@workflow.Key">@workflow.Name (v@workflow.Version)</option>
            }
        </select>
        @if (workflowLocked)
        {
            <input type="hidden" name="WorkflowKey" value="@Model.WorkflowKey" />
        }
        <div class="form-text">Publishing this review automatically starts an instance of the selected workflow.</div>
    </div>
    <div class="col-12">
        <label asp-for="JiraTicketId" class="form-label">Jira Ticket ID (optional)</label>
        <input asp-for="JiraTicketId" class="form-control" maxlength="64" placeholder="e.g. GAME-123" />
        <div class="form-text">Each reviewer's save creates or updates their comment on this ticket. Reviewers need their own Jira connection with comment edit permission. Changing the ticket leaves old comments untouched; existing feedback syncs to the new ticket on each reviewer's next save.</div>
    </div>
    <div class="col-12">
        <label class="form-label">Feedback contributors</label>
        <div class="border rounded p-2" role="group" aria-label="Feedback contributors">
            @foreach (var reviewer in Model.AvailableReviewers)
            {
                <label class="d-flex align-items-center gap-2 border-bottom py-2 px-1">
                    <input class="form-check-input mt-0" type="checkbox" name="ReviewerIds" value="@reviewer.Id"
                           checked="@Model.ReviewerIds.Contains(reviewer.Id)" />
                    <span class="flex-grow-1">
                        <strong class="d-block">@reviewer.DisplayName</strong>
                        <small class="text-secondary">@reviewer.UserId</small>
                    </span>
                    <span class="small text-secondary">Can review</span>
                </label>
            }
        </div>
        <div class="form-text">Selected users can edit only their own row; all page readers can view every row. Removing a contributor preserves their existing feedback as read-only for that user.</div>
    </div>
</div>
