@using Microsoft.Extensions.Options
@using TeamHub.Studio
@using TeamHub.Team
@using TeamHub.Authentication
@using TeamHub.Web.AccessControl
@using TeamHub.Web.Navigation
@using TeamHub.Web.Options
@inject IOptions<List<NavigationTabOptions>> NavigationTabsOptions
@inject IOptions<ApplicationOptions> ApplicationOptions
@inject IStudioDirectoryService StudioDirectoryService
@inject ICustomTeamTabService CustomTabs
@inject ICurrentAccessService CurrentAccess
@{
    var applicationName = ApplicationOptions.Value.Name;
    var currentModule = TeamHubAccessRoutes.ResolveModule(Context.Request.Path);
    var currentPageAccess = currentModule is null ? AccessLevel.FullAccess : await CurrentAccess.GetAccessLevelAsync(currentModule);
    var isReadOnlyPage = currentPageAccess == AccessLevel.ReadOnly;
    var navigationTabs = new List<NavigationTabOptions>();
    foreach (var tab in NavigationTabsOptions.Value.OrderBy(tab => tab.Order))
    {
        if (string.Equals(tab.Page, "/Logout", StringComparison.OrdinalIgnoreCase))
        {
            if (User.Identity?.IsAuthenticated == true) navigationTabs.Add(tab);
            continue;
        }
        var module = TeamHubAccessRoutes.ResolveNavigationModule(tab.Page);
        if ((!tab.AdminOnly || User.IsInRole(TeamHubUserTypes.Admin))
            && (module is null || await CurrentAccess.CanAsync(module)))
        {
            navigationTabs.Add(tab);
        }
    }
    var mainNavigationTabs = new List<CustomTeamTabDto>();
    try
    {
        foreach (var tab in (await CustomTabs.ListTabsAsync(Context.RequestAborted))
            .Where(tab => tab.NavigationPlacement == CustomTeamTabPlacements.MainNavigation)
            .OrderBy(tab => tab.DisplayOrder)
            .ThenBy(tab => tab.Name))
        {
            if (await CurrentAccess.CanAsync(CustomTeamTabAccess.ModuleForSlug(tab.Slug), AccessLevel.ReadOnly, Context.RequestAborted))
            {
                mainNavigationTabs.Add(tab);
            }
        }
    }
    catch
    {
        mainNavigationTabs = [];
    }
    var mainNavigationInsertPage = navigationTabs.Any(tab => string.Equals(tab.Page, "/Configuration/Index", StringComparison.OrdinalIgnoreCase))
        ? "/Configuration/Index"
        : navigationTabs.Any(tab => string.Equals(tab.Page, "/Logout", StringComparison.OrdinalIgnoreCase))
            ? "/Logout"
            : null;
    IReadOnlyList<StudioDetails> studioTabs = [];
    try
    {
        studioTabs = (await StudioDirectoryService.GetStudiosAsync())
            .Where(studio => studio.IsActive)
            .OrderBy(studio => studio.GroupDisplayOrder ?? int.MaxValue)
            .ThenBy(studio => studio.StudioGroup, StringComparer.OrdinalIgnoreCase)
            .ThenBy(studio => studio.StudioDisplayOrder ?? int.MaxValue)
            .ThenBy(studio => studio.StudioName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(studio => studio.ProjectName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
    catch
    {
        studioTabs = [];
    }
    var fullBleed = ViewData["FullBleed"] is true;
    var pageWidth = ViewData["PageWidth"] as string;
    var pageContainerClass = fullBleed
        ? "container-fluid p-0"
        : pageWidth switch
        {
            CustomTeamPageWidths.Wide => "teamhub-page-wide",
            CustomTeamPageWidths.Full => "teamhub-page-full",
            _ => "container"
        };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @applicationName</title>
    <link rel="icon" type="image/svg+xml" href="~/images/teamhub-logo.svg" asp-append-version="true" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TeamHub.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(fullBleed ? "fd-host-designer-page" : null)">
    <header>
        <nav class="navbar navbar-expand-xxl navbar-light bg-white border-bottom box-shadow teamhub-navbar @(fullBleed ? "mb-0" : "mb-3")">
            <div class="container">
                <a class="navbar-brand teamhub-navbar-brand" asp-page="/Index" aria-label="@applicationName Team Hub home">
                    <img class="teamhub-navbar-logo" src="~/images/teamhub-logo.svg" alt="" aria-hidden="true" asp-append-version="true" />
                    <span class="teamhub-navbar-brand-copy">
                        <strong>@applicationName</strong>
                        <span>Team Hub</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-xxl-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @foreach (var tab in navigationTabs)
                        {
                            if (string.Equals(tab.Page, mainNavigationInsertPage, StringComparison.OrdinalIgnoreCase))
                            {
                                @foreach (var customTab in mainNavigationTabs)
                                {
                                    <li class="nav-item"><a class="nav-link text-dark" asp-page="/Team/Custom" asp-route-slug="@customTab.Slug">@customTab.Name</a></li>
                                }
                            }
                            if (string.Equals(tab.Page, "/Studio/Index", StringComparison.OrdinalIgnoreCase))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="studiosDropdown" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">@tab.Name</a>
                                    <ul class="dropdown-menu studio-groups-menu" aria-labelledby="studiosDropdown">
                                        @if (studioTabs.Count == 0)
                                        {
                                            <li><a class="dropdown-item" asp-page="@tab.Page">No studios configured</a></li>
                                        }
                                        else
                                        {
                                            @foreach (var studioGroup in studioTabs.GroupBy(studio => studio.StudioGroup, StringComparer.OrdinalIgnoreCase))
                                            {
                                                <li class="dropend studio-group-submenu">
                                                    <button type="button" class="dropdown-item dropdown-toggle d-flex align-items-center justify-content-between gap-3">
                                                        <span>@studioGroup.Key</span>
                                                    </button>
                                                    <ul class="dropdown-menu">
                                                        @foreach (var studio in studioGroup
                                                            .OrderBy(item => item.StudioDisplayOrder ?? int.MaxValue)
                                                            .ThenBy(item => item.StudioName, StringComparer.OrdinalIgnoreCase)
                                                            .ThenBy(item => item.ProjectName, StringComparer.OrdinalIgnoreCase))
                                                        {
                                                            <li>
                                                                <a class="dropdown-item" asp-page="@tab.Page" asp-route-studioId="@studio.Id">@studio.StudioName</a>
                                                            </li>
                                                        }
                                                    </ul>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-page="@tab.Page">@tab.Name</a></li>
                            }
                        }
                        @if (mainNavigationInsertPage is null)
                        {
                            @foreach (var customTab in mainNavigationTabs)
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-page="/Team/Custom" asp-route-slug="@customTab.Slug">@customTab.Name</a></li>
                            }
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (await CurrentAccess.CanAsync(TeamHubModules.AtlassianConnection))
                        {
                            <a class="btn btn-sm btn-outline-secondary me-2" asp-page="/Profile/Atlassian">My Atlassian Connection</a>
                        }
                        <span class="navbar-text small text-secondary me-2">@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity.Name)</span>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Login">Sign in</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="@pageContainerClass teamhub-page-frame">
        <main role="main" class="pb-3">
            @if (isReadOnlyPage && User.Identity?.IsAuthenticated == true)
            {
                <div class="alert alert-light border small" role="status">You have read-only access to this module.</div>
            }
            @RenderBody()
        </main>
    </div>

    @if (!fullBleed)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - HP-GDS Team Hub System POC
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (() => {
            const granted = @((int)currentPageAccess);
            const requiredFor = (url, method) => {
                const target = new URL(url, window.location.href);
                const handler = target.searchParams.get("handler") || "";
                if (method === "DELETE" || /delete/i.test(handler)) return 4;
                if (/\/publish/i.test(target.pathname) || (/\/templates/i.test(target.pathname) && method !== "GET") || /publish/i.test(handler)) return 5;
                if (method === "POST" && /(create|duplicate)/i.test(handler)) return 2;
                if (["POST", "PUT", "PATCH"].includes(method)) return 3;
                if (method === "GET" && (/\/new$/i.test(target.pathname) || target.searchParams.has("create"))) return 2;
                return 1;
            };
            const allows = required => granted === 5 || granted >= required;

            document.querySelectorAll('form[method="post"]').forEach(form => {
                if (!allows(3)) form.querySelectorAll('input, select, textarea').forEach(control => control.disabled = true);
                form.querySelectorAll('button, input[type="submit"]').forEach(button => {
                    const target = button.formAction || form.action;
                    button.disabled = !allows(requiredFor(target, "POST"));
                });
            });
            document.querySelectorAll('a[href]').forEach(link => {
                if (allows(requiredFor(link.href, "GET"))) return;
                link.classList.add("disabled");
                link.setAttribute("aria-disabled", "true");
                link.addEventListener("click", event => event.preventDefault());
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
