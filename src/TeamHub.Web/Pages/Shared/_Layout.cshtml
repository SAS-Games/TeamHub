@using Microsoft.Extensions.Options
@using TeamHub.Studio
@using TeamHub.Web.Navigation
@using TeamHub.Web.Options
@inject IOptions<List<NavigationTabOptions>> NavigationTabsOptions
@inject IOptions<ApplicationOptions> ApplicationOptions
@inject IStudioDirectoryService StudioDirectoryService
@{
    var applicationName = ApplicationOptions.Value.Name;
    var navigationTabs = NavigationTabsOptions.Value
        .OrderBy(tab => tab.Order)
        .Where(tab => !tab.AdminOnly || User.IsInRole("Admin"));
    IReadOnlyList<StudioDetails> studioTabs = [];
    try
    {
        studioTabs = await StudioDirectoryService.GetStudiosAsync();
    }
    catch
    {
        studioTabs = [];
    }
    var fullBleed = ViewData["FullBleed"] is true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @applicationName</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TeamHub.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(fullBleed ? "fd-host-designer-page" : null)">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow @(fullBleed ? "mb-0" : "mb-3")">
            <div class="container">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @foreach (var tab in navigationTabs)
                        {
                            if (string.Equals(tab.Page, "/Studio/Index", StringComparison.OrdinalIgnoreCase))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="studiosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">@tab.Name</a>
                                    <ul class="dropdown-menu" aria-labelledby="studiosDropdown">
                                        @if (studioTabs.Count == 0)
                                        {
                                            <li><a class="dropdown-item" asp-page="@tab.Page">No studios configured</a></li>
                                        }
                                        else
                                        {
                                            @foreach (var studio in studioTabs)
                                            {
                                                <li><a class="dropdown-item" asp-page="@tab.Page" asp-route-studioId="@studio.Id">@studio.StudioName</a></li>
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-page="@tab.Page">@tab.Name</a></li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="@(fullBleed ? "container-fluid p-0" : "container")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (!fullBleed)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - Workflow System POC
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
