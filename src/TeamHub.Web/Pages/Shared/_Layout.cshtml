@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Mvc.RazorPages
@using TeamHub.Studio
@using TeamHub.Team
@using TeamHub.Authentication
@using TeamHub.Web.AccessControl
@using TeamHub.Web.Navigation
@using TeamHub.Web.Options
@using TeamHub.AI.Contracts
@inject IOptions<List<NavigationTabOptions>> NavigationTabsOptions
@inject IOptions<ApplicationOptions> ApplicationOptions
@inject IStudioDirectoryService StudioDirectoryService
@inject ICustomTeamTabService CustomTabs
@inject ICurrentAccessService CurrentAccess
@inject IPageLayoutService PageLayouts
@inject IAiConfigurationService AiConfiguration
@{
    var applicationName = ApplicationOptions.Value.Name;
    var currentModule = Context.Items["TeamHub.Module"] as string
        ?? TeamHubAccessRoutes.ResolveModule(Context.Request.Path);
    var currentPageAccess = currentModule is null ? AccessLevel.FullAccess : await CurrentAccess.GetAccessLevelAsync(currentModule);
    var navigationTabs = new List<NavigationTabOptions>();
    var aiChatEnabled = false;
    var canUseAiChat = false;
    try
    {
        aiChatEnabled = (await AiConfiguration.GetAsync(Context.RequestAborted)).Chat.Enabled;
    }
    catch
    {
        aiChatEnabled = false;
    }
    if (aiChatEnabled && User.Identity?.IsAuthenticated == true)
    {
        canUseAiChat = await CurrentAccess.CanAsync(TeamHubModules.AiChat);
    }
    var showAiChatWidget = canUseAiChat && !Context.Request.Path.StartsWithSegments("/AIChat");
    foreach (var tab in NavigationTabsOptions.Value.OrderBy(tab => tab.Order))
    {
        if (string.Equals(tab.Page, "/AIChat", StringComparison.OrdinalIgnoreCase) && !aiChatEnabled)
        {
            continue;
        }
        if (string.Equals(tab.Page, "/Logout", StringComparison.OrdinalIgnoreCase))
        {
            if (User.Identity?.IsAuthenticated == true) navigationTabs.Add(tab);
            continue;
        }
        var module = TeamHubAccessRoutes.ResolveNavigationModule(tab.Page);
        if ((!tab.AdminOnly || User.IsInRole(TeamHubUserTypes.Admin))
            && (module is null || await CurrentAccess.CanAsync(module)))
        {
            navigationTabs.Add(tab);
        }
    }
    var mainNavigationTabs = new List<CustomTeamTabDto>();
    try
    {
        foreach (var tab in (await CustomTabs.ListTabsAsync(Context.RequestAborted))
            .Where(tab => tab.NavigationPlacement == CustomTeamTabPlacements.MainNavigation)
            .OrderBy(tab => tab.DisplayOrder)
            .ThenBy(tab => tab.Name))
        {
            if (await CurrentAccess.CanAsync(CustomTeamTabAccess.ModuleForSlug(tab.Slug), AccessLevel.ReadOnly, Context.RequestAborted))
            {
                mainNavigationTabs.Add(tab);
            }
        }
    }
    catch
    {
        mainNavigationTabs = [];
    }
    var mainNavigationInsertPage = navigationTabs.Any(tab => string.Equals(tab.Page, "/Configuration/Index", StringComparison.OrdinalIgnoreCase))
        ? "/Configuration/Index"
        : navigationTabs.Any(tab => string.Equals(tab.Page, "/Logout", StringComparison.OrdinalIgnoreCase))
            ? "/Logout"
            : null;
    IReadOnlyList<StudioDetails> studioTabs = [];
    try
    {
        studioTabs = (await StudioDirectoryService.GetStudiosAsync())
            .Where(studio => studio.IsActive)
            .OrderBy(studio => studio.GroupDisplayOrder ?? int.MaxValue)
            .ThenBy(studio => studio.StudioGroup, StringComparer.OrdinalIgnoreCase)
            .ThenBy(studio => studio.StudioDisplayOrder ?? int.MaxValue)
            .ThenBy(studio => studio.StudioName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(studio => studio.ProjectName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
    catch
    {
        studioTabs = [];
    }
    var selectedStudioId = Context.Request.Path.StartsWithSegments("/Studio")
        ? Context.Request.Query["studioId"].FirstOrDefault()
        : null;
    var selectedStudioLogo = studioTabs.FirstOrDefault(studio =>
        string.Equals(studio.Id, selectedStudioId, StringComparison.OrdinalIgnoreCase))?.LogoFileName;
    var navbarLogoUrl = string.IsNullOrWhiteSpace(selectedStudioLogo)
        ? Url.Content("~/images/teamhub-logo.svg")
        : Url.Content($"~/studio-logos/{selectedStudioLogo}");
    var fullBleed = ViewData["FullBleed"] is true;
    var defaultPageWidth = ViewData["PageWidth"] as string;
    var pageKey = (ViewContext.ActionDescriptor as PageActionDescriptor)?.ViewEnginePath;
    string? configuredPageWidth = null;
    if (!string.IsNullOrWhiteSpace(pageKey))
    {
        try
        {
            configuredPageWidth = await PageLayouts.GetPageWidthAsync(pageKey, Context.RequestAborted);
        }
        catch
        {
            configuredPageWidth = null;
        }
    }
    var pageWidth = configuredPageWidth ?? defaultPageWidth;
    var pageContainerClass = fullBleed
        ? "container-fluid p-0"
        : pageWidth switch
        {
            CustomTeamPageWidths.Wide => "teamhub-page-wide",
            CustomTeamPageWidths.Full => "teamhub-page-full",
            _ => "container"
        };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @applicationName</title>
    <script>
        (() => {
            let preference;
            try {
                preference = localStorage.getItem("teamhub-theme");
            } catch { }
            document.documentElement.dataset.bsTheme = preference === "light" || preference === "dark"
                ? preference
                : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        })();
    </script>
    <link rel="icon" type="image/svg+xml" href="~/images/teamhub-logo.svg" asp-append-version="true" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/TeamHub.Notifications/notifications.css" asp-append-version="true" />
    @if (showAiChatWidget)
    {
        <link rel="stylesheet" href="~/css/ai-chat-widget.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/TeamHub.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(fullBleed ? "fd-host-designer-page" : null)">
    <header>
        <nav class="navbar navbar-expand-xxl border-bottom box-shadow teamhub-navbar @(fullBleed ? "mb-0" : "mb-3")">
            <div class="container">
                <a class="navbar-brand teamhub-navbar-brand" asp-page="/Index" aria-label="@applicationName Team Hub home">
                    <img class="teamhub-navbar-logo" src="@navbarLogoUrl" alt="" aria-hidden="true" />
                    <span class="teamhub-navbar-brand-copy">
                        <strong>@applicationName</strong>
                        <span>Team Hub</span>
                    </span>
                </a>
                <button class="btn btn-outline-secondary teamhub-theme-toggle ms-auto me-2 order-xxl-last" type="button" id="theme-toggle"
                        aria-label="Dark mode" aria-pressed="false" title="Switch to dark mode">
                    <span class="theme-icon-dark" aria-hidden="true">&#9789;</span>
                    <span class="theme-icon-light" aria-hidden="true">&#9728;</span>
                </button>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-xxl-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @foreach (var tab in navigationTabs)
                        {
                            if (string.Equals(tab.Page, mainNavigationInsertPage, StringComparison.OrdinalIgnoreCase))
                            {
                                @foreach (var customTab in mainNavigationTabs)
                                {
                                    <li class="nav-item"><a class="nav-link" asp-page="/Team/Custom" asp-route-slug="@customTab.Slug">@customTab.Name</a></li>
                                }
                            }
                            if (string.Equals(tab.Page, "/Studio/Index", StringComparison.OrdinalIgnoreCase))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="studiosDropdown" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">@tab.Name</a>
                                    <ul class="dropdown-menu studio-groups-menu" aria-labelledby="studiosDropdown">
                                        @if (studioTabs.Count == 0)
                                        {
                                            <li><a class="dropdown-item" asp-page="@tab.Page">No studios configured</a></li>
                                        }
                                        else
                                        {
                                            @foreach (var studioGroup in studioTabs.GroupBy(studio => studio.StudioGroup, StringComparer.OrdinalIgnoreCase))
                                            {
                                                <li class="dropend studio-group-submenu">
                                                    <button type="button" class="dropdown-item dropdown-toggle d-flex align-items-center justify-content-between gap-3">
                                                        <span>@studioGroup.Key</span>
                                                    </button>
                                                    <ul class="dropdown-menu">
                                                        @foreach (var studio in studioGroup
                                                            .OrderBy(item => item.StudioDisplayOrder ?? int.MaxValue)
                                                            .ThenBy(item => item.StudioName, StringComparer.OrdinalIgnoreCase)
                                                            .ThenBy(item => item.ProjectName, StringComparer.OrdinalIgnoreCase))
                                                        {
                                                            <li>
                                                                <a class="dropdown-item" asp-page="@tab.Page" asp-route-studioId="@studio.Id">@studio.StudioName</a>
                                                            </li>
                                                        }
                                                    </ul>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="@tab.Page">@tab.Name</a></li>
                            }
                        }
                        @if (mainNavigationInsertPage is null)
                        {
                            @foreach (var customTab in mainNavigationTabs)
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Team/Custom" asp-route-slug="@customTab.Slug">@customTab.Name</a></li>
                            }
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (showAiChatWidget)
                        {
                            <button id="aiChatLauncher" class="btn btn-sm teamhub-ai-chat-launcher"
                                    type="button" aria-controls="aiChatPanel" aria-expanded="false"
                                    aria-label="Open TeamHub Assistant" title="TeamHub Assistant">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M4 3.5h16A2.5 2.5 0 0 1 22.5 6v10A2.5 2.5 0 0 1 20 18.5H9l-5.8 3.2.9-3.2H4A2.5 2.5 0 0 1 1.5 16V6A2.5 2.5 0 0 1 4 3.5Zm4.1 6.25a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5Zm3.9 0a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5Zm3.9 0a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5Z" />
                                </svg>
                            </button>
                        }
                        @if (await CurrentAccess.CanAsync(TeamHubModules.Notifications))
                        {
                            @await Component.InvokeAsync("NotificationBell")
                        }
                        @if (await CurrentAccess.CanAsync(TeamHubModules.AtlassianConnection))
                        {
                            <a class="btn btn-sm btn-outline-secondary me-2" asp-page="/Profile/Atlassian">My Connections</a>
                        }
                        <span class="navbar-text small text-secondary me-2">@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity.Name)</span>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Login">Sign in</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="@pageContainerClass teamhub-page-frame">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (!fullBleed)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - HP-GDS Team Hub System POC
            </div>
        </footer>
    }

    <div class="teamhub-page-loader" data-support-summary-loader hidden role="status" aria-live="polite" aria-label="Loading Support Summary">
        <div class="teamhub-page-loader-card">
            <div class="spinner-border text-primary" aria-hidden="true"></div>
            <div>
                <strong>Preparing Support Summary</strong>
                <span>Loading milestones, support tickets, and Confluence updates. Logged effort will continue loading inside the report.</span>
            </div>
        </div>
    </div>

    @if (showAiChatWidget)
    {
        <aside id="aiChatPanel" class="teamhub-ai-chat-panel" data-ai-chat data-ai-chat-widget
               data-ai-chat-user="@User.Identity?.Name" hidden
               aria-label="TeamHub Assistant" aria-hidden="true">
            <header class="teamhub-ai-chat-header">
                <div>
                    <strong>TeamHub Assistant</strong>
                    <span id="aiChatProvider">Loading provider…</span>
                </div>
                <div class="teamhub-ai-chat-window-actions">
                    <button id="aiChatMaximize" type="button" aria-label="Maximize TeamHub Assistant" title="Maximize">
                        <svg class="maximize-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v2H6v4H4V4Zm10 0h6v6h-2V6h-4V4ZM4 14h2v4h4v2H4v-6Zm14 0h2v6h-6v-2h4v-4Z" /></svg>
                        <svg class="restore-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h13v13h-3v5H3V8h5V3Zm2 5h8v6h1V5h-9v3Zm6 3H5v8h11v-8Z" /></svg>
                    </button>
                    <button id="aiChatClose" type="button" aria-label="Close TeamHub Assistant" title="Close">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6.4 5 5.6 5.6L17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19 5 17.6l5.6-5.6L5 6.4 6.4 5Z" /></svg>
                    </button>
                </div>
            </header>
            <div class="teamhub-ai-chat-controls">
                <div>
                    <label for="aiChatMode">Mode</label>
                    <select id="aiChatMode" class="form-select form-select-sm">
                        <option value="General">General</option>
                        <option value="TeamHub">TeamHub</option>
                        <option value="MeetingNotes">Meeting Notes (MOM)</option>
                    </select>
                </div>
                <div>
                    <label for="aiChatModel">Model</label>
                    <select id="aiChatModel" class="form-select form-select-sm" disabled>
                        <option value="">Loading models…</option>
                    </select>
                </div>
            </div>
            <div id="aiChatMeetingStudioContext" class="teamhub-ai-chat-studio-context d-none">
                <label for="aiChatMeetingStudio">Meeting studio</label>
                <select id="aiChatMeetingStudio" class="form-select form-select-sm">
                    <option value="">Default meeting-note format</option>
                </select>
                <span>Optional. Selecting a studio applies its configured Markdown instruction overlay.</span>
            </div>
            <div id="aiChatModeNote" class="teamhub-ai-chat-note"></div>
            <div id="aiChatMessages" class="teamhub-ai-chat-messages" aria-live="polite"></div>
            <form id="aiChatForm" method="post" action="/AIChat?handler=Message" class="teamhub-ai-chat-composer">
                @Html.AntiForgeryToken()
                <div id="aiChatDocuments" class="teamhub-ai-chat-documents d-none">
                    <label for="aiChatFiles" id="aiChatFilesLabel">Attach documents</label>
                    <input id="aiChatFiles" type="file" class="form-control form-control-sm" multiple
                           accept=".txt,.md,.markdown,.csv,.json,.docx,.pdf,.chm,.png,.jpg,.jpeg,.webp,.gif,text/plain,text/markdown,text/csv,application/json,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/pdf,application/vnd.ms-htmlhelp,image/png,image/jpeg,image/webp,image/gif" />
                </div>
                <details id="aiChatMeetingOverrideContext" class="teamhub-ai-chat-override d-none">
                    <summary>Additional format override (.md)</summary>
                    <label for="aiChatMeetingOverride" class="visually-hidden">Additional Meeting Notes format override</label>
                    <input id="aiChatMeetingOverride" type="file" class="form-control form-control-sm mt-1"
                           accept=".md,.markdown,text/markdown,text/plain" />
                    <span>Optional. The configured studio format is used automatically.</span>
                </details>
                <div class="teamhub-ai-chat-compose-row">
                    <label for="aiChatPrompt" class="visually-hidden">Message</label>
                    <textarea id="aiChatPrompt" class="form-control" rows="2" maxlength="8000"
                              placeholder="Ask a question…"></textarea>
                    <button id="aiChatSend" type="submit" class="btn btn-primary" disabled>Send</button>
                </div>
                <div id="aiChatUsage" class="ai-chat-session-usage" aria-live="polite">Session tokens: 0</div>
                <div id="aiChatMeetingActions" class="d-none teamhub-ai-chat-meeting-actions">
                    <div class="teamhub-ai-chat-output-actions d-flex flex-wrap gap-1">
                        <button id="aiChatDownloadNotes" type="button" class="btn btn-sm btn-outline-secondary">Download .md</button>
                        <button id="aiChatEditNotes" type="button" class="btn btn-sm btn-outline-primary">Review &amp; post</button>
                    </div>
                    <div id="aiChatMeetingEditor" class="teamhub-ai-chat-meeting-editor d-none mt-2">
                        <div class="teamhub-ai-chat-meeting-review-header">
                            <label for="aiChatMeetingDraft" class="small fw-semibold mb-0">Review meeting notes</label>
                            <button id="aiChatCloseMeetingEditor" type="button" class="btn btn-sm btn-outline-secondary">Close review</button>
                        </div>
                        <div class="teamhub-ai-chat-meeting-editor-toolbar d-flex flex-wrap gap-1 mt-1">
                            <select id="aiChatMeetingDestination" class="form-select form-select-sm flex-grow-1" aria-label="Studio"></select>
                            <button id="aiChatPublishNotes" type="button" class="btn btn-sm btn-primary">Post</button>
                        </div>
                        <div id="aiChatMeetingStatus" class="small" aria-live="polite"></div>
                        <textarea id="aiChatMeetingDraft" class="form-control font-monospace mt-1" rows="6"></textarea>
                    </div>
                </div>
                <div id="aiChatError" class="text-danger small" role="alert"></div>
            </form>
            <span class="teamhub-ai-chat-resize-handle resize-n" data-ai-chat-resize="n" aria-hidden="true"></span>
            <span class="teamhub-ai-chat-resize-handle resize-e" data-ai-chat-resize="e" aria-hidden="true"></span>
            <span class="teamhub-ai-chat-resize-handle resize-s" data-ai-chat-resize="s" aria-hidden="true"></span>
            <span class="teamhub-ai-chat-resize-handle resize-w" data-ai-chat-resize="w" aria-hidden="true"></span>
            <span class="teamhub-ai-chat-resize-handle resize-ne" data-ai-chat-resize="ne" aria-hidden="true"></span>
            <span class="teamhub-ai-chat-resize-handle resize-se" data-ai-chat-resize="se" aria-hidden="true"></span>
            <span class="teamhub-ai-chat-resize-handle resize-sw" data-ai-chat-resize="sw" aria-hidden="true"></span>
            <span class="teamhub-ai-chat-resize-handle resize-nw" data-ai-chat-resize="nw" aria-hidden="true"></span>
        </aside>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/_content/TeamHub.Notifications/notifications.js" asp-append-version="true"></script>
    <script>
        (() => {
            const granted = @((int)currentPageAccess);
            const requiredFor = (url, method) => {
                const target = new URL(url, window.location.href);
                const handler = target.searchParams.get("handler") || "";
                const path = target.pathname;
                if (/^\/AIChat\/?$/i.test(path)) return 1;
                if (/^\/Notifications(?:\/|$)/i.test(path)) return 1;
                if (/^\/Team\/Configuration(?:\/|$)/i.test(path)) return 5;
                if (/^\/WorkCenter\/Configuration(?:\/|$)/i.test(path)) {
                    if (method === "GET" && target.searchParams.has("create")) return 2;
                    if (method === "GET" && target.searchParams.has("draftId")) return 3;
                    if (/publish/i.test(handler)) return 5;
                    if (/delete/i.test(handler)) return 4;
                    if (/(create|duplicate)/i.test(handler)) return 2;
                    return method === "POST" ? 3 : 1;
                }
                if (/^\/WorkCenter\/StartNew(?:\/|$)/i.test(path)) return 2;
                if (/^\/SupportSummary\/?$/i.test(path) && /generateweeklyworksummary/i.test(handler)) return 1;
                if (/^\/Flows\/?$/i.test(path) && /^delete$/i.test(handler)) return 3;
                if (/^\/Flows\/?$/i.test(path) && /deletepublished/i.test(handler)) return 5;
                if (method === "DELETE" || /delete/i.test(handler)) return 4;
                if (/\/publish/i.test(target.pathname) || (/\/templates/i.test(target.pathname) && method !== "GET") || /publish/i.test(handler)) return 5;
                if (method === "POST" && /(create|duplicate)/i.test(handler)) return 2;
                if (method === "POST" && (/\/new$/i.test(path) || /\/createwithai$/i.test(path))) return 2;
                if (["POST", "PUT", "PATCH"].includes(method)) return 3;
                if (method === "GET" && (/\/new$/i.test(target.pathname) || target.searchParams.has("create"))) return 2;
                return 1;
            };
            const allows = required => granted === 5 || granted >= required;

            document.querySelectorAll('form[method="post"]').forEach(form => {
                const formRequired = requiredFor(form.action, "POST");
                if (!allows(formRequired)) form.querySelectorAll('input, select, textarea').forEach(control => control.disabled = true);
                form.querySelectorAll('button, input[type="submit"]').forEach(button => {
                    const target = button.formAction || form.action;
                    button.disabled = !allows(requiredFor(target, "POST"));
                });
            });
            document.querySelectorAll('a[href]').forEach(link => {
                if (allows(requiredFor(link.href, "GET"))) return;
                link.classList.add("disabled");
                link.setAttribute("aria-disabled", "true");
                link.addEventListener("click", event => event.preventDefault());
            });
        })();
    </script>

    @if (showAiChatWidget)
    {
        <script src="~/js/ai-chat.js" asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
