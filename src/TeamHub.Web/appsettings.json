{
  "ConnectionStrings": {
    "WorkflowDb": "Data Source=data/workflow.db",
    "TeamDb": "Data Source=data/team.db",
    "StudioDb": "Data Source=data/studio.db",
    "FlowLibraryDb": "Data Source=data/flow-library.db"
  },
  "Application": {
    "Name": "HP-GDS"
  },
  "WorkflowConfiguration": {
    "ExcelPath": "config/Workflows.xlsx",
    "ReminderCheckIntervalMinutes": 5
  },
  "MilestoneConfiguration": {
    "ExcelPath": "config/MilestoneTracker.xlsx"
  },
  "HomeConfiguration": {
    "ProjectInfoPath": "config/Home/project-info.json",
    "UsefulLinksPath": "config/Home/useful-links.json"
  },
  "NavigationTabs": [
    {
      "Name": "Home",
      "Page": "/Index",
      "Order": 1,
      "AdminOnly": false
    },
    {
      "Name": "Work Center",
      "Page": "/WorkCenter/Overview",
      "Order": 2,
      "AdminOnly": false
    },
    {
      "Name": "Team",
      "Page": "/Team/Directory",
      "Order": 3,
      "AdminOnly": false
    },
    {
      "Name": "Milestone Tracker",
      "Page": "/Milestones",
      "Order": 4,
      "AdminOnly": false
    },
    {
      "Name": "Studios",
      "Page": "/Studio/Index",
      "Order": 5,
      "AdminOnly": false
    },
    {
      "Name": "Flow Designer",
      "Page": "/Flows/Index",
      "Order": 6,
      "AdminOnly": false
    },
    {
      "Name": "Configuration",
      "Page": "/Configuration/Index",
      "Order": 7,
      "AdminOnly": true
    },
    {
      "Name": "Logout",
      "Page": "/Logout",
      "Order": 8,
      "AdminOnly": false
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
