{
  "ConnectionStrings": {
    "WorkflowDb": "Data Source=data/workflow.db",
    "TeamDb": "Data Source=data/team.db",
    "StudioDb": "Data Source=data/studio.db",
    "FlowLibraryDb": "Data Source=data/flow-library.db",
    "AiReportsDb": "Data Source=data/ai-reports.db",
    "MilestoneReviewDb": "Data Source=data/milestone-review.db"
  },
  "Application": {
    "Name": "HP-GDS"
  },
  "ExternalProcesses": {
    "Processes": {
      "WorklogAnalytics": {
        "Enabled": true,
        "RootPath": "E:\\WorklogAnalytics",
        "ExecutablePath": "E:\\WorklogAnalytics\\.venv\\Scripts\\python.exe",
        "EntryPointPath": "ExternalProcesses\\WorklogAnalytics\\teamhub_effort_report.py",
        "EntryPointBase": "ContentRoot",
        "Arguments": [ "--root", "{RootPath}" ],
        "TimeoutSeconds": 120,
        "MaximumOutputCharacters": 5000000,
        "Credential": {
          "Mode": "RequestingUser",
          "EnvironmentVariable": "TEAMHUB_JIRA_PAT",
          "AllowDefaultFallbackForPrivileged": true
        }
      },
      "MilestoneReviewReport": {
        "Enabled": false,
        "RootPath": "",
        "ExecutablePath": "",
        "EntryPointPath": "",
        "EntryPointBase": "RootPath",
        "TimeoutSeconds": 300,
        "MaximumOutputCharacters": 5000000,
        "Credential": {
          "Mode": "None",
          "ConfiguredUserId": "",
          "EnvironmentVariable": "TEAMHUB_JIRA_PAT",
          "AllowDefaultFallbackForPrivileged": false
        }
      }
    }
  },
  "WorkflowConfiguration": {
    "ReminderCheckIntervalMinutes": 5
  },
  "HomeConfiguration": {
    "ProjectInfoPath": "config/Home/project-info.json",
    "UsefulLinksPath": "config/Home/useful-links.json"
  },
  "NavigationTabs": [
    {
      "Name": "Home",
      "Page": "/Index",
      "Order": 1,
      "AdminOnly": false
    },
    {
      "Name": "Work Center",
      "Page": "/WorkCenter/Overview",
      "Order": 2,
      "AdminOnly": false
    },
    {
      "Name": "Team",
      "Page": "/Team/Directory",
      "Order": 3,
      "AdminOnly": false
    },
    {
      "Name": "Milestone Tracker",
      "Page": "/Milestones",
      "Order": 4,
      "AdminOnly": false
    },
    {
      "Name": "Studios",
      "Page": "/Studio/Index",
      "Order": 5,
      "AdminOnly": false
    },
    {
      "Name": "Support Summary",
      "Page": "/SupportSummary",
      "Order": 6,
      "AdminOnly": false
    },
    {
      "Name": "Milestone Review",
      "Page": "/MilestoneReview",
      "Order": 7,
      "AdminOnly": false
    },
    {
      "Name": "Flow Designer",
      "Page": "/Flows/Index",
      "Order": 8,
      "AdminOnly": false
    },
    {
      "Name": "Configuration",
      "Page": "/Configuration/Index",
      "Order": 9,
      "AdminOnly": true
    },
    {
      "Name": "Logout",
      "Page": "/Logout",
      "Order": 10,
      "AdminOnly": false
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
